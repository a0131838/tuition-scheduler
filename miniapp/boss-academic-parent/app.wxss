page {
  min-height: 100%;
  background: #f5f6f7;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 52rpx;
}

.top {
  padding: 28rpx 0 24rpx;
}

.brand-logo {
  display: block;
  width: 100%;
  height: auto;
  margin-bottom: 30rpx;
}

.eyebrow {
  color: #ec5e0a;
  font-size: 23rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  color: #202124;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0;
}

.subtitle {
  margin-top: 10rpx;
  color: #61656d;
  font-size: 26rpx;
  line-height: 1.55;
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3e5e8;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #6b6f76;
  font-size: 24rpx;
}

.value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 750;
  word-break: break-word;
}

.muted {
  color: #7b7f86;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 6rpx;
  background: #ec5e0a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.btn.small {
  width: auto;
  flex: 0 0 auto;
}

.btn.secondary {
  background: #f0f1f3;
  color: #202124;
}

.btn.warn {
  background: #9d3b30;
}

.btn.staff {
  background: #202124;
  color: #ffffff;
}

.btn + .btn {
  margin-top: 16rpx;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.52;
}

.btn:active,
.search-submit:active {
  opacity: 0.84;
  transform: scale(0.99);
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  min-height: 86rpx;
  padding: 20rpx;
  border: 1rpx solid #d9dce0;
  border-radius: 6rpx;
  background: #ffffff;
  color: #202124;
  font-size: 28rpx;
}

.textarea {
  min-height: 220rpx;
  line-height: 1.5;
}

.field {
  margin-top: 22rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff0e7;
  color: #9b3e08;
  font-size: 22rpx;
  font-weight: 700;
}

.list-gap {
  height: 14rpx;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
  color: #7b7f86;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 6rpx;
  background: #f0f1f3;
  border: 0;
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: 10rpx;
  align-items: stretch;
}

.search-input-wrap {
  position: relative;
  min-width: 0;
}

.search-input {
  width: 100%;
  min-height: 78rpx;
  box-sizing: border-box;
  padding: 0 72rpx 0 22rpx;
  border: 1rpx solid #d9dce0;
  border-radius: 6rpx;
  background: #ffffff;
  color: #202124;
  font-size: 27rpx;
}

.search-clear {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777b82;
  font-size: 36rpx;
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: #ec5e0a;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.search-status {
  min-height: 34rpx;
  margin-top: 8rpx;
  color: #777b82;
  font-size: 22rpx;
}
