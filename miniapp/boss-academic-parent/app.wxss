page {
  min-height: 100%;
  background: #f6f4f1;
  color: #202328;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 56rpx;
}

.page-enter {
  animation: pageEnter 220ms ease-out both;
}

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.top {
  padding: 28rpx 0 24rpx;
}

.brand-logo {
  display: block;
  width: 100%;
  height: auto;
  margin-bottom: 30rpx;
}

.eyebrow {
  color: #ec5e0a;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #17191d;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 0;
}

.subtitle {
  margin-top: 10rpx;
  color: #656b73;
  font-size: 26rpx;
  line-height: 1.55;
}

.card {
  margin-top: 18rpx;
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e4e1dc;
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(35, 39, 44, 0.045);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #6b6f76;
  font-size: 24rpx;
}

.value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 750;
  word-break: break-word;
}

.muted {
  color: #7b7f86;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  background: #ec5e0a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.btn.small {
  width: auto;
  flex: 0 0 auto;
}

.btn.secondary {
  background: #eae8e4;
  color: #202124;
}

.btn.warn {
  background: #9d3b30;
}

.btn.staff {
  background: #202124;
  color: #ffffff;
}

.btn + .btn {
  margin-top: 16rpx;
}

.portal-foot-link {
  width: auto;
  min-height: 64rpx;
  margin: 18rpx auto 0;
  padding: 0 12rpx;
  background: transparent;
  color: #61656d;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 64rpx;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.52;
}

.btn:active,
.search-submit:active {
  opacity: 0.84;
  transform: scale(0.99);
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  min-height: 86rpx;
  padding: 20rpx;
  border: 1rpx solid #d8d5d0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #202124;
  font-size: 28rpx;
}

.textarea {
  min-height: 220rpx;
  line-height: 1.5;
}

.field {
  margin-top: 22rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff0e7;
  color: #9b3e08;
  font-size: 22rpx;
  font-weight: 700;
}

.list-gap {
  height: 14rpx;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
  color: #7b7f86;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #eceae6;
  border: 0;
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: 10rpx;
  align-items: stretch;
}

.search-input-wrap {
  position: relative;
  min-width: 0;
}

.search-input {
  width: 100%;
  min-height: 78rpx;
  box-sizing: border-box;
  padding: 0 72rpx 0 22rpx;
  border: 1rpx solid #d8d5d0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #202124;
  font-size: 27rpx;
}

.search-clear {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777b82;
  font-size: 36rpx;
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #ec5e0a;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.search-status {
  min-height: 34rpx;
  margin-top: 8rpx;
  color: #777b82;
  font-size: 22rpx;
}
