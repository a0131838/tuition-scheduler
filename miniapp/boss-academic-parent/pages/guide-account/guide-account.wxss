@import "../../styles/school-guide.wxss";
.account-hero{animation:accountEnter 340ms ease-out both}.account-section{margin-top:34rpx;border-top:4rpx solid #18202a}.account-label{padding:24rpx 0 10rpx;color:#a83c05;font-size:24rpx;font-weight:850;letter-spacing:1rpx}.account-row,.staff-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #d7d9da;transition:background 120ms ease,transform 120ms ease}.account-row b,.staff-entry b{display:block;color:#18202a;font-size:30rpx;font-weight:850}.account-row text,.staff-entry text{display:block;margin-top:7rpx;color:#68727b;font-size:25rpx;line-height:1.5}.account-row i,.staff-entry i{color:#a83c05;font-size:36rpx;font-style:normal}.service-entry{margin-top:48rpx;padding:0 0 38rpx;border-top:7rpx solid #ec5e0a;border-bottom:1rpx solid #d7d9da}.service-title{margin-top:8rpx;color:#18202a;font-size:38rpx;font-weight:880;line-height:1.3}.service-note{margin:12rpx 0 26rpx;color:#66717b;font-size:25rpx;line-height:1.55}.staff-entry{margin-top:20rpx}.privacy-link{padding:28rpx 0;color:#777f86;font-size:23rpx;text-align:center;text-decoration:underline}.guide-press{background:#fff7f0;transform:translateY(2rpx)}@keyframes accountEnter{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
