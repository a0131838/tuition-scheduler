.next-lesson{padding:27rpx 0;border-top:6rpx solid #287a62;border-bottom:1rpx solid #dedbd6}.next-label{color:#747b77;font-size:21rpx;font-weight:700}.next-date{margin-top:8rpx;font-size:33rpx;font-weight:850}.next-course{margin-top:9rpx;font-size:27rpx;font-weight:760}.next-meta{margin-top:7rpx;color:#68706c;font-size:23rpx}.schedule-tabs{display:grid;grid-template-columns:1fr 1fr;margin-top:30rpx;border-bottom:1rpx solid #d9d7d2}.schedule-tab{padding:18rpx;text-align:center;color:#777d79;font-size:24rpx;font-weight:700;border-bottom:5rpx solid transparent}.schedule-tab.active{color:#202622;border-bottom-color:#ec5e0a}.reminder-line{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #dedbd6}.reminder-title{font-size:24rpx;font-weight:780}.reminder-note{margin-top:5rpx;color:#7b817d;font-size:20rpx;line-height:1.4}.reminder-button{width:112rpx;min-height:62rpx;margin:0;border-radius:999rpx;background:#ece9e4;color:#9b3e08;font-size:21rpx;font-weight:750;line-height:62rpx}.date-group{margin-top:30rpx}.date-label{color:#575e5a;font-size:24rpx;font-weight:820}.session-row{display:grid;grid-template-columns:126rpx minmax(0,1fr) auto;gap:17rpx;align-items:start;padding:22rpx 0;border-bottom:1rpx solid #dedbd6}.session-time{font-size:24rpx;font-weight:800}.session-title{font-size:25rpx;font-weight:790;line-height:1.4}.session-meta{margin-top:6rpx;color:#747b77;font-size:21rpx;line-height:1.45}.status{padding:6rpx 10rpx;border-radius:999rpx;background:#eeeae5;color:#5b615e;font-size:19rpx;font-weight:750}.status-upcoming,.status-active{background:#edf7f2;color:#24634f}.status-muted{background:#f0efec;color:#80847f}.status-done{background:#f4f2ee;color:#5e6561}
