<view class="page">
  <view class="top">
    <view class="eyebrow">学生绑定</view>
    <view class="title">输入邀请码</view>
    <view class="subtitle">邀请码由学校工作人员生成。绑定后可查看孩子的学习和服务信息。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">邀请码</view>
      <input class="input" value="{{token}}" placeholder="请输入或粘贴邀请码" bindinput="onTokenInput" />
    </view>
    <view class="field">
      <view class="label">关系</view>
      <picker mode="selector" range="{{relationships}}" value="{{relationshipIndex}}" bindchange="onRelationshipChange">
        <view class="picker">{{relationships[relationshipIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">家长姓名</view>
      <input class="input" value="{{parentName}}" placeholder="可选填写" bindinput="onNameInput" />
    </view>
    <view class="field">
      <view class="label">联系电话</view>
      <input class="input" value="{{phone}}" placeholder="可选填写" type="number" bindinput="onPhoneInput" />
    </view>
    <button class="btn" loading="{{loading}}" bindtap="bindInvite">确认绑定</button>
  </view>
</view>
