<view class="page ops-page page-enter">
  <view class="privacy-watermark" wx:if="{{workspace && workspace.privacyNotice}}">{{workspace.privacyNotice}}</view>
  <view class="ops-hero"><view class="ops-kicker">一个学生·一个页面</view><view class="ops-title">学生360°工作台</view><view class="ops-subtitle">查看课程、课包、工单、家长联系和历史反馈。老师只能查看自己教过的学生。</view></view>
  <view class="search-row"><input value="{{query}}" bindinput="inputQuery" bindconfirm="search" placeholder="搜索学生姓名 / 学校" /><button loading="{{searching}}" bindtap="search">搜索</button></view>
  <view wx:if="{{noWorkspace}}"><view class="student-result" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="selectStudent"><view class="student-name">{{item.name}}</view><view class="ops-card-meta">{{item.gradeDisplay}} · {{item.schoolDisplay}}</view></view><view class="empty-state" wx:if="{{showSearchEmpty}}">没有找到可查看的学生。</view></view>
  <block wx:if="{{workspace}}">
    <view class="ops-section"><view class="workspace-headline"><view><view class="ops-section-title">{{workspace.student.name}}</view><view class="ops-card-meta">{{workspace.student.gradeDisplay}} · {{workspace.student.schoolDisplay}}</view></view><view class="back-link" bindtap="clearWorkspace">换学生</view></view><view class="risk-row" wx:if="{{workspace.hasRisks}}"><text class="risk-chip" wx:for="{{workspace.riskFlags}}" wx:key="*this">{{item}}</text></view><view class="ops-actions"><button class="ops-primary" wx:if="{{workspace.capabilities.canCreateRequest}}" bindtap="createRequest">录入工单</button><button class="ops-secondary" wx:if="{{workspace.capabilities.canCreateRequest}}" bindtap="openSchedule">排课/调课</button></view></view>
    <view class="ops-section" wx:if="{{workspace.hasParents}}"><view class="ops-section-title">家长联系</view><view class="ops-card" wx:for="{{workspace.parents}}" wx:key="phone"><view class="ops-card-title">{{item.name}} {{item.primaryText}}</view><view class="inline-pair"><text>电话</text><text>{{item.phoneDisplay}}</text></view><view class="inline-pair"><text>微信群</text><text>{{item.groupNameDisplay}}</text></view><view class="inline-pair"><text>沟通负责人</text><text>{{item.ownerDisplay}}</text></view></view></view>
    <view class="ops-section"><view class="ops-section-title">课包与余额</view><view class="ops-card {{item.cardClass}}" wx:for="{{workspace.packages}}" wx:key="id"><view class="ops-card-head"><view><view class="ops-card-title">{{item.courseName}}</view><view class="ops-card-meta">{{item.status}} · 有效期至 {{item.validToDisplay}}</view></view><view class="ops-badge {{item.cardClass}}">{{item.balanceDisplay}}</view></view></view><view class="empty-state" wx:if="{{workspace.noPackages}}">暂无课包记录</view></view>
    <view class="ops-section"><view class="ops-section-title">未来课程</view><view class="timeline-row" wx:for="{{workspace.upcoming}}" wx:key="id" data-id="{{item.id}}" bindtap="openSession"><view class="ops-card-title">{{item.startText}}</view><view class="ops-card-meta">{{item.courseLabel}} · {{item.teacherName}} · {{item.locationText}}</view></view><view class="empty-state" wx:if="{{workspace.noUpcoming}}">暂无未来课程</view></view>
    <view class="ops-section"><view class="ops-section-title">开放工单</view><view class="ops-card {{item.cardClass}}" wx:for="{{workspace.openTickets}}" wx:key="id" data-id="{{item.id}}" bindtap="openTicket"><view class="ops-card-title">{{item.ticketNo}} · {{item.type}}</view><view class="ops-card-meta">{{item.status}} · {{item.ownerDisplay}} · {{item.nextActionDisplay}}</view></view><view class="empty-state" wx:if="{{workspace.noOpenTickets}}">没有开放工单</view></view>
    <view class="ops-section"><view class="ops-section-title">历史课后反馈</view><view class="ops-card" wx:for="{{workspace.feedbacks}}" wx:key="id"><view class="ops-card-title">{{item.lessonDate}} · {{item.courseName}}</view><view class="ops-card-meta">{{item.teacherName}}</view><view class="feedback-content">{{item.content}}</view><view class="feedback-content" wx:if="{{item.homework}}">作业：{{item.homework}}</view></view><view class="empty-state" wx:if="{{workspace.noFeedbacks}}">暂无可查看的反馈</view></view>
  </block>
</view>
