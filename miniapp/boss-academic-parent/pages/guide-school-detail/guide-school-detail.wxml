<view class="guide-page" wx:if="{{school}}">
  <view class="guide-hero school-hero">
    <view class="guide-kicker">国际学校{{school.editorialTier === 1 ? " · 第一梯队" : ""}}</view>
    <view class="guide-title school-name-zh">{{school.nameZh}}</view>
    <view class="school-name-en">{{school.name}}</view>
  </view>

  <view class="school-snapshot">
    <view class="school-snapshot-item" wx:for="{{school.snapshot}}" wx:key="label">
      <view class="school-snapshot-label">{{item.label}}</view>
      <view class="school-snapshot-value">{{item.value}}</view>
    </view>
  </view>

  <view class="school-detail-tabs">
    <view class="school-detail-tab {{activeDetailTab === 'OVERVIEW' ? 'active' : ''}}" data-tab="OVERVIEW" bindtap="setDetailTab">概览</view>
    <view class="school-detail-tab {{activeDetailTab === 'RESULTS' ? 'active' : ''}}" data-tab="RESULTS" bindtap="setDetailTab">成绩升学</view>
    <view class="school-detail-tab {{activeDetailTab === 'APPLICATION' ? 'active' : ''}}" data-tab="APPLICATION" bindtap="setDetailTab">申请费用</view>
  </view>

  <block wx:if="{{activeDetailTab === 'OVERVIEW'}}">
  <view class="guide-section" wx:if="{{school.campusProfiles.length}}">
    <view class="guide-section-title">校区与学段</view>
    <view class="school-campus-list">
      <view class="school-campus-row" wx:for="{{school.campusProfiles}}" wx:key="slug">
        <view class="school-campus-name">{{item.nameZh}}</view>
        <view class="school-campus-name-en">{{item.name}}</view>
        <view class="school-campus-note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view class="guide-section school-overview">
    <view class="school-accordion-head school-overview-head" bindtap="toggleOverview"><text>学校概览</text><text>{{overviewOpen ? "−" : "+"}}</text></view>
    <view class="guide-list school-overview-list" wx:if="{{overviewOpen}}">
      <view class="guide-fact" wx:for="{{school.verifiedFacts}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">在校规模</view>
    <view class="school-metric-grid" wx:if="{{school.communityMetrics.length}}">
      <view class="school-metric" wx:for="{{school.communityMetrics}}" wx:key="label">
        <view class="school-metric-value">{{item.value}}</view>
        <view class="school-metric-label">{{item.label}}</view>
        <view class="school-metric-asof">{{item.asOf}}</view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>暂无公开数据</view>
  </view>

  </block>

  <block wx:if="{{activeDetailTab === 'APPLICATION'}}">
  <view class="guide-section">
    <view class="guide-section-title">申请与课程</view>
    <view class="guide-notice" wx:if="{{school.studentPass}}">
      <view><b>{{school.studentPass.label}}</b></view>
      <view>{{school.studentPass.note}}</view>
      <view>最终签发由ICA决定；缴费前请取得学校书面确认。</view>
    </view>
    <view class="guide-notice" wx:if="{{school.admissionProfile}}">
      <view><b>{{school.admissionProfile.difficultyLabel}}</b> · {{school.admissionProfile.curriculumText}}</view>
      <view wx:if="{{school.admissionProfile.entryPointsText}}">主要节点：{{school.admissionProfile.entryPointsText}}</view>
      <view>{{school.admissionProfile.entryAdvice}}</view>
      <view>“相对容易申请”不代表保证录取。</view>
    </view>
    <view class="school-accordion" wx:if="{{detailSections.length}}">
      <view class="school-accordion-item" wx:for="{{detailSections}}" wx:key="title" wx:for-item="section" wx:for-index="sectionIndex">
        <view class="school-accordion-head" data-index="{{sectionIndex}}" bindtap="toggleSection">
          <text>{{section.title}}</text><text>{{section.open ? "−" : "+"}}</text>
        </view>
        <view class="school-accordion-body" wx:if="{{section.open}}">
          <view class="guide-fact" wx:for="{{section.items}}" wx:key="*this" wx:for-item="fact">{{fact}}</view>
        </view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>暂无详细资料</view>
  </view>

  </block>

  <block wx:if="{{activeDetailTab === 'RESULTS'}}">
  <view class="guide-section">
    <view class="guide-section-title">历年学术成绩</view>
    <view wx:if="{{school.academicResults}}">
      <view class="guide-section-note" wx:if="{{school.academicRecords.length}}">{{school.academicResults.programme}} · {{school.academicResults.note}}</view>
      <scroll-view wx:if="{{school.academicRecords.length}}" class="school-result-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="school-result-row">
          <view class="school-result" wx:for="{{school.academicRecords}}" wx:key="year">
            <view class="school-result-year">{{item.year}}</view>
            <view class="school-result-score">{{item.displayScore}}</view>
            <view class="school-result-label">{{item.displayLabel}}</view>
            <view class="school-result-meta" wx:if="{{item.average && item.passRate}}">通过率 {{item.passRate}}</view>
            <view class="school-result-meta" wx:if="{{item.cohort}}">考生 {{item.cohort}}</view>
            <view class="school-result-highlight" wx:if="{{item.highlight}}">{{item.highlight}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="school-unpublished" wx:if="{{!school.academicRecords.length}}">{{school.academicResults.note}}</view>
      <view class="school-update-note" wx:if="{{school.academicResults.sourceLabel}}">资料：{{school.academicResults.sourceLabel}} · 核对于 {{school.academicResults.checkedAt}}</view>
    </view>
    <view class="school-unpublished" wx:else>学校未公开可核实的整届成绩</view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">大学录取与去向</view>
    <view class="school-outcomes" wx:if="{{school.universityOutcomes.length}}">
      <view class="school-outcome" wx:for="{{school.universityOutcomes}}" wx:key="year">
        <view class="school-outcome-year">{{item.year}}</view>
        <view class="school-outcome-summary">{{item.summary}}</view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>{{school.universityOutcomeNote || "暂无按届公开数据"}}</view>
  </view>
  </block>

  <block wx:if="{{activeDetailTab === 'APPLICATION'}}">
  <view class="guide-cost-box" wx:if="{{school.costProfile}}">
    <view class="guide-cost-label">{{school.costProfile.academicYear}}首年固定费用</view>
    <view class="guide-cost-value">{{school.costProfile.rangeText}}</view>
    <view class="guide-cost-note">已计：{{school.costProfile.includesText}}</view>
    <view class="guide-cost-note">未计：{{school.costProfile.optionalText}}</view>
    <view class="guide-cost-foot">{{school.costProfile.note}}</view>
  </view>

  <view class="guide-section" wx:if="{{pathways.length}}">
    <view class="guide-section-title">申请路径</view>
    <view class="guide-row" wx:for="{{pathways}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openPathway"><view class="guide-row-main"><view class="guide-row-title">{{item.title}}</view><view class="guide-row-note">{{item.audience}}</view></view><view class="guide-arrow">›</view></view>
  </view>

  <view class="guide-section" wx:if="{{samplePacks.length}}">
    <view class="guide-section-title">入学准备例题</view>
    <view class="guide-section-note">博思原创练习，不是学校真题，也不预测正式考试。</view>
    <view class="sample-pack" wx:for="{{samplePacks}}" wx:key="slug"><view><b>{{item.title}}</b><text>{{item.duration}}</text></view><button data-slug="{{item.slug}}" loading="{{loadingPack === item.slug}}" bindtap="openPack">查看练习</button></view>
  </view>
  </block>

  <view class="school-final-action">
    <view class="guide-section-title">下一步</view>
    <view class="guide-action-row">
      <button class="guide-action secondary" bindtap="goAssessment">先做测评</button>
      <button class="guide-action" bindtap="goConsult">咨询这所学校</button>
    </view>
  </view>
  <view class="guide-page-meta">资料更新于 {{school.publicUpdatedAt}} · {{school.updateCadence}} · 下次复核 {{school.nextPublicReviewAt}}</view>
</view>
<guide-nav active="schools" />
