<view class="guide-page" wx:if="{{school}}">
  <view class="guide-hero school-hero">
    <view class="guide-kicker">{{school.category}}{{school.editorialTier === 1 ? " · 第一梯队" : ""}}</view>
    <view class="guide-title school-name-zh">{{school.nameZh}}</view>
    <view class="school-name-en">{{school.name}}</view>
    <view class="school-data-line">资料更新于 {{school.publicUpdatedAt}} · {{school.updateCadence}}</view>
  </view>

  <view class="school-snapshot">
    <view class="school-snapshot-item" wx:for="{{school.snapshot}}" wx:key="label">
      <view class="school-snapshot-label">{{item.label}}</view>
      <view class="school-snapshot-value">{{item.value}}</view>
    </view>
  </view>

  <view class="guide-section" wx:if="{{school.campusProfiles.length}}">
    <view class="guide-section-title">校区与学段</view>
    <view class="school-campus-list">
      <view class="school-campus-row" wx:for="{{school.campusProfiles}}" wx:key="slug">
        <view class="school-campus-name">{{item.nameZh}}</view>
        <view class="school-campus-name-en">{{item.name}}</view>
        <view class="school-campus-note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view class="guide-section school-overview">
    <view class="guide-section-title">学校概览</view>
    <view class="guide-list">
      <view class="guide-fact" wx:for="{{school.verifiedFacts}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">在校规模</view>
    <view class="school-metric-grid" wx:if="{{school.communityMetrics.length}}">
      <view class="school-metric" wx:for="{{school.communityMetrics}}" wx:key="label">
        <view class="school-metric-value">{{item.value}}</view>
        <view class="school-metric-label">{{item.label}}</view>
        <view class="school-metric-asof">{{item.asOf}}</view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>暂无公开数据</view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">招生、课程与费用</view>
    <view class="school-accordion" wx:if="{{detailSections.length}}">
      <view class="school-accordion-item" wx:for="{{detailSections}}" wx:key="title" wx:for-item="section" wx:for-index="sectionIndex">
        <view class="school-accordion-head" data-index="{{sectionIndex}}" bindtap="toggleSection">
          <text>{{section.title}}</text><text>{{section.open ? "−" : "+"}}</text>
        </view>
        <view class="school-accordion-body" wx:if="{{section.open}}">
          <view class="guide-fact" wx:for="{{section.items}}" wx:key="*this" wx:for-item="fact">{{fact}}</view>
        </view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>暂无详细资料</view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">历年学术成绩</view>
    <view wx:if="{{school.academicRecords.length}}">
      <view class="guide-section-note">{{school.academicResults.programme}} · {{school.academicResults.note}}</view>
      <scroll-view class="school-result-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="school-result-row">
          <view class="school-result" wx:for="{{school.academicRecords}}" wx:key="year">
            <view class="school-result-year">{{item.year}}</view>
            <view class="school-result-score">{{item.average || "—"}}</view>
            <view class="school-result-label">平均分</view>
            <view class="school-result-meta" wx:if="{{item.passRate}}">通过率 {{item.passRate}}</view>
            <view class="school-result-meta" wx:if="{{item.cohort}}">考生 {{item.cohort}}</view>
            <view class="school-result-highlight" wx:if="{{item.highlight}}">{{item.highlight}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="school-unpublished" wx:else>暂无连续公开成绩</view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">大学录取与去向</view>
    <view class="school-outcomes" wx:if="{{school.universityOutcomes.length}}">
      <view class="school-outcome" wx:for="{{school.universityOutcomes}}" wx:key="year">
        <view class="school-outcome-year">{{item.year}}</view>
        <view class="school-outcome-summary">{{item.summary}}</view>
      </view>
    </view>
    <view class="school-unpublished" wx:else>暂无按届公开数据</view>
  </view>

  <view class="guide-cost-box" wx:if="{{school.costProfile}}">
    <view class="guide-cost-label">{{school.costProfile.academicYear}}首年固定费用</view>
    <view class="guide-cost-value">{{school.costProfile.rangeText}}</view>
    <view class="guide-cost-note">已计：{{school.costProfile.includesText}}</view>
    <view class="guide-cost-note">未计：{{school.costProfile.optionalText}}</view>
    <view class="guide-cost-foot">{{school.costProfile.note}}</view>
  </view>

  <view class="school-update-note">
    <view>更新于 {{school.publicUpdatedAt}} · 下次复核 {{school.nextPublicReviewAt}}</view>
  </view>

  <view class="school-final-action">
    <view class="guide-section-title">下一步</view>
    <view class="guide-action-row">
      <button class="guide-action secondary" bindtap="goAssessment">先做测评</button>
      <button class="guide-action" bindtap="goConsult">咨询这所学校</button>
    </view>
  </view>
</view>
<guide-nav active="schools" />
