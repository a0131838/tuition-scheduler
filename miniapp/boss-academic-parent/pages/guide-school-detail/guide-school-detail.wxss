@import "../../styles/school-guide.wxss";

.school-hero { animation: schoolRise .36s ease-out both; }
.school-name-zh { max-width: 650rpx; font-size: 54rpx; }
.school-name-en { max-width: 650rpx; margin-top: 14rpx; color: #4f5a65; font-size: 25rpx; line-height: 1.45; }
.school-snapshot { display: grid; grid-template-columns: repeat(2, 1fr); border-bottom: 2rpx solid #18202a; }
.school-snapshot-item { min-height: 142rpx; padding: 24rpx 18rpx; border-right: 1rpx solid #d9dcdf; border-bottom: 1rpx solid #d9dcdf; box-sizing: border-box; }
.school-snapshot-item:nth-child(2n) { border-right: 0; }
.school-snapshot-label { color: #818992; font-size: 23rpx; font-weight: 800; }
.school-snapshot-value { margin-top: 10rpx; color: #18202a; font-size: 26rpx; font-weight: 850; line-height: 1.45; }
.school-metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 28rpx; border-top: 2rpx solid #18202a; }
.school-metric { min-height: 156rpx; padding: 24rpx 12rpx 22rpx 0; border-bottom: 1rpx solid #d9dcdf; }
.school-metric:nth-child(2n) { padding-left: 22rpx; border-left: 1rpx solid #d9dcdf; }
.school-metric-value { color: #ec5e0a; font-size: 40rpx; font-weight: 900; }
.school-metric-label { margin-top: 6rpx; color: #18202a; font-size: 25rpx; font-weight: 800; }
.school-metric-asof { margin-top: 7rpx; color: #7a838c; font-size: 22rpx; }
.school-unpublished { margin-top: 24rpx; padding: 22rpx 0; border-top: 2rpx solid #18202a; border-bottom: 1rpx solid #d9dcdf; color: #6d7680; font-size: 24rpx; line-height: 1.65; }
.school-accordion { margin-top: 28rpx; border-top: 2rpx solid #18202a; }
.school-accordion-item { border-bottom: 1rpx solid #d9dcdf; }
.school-accordion-head { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: #18202a; font-size: 27rpx; font-weight: 850; }
.school-accordion-head text:last-child { color: #ec5e0a; font-size: 36rpx; font-weight: 500; }
.school-accordion-body { padding-bottom: 12rpx; animation: schoolReveal .22s ease-out both; }
.school-overview-head { border-top: 2rpx solid #18202a; border-bottom: 1rpx solid #d9dcdf; font-size: 38rpx; }
.school-overview-list { margin-top: 0; }
.school-result-scroll { width: 100%; margin-top: 26rpx; }
.school-result-row { display: flex; gap: 16rpx; width: max-content; padding-bottom: 12rpx; }
.school-result { width: 270rpx; min-height: 260rpx; padding: 24rpx; border-top: 5rpx solid #ec5e0a; background: #fff; box-sizing: border-box; }
.school-result-year { color: #7d858d; font-size: 23rpx; font-weight: 850; }
.school-result-score { margin-top: 12rpx; color: #18202a; font-size: 54rpx; font-weight: 900; }
.school-result-label,.school-result-meta { color: #626c76; font-size: 23rpx; }
.school-result-meta { margin-top: 8rpx; }
.school-result-highlight { margin-top: 14rpx; color: #7b3b16; font-size: 23rpx; line-height: 1.5; }
.school-outcomes { margin-top: 28rpx; border-top: 2rpx solid #18202a; }
.school-outcome { padding: 24rpx 0; border-bottom: 1rpx solid #d9dcdf; }
.school-outcome-year { color: #ec5e0a; font-size: 21rpx; font-weight: 900; }
.school-outcome-summary { margin-top: 9rpx; color: #37424d; font-size: 25rpx; line-height: 1.65; }
.school-update-note { margin-top: 48rpx; padding: 24rpx; border-left: 5rpx solid #9ca3aa; background: rgba(255,255,255,.55); color: #68727c; font-size: 22rpx; line-height: 1.65; }
.school-final-action { margin-top: 54rpx; padding: 38rpx 0 8rpx; border-top: 5rpx solid #ec5e0a; }

@keyframes schoolRise { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes schoolReveal { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
.school-campus-row {
  padding: 24rpx 0;
  border-top: 2rpx solid #e3ded8;
}

.school-campus-row:first-child {
  border-top: 0;
}

.school-campus-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #191d23;
}

.school-campus-name-en {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #777c84;
}

.school-campus-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #4e555e;
}
