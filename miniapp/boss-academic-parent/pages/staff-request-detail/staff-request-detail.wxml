<view class="page">
  <view class="top">
    <view class="eyebrow">{{request.ticketNoText}}</view>
    <view class="title">{{request.studentNameText}}</view>
    <view class="subtitle">{{request.typeText}} · {{request.statusLabelText}}</view>
  </view>

  <view class="card work-actions" wx:if="{{hasSchedulingActions}}">
    <view class="label">排课执行动作</view>
    <view class="work-action" wx:for="{{schedulingActions}}" wx:key="id"><view><view class="work-action-name">{{index + 1}}. {{item.actionLabel}}</view><view class="subtitle" wx:if="{{item.sourceSession}}">{{item.sourceSession.courseLabel}} · {{item.sourceSession.teacherName}}</view><view class="missing-source" wx:elif="{{item.needsSource}}">还未选择原课程</view></view><view class="work-action-status">{{item.statusLabel}}</view></view>
    <navigator class="coordination-link" url="/pages/staff-coordination-detail/staff-coordination-detail?id={{id}}">进入排课执行工作台 →</navigator>
  </view>

  <view class="card">
    <view class="label">{{request.contentLabelText}}</view>
    <view class="value">{{request.contentText}}</view>
    <view class="field" wx:if="{{request.internalContentText}}">
      <view class="label">内部原话摘要</view>
      <view class="subtitle">{{request.internalContentText}}</view>
    </view>
    <view class="field" wx:if="{{request.communicationSourceText}}">
      <view class="label">沟通入口</view>
      <view class="subtitle">{{request.communicationSourceText}}</view>
    </view>
    <view class="field" wx:if="{{request.createdByNameText}}">
      <view class="label">录入人</view>
      <view class="subtitle">{{request.createdByNameText}}</view>
    </view>
    <view class="field">
      <view class="label">希望处理</view>
      <view class="subtitle">{{request.requestedActionText}}</view>
    </view>
    <view class="field" wx:if="{{request.completionResultText}}">
      <view class="label">对外处理结果</view>
      <view class="subtitle">{{request.completionResultText}}</view>
    </view>
    <view class="field">
      <view class="label">负责人</view>
      <view class="subtitle">{{request.ownerText}} · 关闭负责人 {{request.closeOwnerText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{!isCompleted}}">
    <view class="label">{{request.completionLabelText}}</view>
    <textarea class="textarea" value="{{completionResult}}" placeholder="{{request.completionPlaceholderText}}" bindinput="onCompletionResultInput" />
    <view class="close-boundary" wx:if="{{!canComplete}}">{{completionBlockReason}}</view>
  </view>

  <view class="card actions" wx:if="{{!isCompleted}}">
    <button class="btn secondary" loading="{{loading}}" data-status="Waiting Parent" bindtap="updateStatus">{{request.waitingLabelText}}</button>
    <button class="btn secondary" loading="{{loading}}" data-status="Confirmed" bindtap="updateStatus">标记已确认</button>
    <button class="btn staff" wx:if="{{canComplete}}" loading="{{loading}}" data-status="Completed" bindtap="updateStatus">填写结果并标记完成</button>
    <button class="btn locked" wx:else disabled>等待负责人或管理确认完成</button>
  </view>

  <view class="card" wx:if="{{hasAttachments}}">
    <view class="attachment-head"><view><view class="label">工单附件</view><view class="subtitle">共 {{attachments.length}} 个 · 点击查看</view></view><view class="attachment-loading" wx:if="{{attachmentLoading}}">读取中…</view></view>
    <view class="attachment-grid">
      <view class="attachment-item" wx:for="{{attachments}}" wx:key="url" data-index="{{index}}" bindtap="previewAttachment">
        <image wx:if="{{item.isImage && item.localPath}}" class="attachment-image" src="{{item.localPath}}" mode="aspectFill" />
        <view wx:elif="{{item.isImage}}" class="attachment-file">图片读取中</view>
        <view wx:else class="attachment-file">文件</view>
        <view class="attachment-name">{{item.name}}</view>
      </view>
    </view>
  </view>
  <view class="card attachment-empty" wx:else><view class="label">工单附件</view><view class="subtitle">这张工单没有上传截图或文件。</view></view>
</view>
