<view class="page">
  <view class="top">
    <view class="eyebrow">博思学业管家</view>
    <view class="title">让家长随时了解孩子的学习状态和服务进展</view>
    <view class="subtitle">登录后可查看课表、课后反馈、课包财务和服务请求进度。</view>
  </view>

  <view class="card">
    <button class="btn" loading="{{loading}}" bindtap="handleLogin">微信登录</button>
    <button class="btn secondary" bindtap="goBind">我有邀请码</button>
    <button class="btn staff" bindtap="goStaff">员工入口</button>
  </view>
</view>
