<view class="page login-page">
  <view class="login-main">
    <view class="top login-top">
      <image class="brand-logo" src="/assets/gt-educational-institute-logo.png" mode="widthFix" />
      <view class="eyebrow">家长入口</view>
      <view class="title">家长登录</view>
      <view class="subtitle">使用已绑定的微信继续。</view>
    </view>

    <button class="btn login-primary" loading="{{loading}}" bindtap="handleLogin">家长微信登录</button>
    <button class="btn secondary" bindtap="goSchoolGuide">返回新加坡学校指南</button>
  </view>
</view>
