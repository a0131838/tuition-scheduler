<view class="page">
  <view class="top">
    <image class="brand-logo" src="/assets/boss-logo.png" mode="widthFix" />
    <view class="eyebrow">博思学业管家</view>
    <view class="title">家校服务</view>
    <view class="subtitle">课表、课后反馈、课包财务与服务请求。</view>
  </view>

  <view class="card">
