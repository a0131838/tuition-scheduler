.login-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: space-between;
}

.login-main {
  width: 100%;
}

.login-top {
  padding-top: 44rpx;
}

.login-primary {
  margin-top: 34rpx;
}

.portal-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 96rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #dfe1e4;
}

.portal-switch-title {
  color: #202124;
  font-size: 26rpx;
  font-weight: 700;
}

.portal-switch-note {
  margin-top: 6rpx;
  color: #777b82;
  font-size: 22rpx;
  line-height: 1.4;
}

.portal-link {
  width: auto;
  flex: 0 0 auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  color: #202124;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
}
