<view class="page monthly-staff-page">
  <view class="top-band">
    <view class="eyebrow">ACADEMIC FOLLOW-UP</view>
    <view class="title">下月排课跟进</view>
    <view class="subtitle" wx:if="{{campaign}}">{{month}} · {{campaign.status}} · 家长确认只形成需求，不会自动修改正式课表</view>
    <view class="subtitle" wx:else>网页端创建并开放月度活动后，这里显示移动跟进队列。</view>
  </view>

  <view class="cohort-row" wx:if="{{campaign}}">
    <view class="cohort-option {{cohort === item.value ? 'active' : ''}}" wx:for="{{cohortOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectCohort">
      <view>{{item.label}}</view><view class="cohort-count">{{item.count}}</view>
    </view>
  </view>
  <scroll-view scroll-x class="tabs" wx:if="{{campaign}}"><view class="tab-row"><view class="tab {{status === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-value="{{item.value}}" bindtap="selectTab">{{item.label}} {{item.value === 'ALL' ? '' : (counts[item.value] || 0)}}</view></view></scroll-view>
  <view class="empty" wx:if="{{!loading && !items.length}}">当前筛选下没有需要处理的学生课程项</view>

  <view class="item-row" wx:for="{{items}}" wx:key="id">
    <view class="item-head"><view><view class="student-name">{{item.studentName}}</view><view class="course-name">{{item.courseName}}</view><view class="source-label">{{item.sourceGroupLabel}}</view></view><view class="status-chip">{{item.statusLabel}}</view></view>
    <view class="meta-row">家长：{{item.parentName || "未绑定"}} {{item.parentPhone || ""}}</view>
    <view class="meta-row family" wx:if="{{item.isFamilyLead && item.familyItemCount > 1}}">本家庭共 {{item.familyItemCount}} 项课程，家长消息只需发送一次</view>
    <view class="meta-row" wx:if="{{item.intent}}">意向：{{item.intent}} · {{item.expectedSessionsPerWeek || "-"}} 次/周 · {{item.preferredMode || "模式未填"}}</view>
    <view class="exception-note" wx:if="{{item.exceptionReason}}">{{item.exceptionReason}}</view>
    <view class="carry-summary" wx:if="{{item.intent === 'KEEP' && item.carryForwardSchedule.length}}">
      <view class="selected-offer-title">沿用建议</view>
      <view class="meta-row" wx:for="{{item.carryForwardSchedule}}" wx:key="index">{{item.weekdayLabel}} {{item.start}}–{{item.end}} · {{item.teacher || "老师未定"}}</view>
    </view>
    <view class="note" wx:if="{{item.parentNotes}}">{{item.parentNotes}}</view>
    <view class="proxy-audit" wx:if="{{item.responseEntryMode === 'STAFF_PROXY'}}">教务代录：{{item.respondedByName || "-"}} · {{item.responseChannel || "-"}}</view>
    <view class="proxy-audit selected" wx:if="{{item.offerSelectionEntryMode === 'STAFF_PROXY'}}">家长排序由 {{item.offerSelectedByName || "-"}} 代录 · {{item.offerSelectionChannel || "-"}}</view>
    <view class="selected-offer" wx:if="{{item.selectedOffer}}">
      <view class="selected-offer-title">家长首选：{{item.selectedOffer.weekdayLabel}} {{item.selectedOffer.start}}–{{item.selectedOffer.end}}</view>
      <view class="meta-row">{{item.selectedOffer.teacherName}} · {{item.selectedOffer.sessionCount}} 次 · 每次 {{item.selectedOffer.durationMin}} 分钟</view>
      <view class="meta-row" wx:if="{{item.selectedOffer.holdExpiresText}}">临时保留至：{{item.selectedOffer.holdExpiresText}}</view>
    </view>
    <textarea class="internal-note" value="{{item.internalNote}}" maxlength="1000" data-index="{{index}}" bindinput="inputNote" placeholder="内部跟进备注（家长不可见）" />
    <view class="action-grid">
      <button class="action" wx:if="{{item.isFamilyLead}}" data-id="{{item.id}}" bindtap="copyMessage">复制家庭消息</button>
      <button class="action" data-id="{{item.id}}" data-status="{{item.status}}" loading="{{updatingId === item.id}}" bindtap="updateStatus">保存备注</button>
      <button class="action proxy" wx:if="{{item.status === 'NOT_SENT' || item.status === 'SENT' || item.status === 'VIEWED' || item.status === 'SUBMITTED' || item.status === 'OFFERED' || item.status === 'NEEDS_CLARIFICATION' || item.status === 'NO_RESPONSE' || item.status === 'PARENT_SELECTED'}}" data-id="{{item.id}}" bindtap="openProxyEntry">代家长录入/选择</button>
      <button class="action" wx:if="{{item.status === 'NOT_SENT'}}" data-id="{{item.id}}" data-status="SENT" loading="{{updatingId === item.id}}" bindtap="updateStatus">标记已发送</button>
      <button class="action" wx:if="{{item.status === 'SUBMITTED'}}" data-id="{{item.id}}" data-status="NEEDS_CLARIFICATION" loading="{{updatingId === item.id}}" bindtap="updateStatus">需要澄清</button>
      <button class="action" wx:if="{{item.status === 'PARENT_SELECTED'}}" data-id="{{item.id}}" data-status="MATCHED" loading="{{updatingId === item.id}}" bindtap="updateStatus">确认家长首选</button>
      <button class="action" wx:if="{{item.status === 'SUBMITTED' && item.intent === 'KEEP'}}" data-id="{{item.id}}" data-status="MATCHED" loading="{{updatingId === item.id}}" bindtap="updateStatus">确认沿用建议</button>
      <button class="action" wx:if="{{(item.status === 'SUBMITTED' && item.intent !== 'KEEP') || item.status === 'NEEDS_CLARIFICATION'}}" data-id="{{item.id}}" data-status="MATCHED" loading="{{updatingId === item.id}}" bindtap="updateStatus">人工确认匹配</button>
      <button class="action primary" wx:if="{{item.status === 'MATCHED' && item.selectedOffer}}" data-id="{{item.id}}" bindtap="openScheduling">打开预填排课</button>
      <button class="action primary" wx:if="{{item.status === 'MATCHED'}}" data-id="{{item.id}}" data-status="SCHEDULED" loading="{{updatingId === item.id}}" bindtap="updateStatus">正式课表完成后标记</button>
    </view>
  </view>
</view>
