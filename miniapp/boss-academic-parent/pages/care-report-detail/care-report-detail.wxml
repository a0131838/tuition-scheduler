<view class="page">
  <view wx:if="{{loading}}" class="empty">正在读取报告...</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <block wx:else>
    <view class="report-head">
      <view class="label">{{report.periodLabel}}</view>
      <view class="detail-title">{{report.title}}</view>
      <view class="detail-meta">{{report.periodStartText}} - {{report.periodEndText}}</view>
      <view class="detail-meta">审核：{{report.approvedByName || "服务团队"}} · {{report.publishedAtText}}</view>
    </view>

    <view class="detail-section" wx:for="{{sections}}" wx:key="title">
      <view class="section-title">{{item.title}}</view>
      <view class="section-body">{{item.body}}</view>
    </view>

    <view class="question-area">
      <view class="section-title">报告问答</view>
      <view class="question-item" wx:for="{{questions}}" wx:key="id">
        <view class="question-meta">{{item.createdAtText}} · {{item.statusText}}</view>
        <view class="question-title">问：{{item.question}}</view>
        <view class="question-response" wx:if="{{item.response}}">答：{{item.response}}</view>
        <view class="question-meta" wx:if="{{item.respondedAtText}}">回复时间：{{item.respondedAtText}}</view>
        <button class="btn secondary compact" wx:if="{{item.status === 'ANSWERED'}}" data-id="{{item.id}}" bindtap="closeQuestion">问题已解决</button>
      </view>
      <view class="question-empty" wx:if="{{!questions.length}}">暂无提问</view>
      <textarea class="question-input" maxlength="2000" value="{{questionText}}" bindinput="onQuestionInput" placeholder="对本期报告有疑问，可在这里提交" />
      <button class="btn secondary" disabled="{{!questionText || submittingQuestion}}" loading="{{submittingQuestion}}" bindtap="submitQuestion">提交问题</button>
    </view>

    <button class="btn" bindtap="openPdf">查看 PDF</button>
    <button class="btn secondary" wx:if="{{!report.acknowledged}}" loading="{{acknowledging}}" bindtap="acknowledge">确认收到</button>
    <view class="acknowledged" wx:else>已确认收到</view>
  </block>
</view>
