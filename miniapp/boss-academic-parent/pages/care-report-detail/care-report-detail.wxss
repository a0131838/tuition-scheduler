.report-detail-page {
  padding-top: 20rpx;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.report-head {
  padding: 24rpx 0 28rpx;
  border-bottom: 1rpx solid #dfe2e5;
}

.detail-title {
  margin-top: 10rpx;
  color: #17191c;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.35;
}

.detail-meta {
  margin-top: 9rpx;
  color: #6b6f76;
  font-size: 23rpx;
  line-height: 1.5;
}

.summary-band {
  margin-top: 24rpx;
  padding: 28rpx;
  border-left: 8rpx solid #ec5e0a;
  background: #fff7f1;
}

.summary-label {
  color: #9b3e08;
  font-size: 23rpx;
  font-weight: 750;
}

.summary-body {
  margin-top: 10rpx;
  color: #202124;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.65;
  white-space: pre-wrap;
}

.section-group {
  margin-top: 38rpx;
}

.group-title {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #dfe2e5;
  color: #202124;
  font-size: 32rpx;
  font-weight: 750;
}

.priority-section,
.detail-section {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e3e5e8;
}

.section-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 750;
}

.section-body {
  margin-top: 12rpx;
  color: #34383e;
  font-size: 27rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.question-area {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #dfe2e5;
}

.question-note,
.question-meta,
.question-empty {
  margin-top: 8rpx;
  color: #747980;
  font-size: 23rpx;
  line-height: 1.5;
}

.question-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eceef1;
}

.question-title,
.question-response {
  margin-top: 10rpx;
  color: #34383e;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.question-response {
  color: #225b38;
}

.question-empty {
  padding: 18rpx 0;
}

.question-input {
  width: 100%;
  min-height: 180rpx;
  margin: 18rpx 0 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9dce0;
  border-radius: 6rpx;
  background: #fff;
  font-size: 27rpx;
}

.compact {
  min-height: 68rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.report-action-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d9dce0;
  background: rgba(255, 255, 255, 0.97);
}

.action-button,
.acknowledged {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 6rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}

.secondary-action {
  background: #f0f1f3;
  color: #34383e;
}

.primary-action {
  background: #ec5e0a;
  color: #fff;
}

.acknowledged {
  background: #edf7f2;
  color: #287a62;
}
