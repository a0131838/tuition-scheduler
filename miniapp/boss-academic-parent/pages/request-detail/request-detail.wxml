<view class="page">
  <view class="top">
    <view class="eyebrow">{{request.ticketNoText}}</view>
    <view class="title">{{request.typeText}}</view>
    <view class="subtitle">{{request.statusLabelText}}</view>
  </view>

  <view class="card">
    <view class="label">请求内容</view>
    <view class="value">{{request.contentText}}</view>
    <view class="field">
      <view class="label">希望处理</view>
      <view class="subtitle">{{request.requestedActionText}}</view>
    </view>
    <view class="field">
      <view class="label">负责人</view>
      <view class="subtitle">{{request.ownerText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{request.attachmentUrls.length}}">
    <view class="label">附件</view>
    <view wx:for="{{request.attachmentUrls}}" wx:key="*this" class="subtitle">{{item}}</view>
  </view>
</view>
