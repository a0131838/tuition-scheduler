@import "../../styles/teacher-tools.wxss";
.todo-total { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-top: 1rpx solid #d8d5d0; border-bottom: 1rpx solid #d8d5d0; }.todo-total.has-work .total-number { color: #9b3d31; }.total-number { min-width: 74rpx; color: #17663a; font-size: 54rpx; font-weight: 850; }.total-title { font-size: 29rpx; font-weight: 800; }.total-hint { margin-top: 5rpx; color: #73777e; font-size: 22rpx; }
.todo-row { display: flex; align-items: center; gap: 16rpx; padding: 23rpx 0; border-bottom: 1rpx solid #dedbd6; }.todo-mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; background: #e7efe9; color: #17663a; font-size: 23rpx; font-weight: 800; }.todo-mark.urgent { background: #f8ebe8; color: #9b3d31; }.todo-copy { min-width: 0; flex: 1; }.todo-title { font-size: 28rpx; font-weight: 800; }.todo-detail, .session-meta { margin-top: 5rpx; color: #6b6f76; font-size: 23rpx; }.todo-arrow { color: #aaa7a2; font-size: 38rpx; }
.session-row { padding: 21rpx 0; border-bottom: 1rpx solid #dedbd6; }.session-title { font-weight: 800; }.session-flags { display: flex; gap: 10rpx; margin-top: 10rpx; }.session-flags text { padding: 5rpx 10rpx; background: #fff0e7; color: #9b3e08; border-radius: 999rpx; font-size: 21rpx; font-weight: 750; }
