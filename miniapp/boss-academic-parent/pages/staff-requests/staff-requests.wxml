<view class="page">
  <view class="top">
    <view class="eyebrow">教务工单</view>
    <view class="title">全部工单</view>
    <view class="subtitle">当前筛选共 {{total}} 条，包含家长请求和内部教务工单。</view>
  </view>

  <view class="filters">
    <picker mode="selector" range="{{owners}}" value="{{ownerIndex}}" bindchange="changeOwner">
      <view class="picker">{{owners[ownerIndex]}}</view>
    </picker>
    <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="changeType">
      <view class="picker">{{types[typeIndex]}}</view>
    </picker>
    <picker mode="selector" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus">
      <view class="picker">{{statuses[statusIndex].label}}</view>
    </picker>
  </view>

  <button class="btn" bindtap="newRequest">录入家长新工单</button>

  <block wx:if="{{requests.length}}">
    <view wx:for="{{requests}}" wx:key="id" class="card" bindtap="openDetail" data-id="{{item.id}}">
      <view class="row">
        <view class="pill source-pill">{{item.sourceLabelText}}</view>
        <view class="pill">{{item.type}}</view>
        <view class="pill">{{item.statusLabel}}</view>
      </view>
      <view class="value">{{item.studentNameText}} · {{item.displayTitle}}</view>
      <view class="subtitle">负责人：{{item.displayOwner}} · 更新于 {{item.updatedAtText}}</view>
    </view>
  </block>
  <view wx:else class="empty">暂无符合条件的工单</view>
</view>
