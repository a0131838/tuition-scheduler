.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f6f4f1;color:#202124}.top{margin-bottom:24rpx}.eyebrow{color:#ec5e0a;font-weight:800;font-size:24rpx}.title{font-size:42rpx;font-weight:900;margin-top:8rpx}.subtitle{color:#6b7280;line-height:1.6;margin-top:10rpx}.card{background:#fff;border:1rpx solid #e2e5e9;border-radius:14rpx;padding:24rpx}.label{font-weight:800;margin:22rpx 0 10rpx}.picker,.context,textarea{box-sizing:border-box;width:100%;padding:18rpx;border:1rpx solid #d9dce0;border-radius:10rpx;background:#fafafa}.context{color:#6b7280}textarea{min-height:180rpx}.primary,.secondary{margin-top:18rpx;border-radius:10rpx;font-weight:800}.primary{background:#ec5e0a;color:#fff}.secondary{background:#f0f1f3;color:#272a2f}
