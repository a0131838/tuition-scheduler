<view class="page">
  <view class="top" wx:if="{{session}}">
    <view class="eyebrow">{{session.startText}}</view>
    <view class="title">{{session.courseLabel}}</view>
    <view class="subtitle">老师：{{sessionTeacherName}} · 学生：{{sessionStudentText}}</view>
    <view class="subtitle">{{sessionLocationText}}</view>
  </view>

  <view class="card" wx:if="{{readOnlySession}}">
    <view class="section-title">课程信息</view>
    <view class="hint">当前账号可查看课程信息；排课协调由教务/管理处理，点名和反馈由本节课老师处理。</view>
  </view>

  <view class="card" wx:if="{{canRequestReschedule}}">
    <view class="section-title">老师调课申请</view>
    <view class="request-existing" wx:if="{{hasTeacherRequestExisting}}">
      <view class="label">已有开放申请：{{teacherRequestExisting.ticketNo}}</view>
      <view class="hint">状态：{{teacherRequestExisting.status}} · 负责人：{{teacherRequestExisting.owner}}</view>
      <view class="hint">再次提交会补充到同一张工单，不会重复创建。</view>
    </view>
    <view class="field">
      <view class="label">学生</view>
      <picker mode="selector" range="{{teacherRequestStudents}}" range-key="name" value="{{teacherRequestStudentIndex}}" bindchange="changeTeacherRequestStudent">
        <view class="picker">{{teacherRequestStudentName}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">调课原因</view>
      <textarea value="{{teacherRequestReason}}" bindinput="inputTeacherRequestReason" placeholder="填写为什么需要调整本节课" />
    </view>
    <view class="field-row">
      <view class="field grow">
        <view class="label">建议日期</view>
        <picker mode="date" value="{{teacherRequestDate}}" bindchange="changeTeacherRequestDate"><view class="picker">{{teacherRequestDate}}</view></picker>
      </view>
      <view class="field grow">
        <view class="label">建议时间</view>
        <picker mode="time" value="{{teacherRequestTime}}" bindchange="changeTeacherRequestTime"><view class="picker">{{teacherRequestTime}}</view></picker>
      </view>
    </view>
    <view class="hint">提交后由教务协调并确认调整。</view>
    <button class="secondary-action" loading="{{teacherRequestSaving}}" disabled="{{teacherRequestSaving}}" bindtap="submitTeacherRescheduleRequest">提交给教务</button>
  </view>

  <view class="card" wx:if="{{canManageSchedule}}">
    <view class="section-title">排课</view>
    <view class="mode-control">
      <button class="{{scheduleRescheduleClass}}" data-mode="reschedule" bindtap="setSchedulingMode">改本节课</button>
      <button class="{{scheduleCreateClass}}" data-mode="create" bindtap="setSchedulingMode">新增一节</button>
      <button class="{{scheduleSeriesClass}}" data-mode="series" bindtap="setSchedulingMode">连续排课</button>
    </view>
    <view class="field">
      <view class="label">上课日期</view>
      <picker mode="date" value="{{scheduleDate}}" bindchange="changeScheduleDate">
        <view class="picker">{{scheduleDate}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">开始时间</view>
      <picker mode="time" value="{{scheduleTime}}" bindchange="changeScheduleTime">
        <view class="picker">{{scheduleTime}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">课程时长（分钟）</view>
      <input type="number" value="{{scheduleDuration}}" bindinput="inputScheduleDuration" placeholder="60" />
    </view>
    <view class="field" wx:if="{{scheduleSeriesMode}}">
      <view class="label">连续周数</view>
      <input type="number" value="{{scheduleWeeks}}" bindinput="inputScheduleWeeks" placeholder="4" />
      <view class="hint">每周同一时间，最多 12 周；任何一周冲突都会整批停止。</view>
    </view>
    <view class="hint">老师与地点沿用当前课程；提交前会检查课包、可用时间和课程冲突。</view>
    <button class="secondary-action" loading="{{scheduleChecking}}" disabled="{{scheduleChecking}}" bindtap="previewScheduling">检查冲突</button>
    <view class="schedule-preview" wx:if="{{hasSchedulePreview}}">
      <view class="label">检查通过</view>
      <view class="preview-row">
        <view class="hint">原安排</view>
        <view>{{schedulePreviewBeforeText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">新安排</view>
        <view>{{schedulePreviewAfterText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">课程</view>
        <view>{{schedulePreviewCourseText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">老师 / 学生</view>
        <view>{{schedulePreviewPeopleText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">地点</view>
        <view>{{schedulePreviewLocationText}}</view>
      </view>
      <view class="coordination-close" wx:if="{{hasScheduleCoordinationTickets}}">
        <view class="label">同步完成排课协调工单（可选）</view>
        <view class="hint">只勾选已经通过本次排课解决的工单；未勾选的工单保持原状态。</view>
        <checkbox-group bindchange="changeScheduleCoordinationTickets">
          <label class="ticket-choice" wx:for="{{scheduleCoordinationTickets}}" wx:key="id">
            <checkbox value="{{item.id}}" color="#ec5e0a" />
            <view>
              <view>{{item.label}}</view>
              <view class="hint">当前状态：{{item.statusText}}</view>
            </view>
          </label>
        </checkbox-group>
      </view>
      <button class="primary" loading="{{scheduleSaving}}" disabled="{{scheduleSaving}}" bindtap="applyScheduling">{{scheduleConfirmText}}</button>
    </view>
  </view>

  <view class="card" wx:if="{{canShowCancellation}}">
    <view class="section-title">请假 / 取消</view>
    <view class="field">
      <view class="label">学生</view>
      <picker mode="selector" range="{{cancellationStudents}}" range-key="name" value="{{cancellationStudentIndex}}" bindchange="changeCancellationStudent">
        <view class="picker">{{cancellationStudentName}}</view>
      </picker>
    </view>
    <view class="switch-row">
      <view>
        <view class="label">扣除本节课时</view>
        <view class="hint">关闭时不扣课时</view>
      </view>
      <switch checked="{{cancellationCharge}}" color="#b42318" bindchange="changeCancellationCharge" />
    </view>
    <view class="field cancellation-note">
      <view class="label">原因</view>
      <textarea value="{{cancellationNote}}" bindinput="inputCancellationNote" placeholder="填写家长请假、取消或特殊处理原因" />
    </view>
    <button class="secondary-action" loading="{{cancellationChecking}}" disabled="{{cancellationChecking}}" bindtap="previewCancellation">预检请假 / 取消</button>
    <view class="schedule-preview" wx:if="{{hasCancellationPreview}}">
      <view class="label">预检通过</view>
      <view class="preview-row">
        <view class="hint">课程时间</view>
        <view>{{cancellationPreviewTimeText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">课时处理</view>
        <view>{{cancellationPreviewChargeText}}</view>
      </view>
      <view class="coordination-close" wx:if="{{hasCancellationTickets}}">
        <view class="label">同步完成请假工单（可选）</view>
        <checkbox-group bindchange="changeCancellationTickets">
          <label class="ticket-choice" wx:for="{{cancellationTickets}}" wx:key="id">
            <checkbox value="{{item.id}}" color="#b42318" />
            <view>{{item.label}}</view>
          </label>
        </checkbox-group>
      </view>
      <button class="danger-action" loading="{{cancellationSaving}}" disabled="{{cancellationSaving}}" bindtap="applyCancellation">确认请假 / 取消</button>
    </view>
  </view>

  <view class="card" wx:if="{{hasReplacementTeachers}}">
    <view class="section-title">更换本节课老师</view>
    <view class="field">
      <view class="label">新老师</view>
      <picker mode="selector" range="{{replacementTeachers}}" range-key="name" value="{{replacementTeacherIndex}}" bindchange="changeReplacementTeacher">
        <view class="picker">{{replacementTeacherName}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">更换原因</view>
      <textarea value="{{replacementReason}}" bindinput="inputReplacementReason" placeholder="填写家长确认、老师请假或内部安排原因" />
    </view>
    <button class="secondary-action" loading="{{replacementChecking}}" disabled="{{replacementChecking}}" bindtap="previewReplacement">检查新老师</button>
    <view class="schedule-preview" wx:if="{{hasReplacementPreview}}">
      <view class="label">检查通过</view>
      <view class="preview-row">
        <view class="hint">课程时间</view>
        <view>{{replacementPreviewTimeText}}</view>
      </view>
      <view class="preview-row">
        <view class="hint">老师变更</view>
        <view>{{replacementPreviewTeacherText}}</view>
      </view>
      <view class="coordination-close" wx:if="{{hasReplacementTickets}}">
        <view class="label">同步完成换老师工单（可选）</view>
        <checkbox-group bindchange="changeReplacementTickets">
          <label class="ticket-choice" wx:for="{{replacementTickets}}" wx:key="id">
            <checkbox value="{{item.id}}" color="#ec5e0a" />
            <view>{{item.label}}</view>
          </label>
        </checkbox-group>
      </view>
      <button class="primary" loading="{{replacementSaving}}" disabled="{{replacementSaving}}" bindtap="applyReplacement">确认更换老师</button>
    </view>
  </view>

  <view class="card" wx:if="{{canManageSchedule}}">
    <view class="section-title">更换本节课地点</view>
    <view class="hint location-current">当前地点：{{currentLocationText}}</view>
    <view class="field">
      <view class="label">新校区 / 授课方式</view>
      <picker mode="selector" range="{{locationCampuses}}" range-key="name" value="{{locationCampusIndex}}" bindchange="changeLocationCampus">
        <view class="picker">{{locationCampusName}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">新教室</view>
      <picker wx:if="{{hasLocationRooms}}" mode="selector" range="{{locationRooms}}" range-key="name" value="{{locationRoomIndex}}" bindchange="changeLocationRoom">
        <view class="picker">{{locationRoomName}}</view>
      </picker>
      <view class="picker" wx:else>当前校区没有可用教室</view>
    </view>
    <view class="field">
      <view class="label">更换原因</view>
      <textarea value="{{locationReason}}" bindinput="inputLocationReason" placeholder="填写临时教室调整、转线上或校区变更原因" />
    </view>
    <view class="hint">只更改这一节课；其他历史和未来课次保持原地点。</view>
    <button class="secondary-action" loading="{{locationChecking}}" disabled="{{locationChecking}}" bindtap="previewLocationChange">检查新地点</button>
    <view class="schedule-preview" wx:if="{{hasLocationPreview}}">
      <view class="label">检查通过</view>
      <view class="preview-row"><view class="hint">原地点</view><view>{{locationPreviewFromText}}</view></view>
      <view class="preview-row"><view class="hint">新地点</view><view>{{locationPreviewToText}}</view></view>
      <button class="primary" loading="{{locationSaving}}" disabled="{{locationSaving}}" bindtap="applyLocationChange">确认只改本节课</button>
    </view>
  </view>

  <view class="card" wx:if="{{canManageCoordination}}">
    <view class="section-title">排课协调沟通</view>
    <view class="field">
      <view class="label">学生</view>
      <picker mode="selector" range="{{coordinationStudents}}" range-key="name" value="{{coordinationStudentIndex}}" bindchange="changeCoordinationStudent">
        <view class="picker">{{coordinationStudentName}}</view>
      </picker>
    </view>
    <view class="coordination-summary" wx:if="{{hasCoordinationTicket}}">
      <view class="label">{{coordinationTicketNoText}}</view>
      <view class="hint">{{coordinationStatusText}}</view>
    </view>
    <view class="hint" wx:else>{{coordinationTicketNoText}}</view>
    <view class="field">
      <view class="label">本次联系对象</view>
      <picker mode="selector" range="{{coordinationTargets}}" value="{{coordinationTargetIndex}}" bindchange="changeCoordinationTarget">
        <view class="picker">{{coordinationTargets[coordinationTargetIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">本次沟通结果</view>
      <textarea value="{{coordinationResult}}" bindinput="inputCoordinationResult" placeholder="例如：家长只能周三 18:00 后上课，已告知会继续与老师确认。" />
    </view>
    <view class="field">
      <view class="label">工单状态</view>
      <picker mode="selector" range="{{coordinationStatuses}}" range-key="label" value="{{coordinationStatusIndex}}" bindchange="changeCoordinationStatus">
        <view class="picker">{{coordinationStatuses[coordinationStatusIndex].label}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">下一步动作</view>
      <textarea value="{{coordinationNextAction}}" bindinput="inputCoordinationNextAction" placeholder="请输入下一步" />
    </view>
    <view class="field">
      <view class="label">下次跟进日期</view>
      <picker mode="date" value="{{coordinationDueDate}}" bindchange="changeCoordinationDueDate">
        <view class="picker">{{coordinationDueDate}}</view>
      </picker>
    </view>
    <button class="primary" loading="{{coordinationSaving}}" disabled="{{coordinationSaving}}" bindtap="saveCoordination">保存协调记录</button>
    <button class="secondary-action" wx:if="{{hasAvailabilityUrl}}" bindtap="copyAvailabilityLink">复制家长时间表链接</button>
    <view class="field history" wx:if="{{hasCoordinationHistory}}">
      <view class="label">历史沟通记录</view>
      <view class="history-text">{{coordinationHistoryText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{canTeachSession}}">
    <view class="section-title">点名</view>
    <view wx:if="{{attendanceRows.length}}">
      <view wx:for="{{attendanceRows}}" wx:key="studentId" class="attendance-row">
        <view class="attendance-head">
          <view class="label">{{item.studentName}}</view>
          <picker mode="selector" range="{{attendanceStatusOptions}}" range-key="label" value="{{item.statusIndex}}" bindchange="changeAttendanceStatus" data-index="{{index}}">
            <view class="status-pill">{{item.statusLabel}}</view>
          </picker>
        </view>
        <input value="{{item.note}}" bindinput="inputAttendanceNote" data-index="{{index}}" placeholder="备注，可不填" />
      </view>
    </view>
    <view wx:else class="hint">暂无可点名学生</view>
    <button class="secondary-action" loading="{{attendanceSaving}}" disabled="{{attendanceSaving}}" bindtap="saveAttendance">保存点名</button>
  </view>

  <view class="card" wx:if="{{canTeachSession}}">
    <view class="label">重点学生</view>
    <input value="{{focusStudentName}}" bindinput="inputFocusStudent" placeholder="可不填，默认全班" />
  </view>

  <view class="card" wx:if="{{canTeachSession}}">
    <view class="section-title">家长可见课后反馈</view>
    <view wx:for="{{parentFeedbackSections}}" wx:key="key" class="field">
      <view class="label">{{item.label}}</view>
      <view class="hint">{{item.hint}}</view>
      <textarea value="{{item.value}}" bindinput="inputSection" data-index="{{index}}" placeholder="请输入" />
    </view>
  </view>

  <view class="card" wx:if="{{canTeachSession}}">
    <view class="label">课后作业</view>
    <textarea value="{{homework}}" bindinput="inputHomework" placeholder="请输入本次课后作业" />
    <view class="switch-row">
      <view>
        <view class="label">之前作业完成</view>
        <view class="hint">请根据实际情况选择</view>
      </view>
      <switch checked="{{previousHomeworkDoneChecked}}" bindchange="changePreviousHomework" />
    </view>
  </view>

  <button class="primary" wx:if="{{canTeachSession}}" loading="{{saving}}" disabled="{{submitDisabled}}" bindtap="submit">提交反馈</button>
</view>
