.page {
  padding: 28rpx;
  background: #f7f9f4;
  min-height: 100vh;
}

.top {
  margin-bottom: 24rpx;
}

.eyebrow,
.hint {
  color: #6b7280;
  font-size: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #123d2b;
  margin-top: 8rpx;
}

.subtitle {
  color: #4b5563;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #dce5d8;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-weight: 800;
  color: #123d2b;
  margin-bottom: 18rpx;
}

.field {
  margin-bottom: 22rpx;
}

.attendance-row {
  border-top: 1rpx solid #e5eadf;
  padding: 18rpx 0;
}

.attendance-row:first-child {
  border-top: 0;
}

.attendance-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.status-pill {
  min-width: 120rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #edf2ea;
  color: #123d2b;
  font-weight: 800;
  padding: 10rpx 18rpx;
}

.label {
  font-weight: 700;
  color: #20352b;
  margin-bottom: 8rpx;
}

input,
textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d6ded2;
  border-radius: 8rpx;
  padding: 18rpx;
  background: #fbfcfa;
}

.picker {
  min-height: 44rpx;
  color: #20352b;
}

.coordination-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #edf2ea;
  border-radius: 8rpx;
  padding: 18rpx;
  margin-bottom: 20rpx;
}

.mode-control {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.mode-button {
  min-height: 72rpx;
  border-radius: 8rpx;
  background: #edf2ea;
  color: #20352b;
  font-weight: 700;
  font-size: 26rpx;
}

.mode-button.active {
  background: #0b3d2a;
  color: #fff;
}

.schedule-preview {
  border-top: 1rpx solid #dce5d8;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.preview-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 12rpx 0;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.history {
  border-top: 1rpx solid #e5eadf;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.history-text {
  white-space: pre-wrap;
  color: #4b5563;
  line-height: 1.7;
  font-size: 25rpx;
}

textarea {
  min-height: 150rpx;
  margin-top: 12rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.primary {
  background: #0b3d2a;
  color: #fff;
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.secondary-action {
  background: #edf2ea;
  color: #123d2b;
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 16rpx;
}
