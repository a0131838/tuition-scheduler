.page {
  padding: 28rpx;
  background: #f5f6f7;
  min-height: 100vh;
}

.top {
  margin-bottom: 24rpx;
}

.eyebrow,
.hint {
  color: #6b7280;
  font-size: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #202124;
  margin-top: 8rpx;
}

.subtitle {
  color: #4b5563;
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e3e5e8;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-weight: 800;
  color: #ec5e0a;
  margin-bottom: 18rpx;
}

.field {
  margin-bottom: 22rpx;
}

.attendance-row {
  border-top: 1rpx solid #e3e5e8;
  padding: 18rpx 0;
}

.attendance-row:first-child {
  border-top: 0;
}

.attendance-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.status-pill {
  min-width: 120rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f0f1f3;
  color: #ec5e0a;
  font-weight: 800;
  padding: 10rpx 18rpx;
}

.label {
  font-weight: 700;
  color: #202124;
  margin-bottom: 8rpx;
}

input,
textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d9dce0;
  border-radius: 8rpx;
  padding: 18rpx;
  background: #fafafa;
}

.picker {
  min-height: 44rpx;
  color: #202124;
}

.coordination-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #f0f1f3;
  border-radius: 8rpx;
  padding: 18rpx;
  margin-bottom: 20rpx;
}

.mode-control {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.mode-button {
  min-height: 72rpx;
  border-radius: 8rpx;
  background: #f0f1f3;
  color: #202124;
  font-weight: 700;
  font-size: 26rpx;
}

.mode-button.active {
  background: #ec5e0a;
  color: #fff;
}

.schedule-preview {
  border-top: 1rpx solid #e3e5e8;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.preview-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 12rpx 0;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.coordination-close {
  border-top: 1rpx solid #e3e5e8;
  margin-top: 16rpx;
  padding-top: 20rpx;
}

.ticket-choice {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  align-items: start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e3e5e8;
  overflow-wrap: anywhere;
}

.history {
  border-top: 1rpx solid #e3e5e8;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.history-text {
  white-space: pre-wrap;
  color: #4b5563;
  line-height: 1.7;
  font-size: 25rpx;
}

textarea {
  min-height: 150rpx;
  margin-top: 12rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.primary {
  background: #ec5e0a;
  color: #fff;
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.secondary-action {
  background: #f0f1f3;
  color: #ec5e0a;
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.cancellation-note {
  margin-top: 22rpx;
}

.danger-action {
  background: #b42318;
  color: #fff;
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 20rpx;
}

.location-current {
  border-left: 6rpx solid #2f6b4f;
  margin-bottom: 18rpx;
  padding-left: 14rpx;
}

.request-existing {
  background: #f0f1f3;
  border-left: 6rpx solid #2f6b4f;
  margin-bottom: 18rpx;
  padding: 16rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .grow {
  flex: 1;
  min-width: 0;
}
.feedback-review-status {
  margin: 16rpx 0 6rpx;
  padding: 18rpx;
  border-left: 6rpx solid #ec5e0a;
  border-radius: 10rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 24rpx;
  line-height: 1.55;
}
