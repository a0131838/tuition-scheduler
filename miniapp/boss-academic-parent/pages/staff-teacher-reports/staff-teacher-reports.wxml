<view class="page ops-page page-enter">
  <view class="ops-hero"><view class="ops-kicker">TEACHER COMMUNICATIONS</view><view class="ops-title">通知、管理反馈与教学报告</view><view class="ops-subtitle">Read notices, acknowledge manager feedback, and save report drafts without leaving WeChat. / 在微信内完成通知确认、管理反馈和报告草稿。</view></view>
  <view class="tabs"><view class="tab {{noticesTabClass}}" data-tab="notices" bindtap="switchTab">通知 {{unreadNoticesText}}</view><view class="tab {{feedbackTabClass}}" data-tab="feedback" bindtap="switchTab">管理反馈 {{pendingManagerFeedbackText}}</view><view class="tab {{reportsTabClass}}" data-tab="reports" bindtap="switchTab">教学报告 {{pendingReportsText}}</view></view>
  <view class="ops-section" wx:if="{{showNotices}}"><view class="ops-card {{item.cardClass}}" wx:for="{{notices}}" wx:key="id"><view class="ops-card-head"><view><view class="ops-card-title">{{item.titleDisplay}}</view><view class="ops-card-meta">{{item.titleEn}} · {{item.publishedAt}}</view></view><view class="ops-badge">{{item.readText}}</view></view><view class="body-copy">{{item.bodyZh}}</view><view class="body-copy">{{item.bodyEn}}</view><button class="ops-primary" wx:if="{{item.needsRead}}" data-id="{{item.id}}" bindtap="acknowledgeNotice">我已阅读 / Acknowledge</button></view><view class="empty-state" wx:if="{{noNotices}}">暂无通知 / No notices</view></view>
  <view class="ops-section" wx:if="{{showFeedback}}"><view class="ops-card {{item.cardClass}}" wx:for="{{managerFeedbacks}}" wx:key="id"><view class="ops-card-head"><view><view class="ops-card-title">{{item.category}}</view><view class="ops-card-meta">{{item.managerName}} · {{item.createdAt}}</view><view class="ops-card-meta" wx:if="{{item.sessionSummary}}">{{item.sessionSummary}}</view></view><view class="ops-badge">{{item.ackText}}</view></view><view class="body-copy">{{item.body}}</view><button class="ops-primary" wx:if="{{item.needsAck}}" data-id="{{item.id}}" bindtap="acknowledgeFeedback">确认已知悉 / Acknowledge</button></view><view class="empty-state" wx:if="{{noManagerFeedbacks}}">暂无管理反馈 / No manager feedback</view></view>
  <view class="ops-section" wx:if="{{showReports}}"><view class="report-editor" wx:if="{{selected}}"><view class="ops-card-title">{{selected.studentName}} · {{selected.courseName}}</view><view class="ops-card-meta">{{selected.kind}} · {{selected.status}}</view><view class="draft-note" wx:if="{{localDraftRestored}}">已恢复本机未提交草稿 / Local draft restored.</view><block wx:if="{{isMidterm}}"><view class="field"><view class="field-label">整体表现 / Overall summary</view><textarea data-key="overallSummary" value="{{draft.overallSummary}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">主要优势 / Key strengths</view><textarea data-key="keyStrengths" value="{{draft.keyStrengths}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">主要瓶颈 / Primary bottlenecks</view><textarea data-key="primaryBottlenecks" value="{{draft.primaryBottlenecks}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">下阶段重点 / Next phase focus</view><textarea data-key="nextPhaseFocus" value="{{draft.nextPhaseFocus}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">建议练习量 / Suggested practice</view><textarea data-key="suggestedPracticeLoad" value="{{draft.suggestedPracticeLoad}}" bindinput="inputDraft" /></view></block><block wx:else><view class="field"><view class="field-label">结课总结 / Final summary</view><textarea data-key="finalSummary" value="{{draft.finalSummary}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">学生优势 / Strengths</view><textarea data-key="strengths" value="{{draft.strengths}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">继续提升 / Areas to continue</view><textarea data-key="areasToContinue" value="{{draft.areasToContinue}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">给家长的话 / Note to family</view><textarea data-key="parentNote" value="{{draft.parentNote}}" bindinput="inputDraft" /></view><view class="field"><view class="field-label">下一步建议 / Recommendation</view><picker mode="selector" range="{{recommendations}}" value="{{recommendationIndex}}" bindchange="changeRecommendation"><view class="picker">{{draft.recommendedNextStepDisplay}}</view></picker></view></block><view class="ops-actions"><button class="ops-secondary" bindtap="closeEditor">返回</button><button class="ops-secondary" loading="{{saving}}" bindtap="saveDraft">保存草稿</button></view><button class="ops-primary" loading="{{saving}}" bindtap="submitReport">确认提交报告</button></view><block wx:else><view class="ops-card" wx:for="{{reports}}" wx:key="id"><view class="ops-card-head"><view><view class="ops-card-title">{{item.studentName}} · {{item.courseName}}</view><view class="ops-card-meta">{{item.kind}} · {{item.assignedText}} · {{item.status}}</view></view><view class="ops-badge">{{item.editableText}}</view></view><button class="ops-secondary" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editReport">{{item.actionText}}</button></view><view class="empty-state" wx:if="{{noReports}}">暂无教学报告 / No reports</view></block></view>
</view>
