<view class="page">
  <view class="top">
    <view class="eyebrow">教学事务</view>
    <view class="title">请假与调课申请</view>
    <view class="subtitle">选择课程并提交请假或调课申请。</view>
  </view>
  <view class="summary"><view class="summary-item"><view class="summary-number">{{upcomingCount}}</view><view class="label">未来30天课程</view></view></view>
  <view class="section-title">选择课程</view>
  <block wx:if="{{upcoming.length}}">
    <view class="list-card" wx:for="{{upcoming}}" wx:key="id">
      <view class="item-title">{{item.courseLabel}}</view>
      <view class="item-meta">{{item.timeText}}</view>
      <view class="item-meta">{{item.studentText}} · {{item.locationText}}</view>
      <button class="primary" data-id="{{item.id}}" bindtap="openSession">填写申请</button>
    </view>
  </block>
  <view class="empty" wx:else>未来30天没有需要处理的课程</view>
</view>
