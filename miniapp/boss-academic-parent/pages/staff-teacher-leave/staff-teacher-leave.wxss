@import "../../styles/teacher-tools.wxss";
.profile,.form-section,.request{background:#fff;border:1rpx solid #e5e7eb;padding:28rpx;margin-bottom:22rpx}.profile-name{font-size:36rpx;font-weight:800;margin-bottom:8rpx}.balance-strip{white-space:nowrap;margin:22rpx 0}.balance-card{display:inline-block;vertical-align:top;width:270rpx;height:150rpx;white-space:normal;background:#eff6ff;border:1rpx solid #bfdbfe;padding:22rpx;margin-right:16rpx}.balance-name{font-size:24rpx;color:#334155}.balance-number{font-size:38rpx;font-weight:900;margin-top:12rpx}.attachment{font-size:20rpx;color:#c2410c}.field{margin:20rpx 0}.label{font-size:24rpx;font-weight:700;margin-bottom:10rpx}.picker,input,textarea{box-sizing:border-box;width:100%;background:#f8fafc;border:1rpx solid #cbd5e1;padding:22rpx;min-height:82rpx}textarea{height:180rpx}.date-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.history-title{margin:32rpx 0 16rpx}.request-head{display:flex;justify-content:space-between;gap:12rpx;margin-bottom:12rpx}.request-type{font-weight:800}.status{font-size:22rpx;font-weight:800}.status-APPROVED{color:#15803d}.status-REJECTED,.status-CANCELLED{color:#b91c1c}.status-SUBMITTED{color:#b45309}.meta,.note{font-size:23rpx;color:#64748b;margin-top:10rpx}.cancel{margin-top:16rpx;color:#b91c1c;background:#fff;border:1rpx solid #fca5a5}
