<view class="page ops-page page-enter">
  <view class="ops-hero"><view class="ops-kicker">新家长·不和老学生工单混在一起</view><view class="ops-title">新咨询快速录入</view><view class="ops-subtitle">微信里有新家长咨询时，先留下客户资源；需要评估或排课时再转成工单。</view></view>
  <button class="ops-primary" bindtap="toggleCreate">{{createButtonText}}</button>
  <view class="lead-form" wx:if="{{creating}}"><view class="ops-card-title">只先填必要信息</view><view class="field"><view class="field-label">学生姓名 *</view><input data-key="studentName" value="{{form.studentName}}" bindinput="inputField" placeholder="不确定时可填家长称呼+孩子" /></view><view class="field"><view class="field-label">家长姓名</view><input data-key="parentName" value="{{form.parentName}}" bindinput="inputField" /></view><view class="field"><view class="field-label">微信号</view><input data-key="parentWechat" value="{{form.parentWechat}}" bindinput="inputField" /></view><view class="field"><view class="field-label">电话</view><input data-key="parentPhone" value="{{form.parentPhone}}" bindinput="inputField" /></view><view class="field"><view class="field-label">年级</view><input data-key="grade" value="{{form.grade}}" bindinput="inputField" /></view><view class="field"><view class="field-label">家长原始咨询内容 *</view><textarea data-key="initialContent" value="{{form.initialContent}}" bindinput="inputField" maxlength="2000" placeholder="直接粘贴微信里的需求" /></view><view class="field"><view class="field-label">来源</view><picker mode="selector" range="{{options.sourceTypes}}" value="{{sourceTypeIndex}}" bindchange="changeSource"><view class="picker">{{form.sourceType}}</view></picker></view><view class="field"><view class="field-label">意向程度</view><picker mode="selector" range="{{options.intentLevels}}" value="{{intentIndex}}" bindchange="changeIntent"><view class="picker">{{form.intentLevel}}</view></picker></view><view class="field"><view class="field-label">下次跟进日期</view><picker mode="date" value="{{form.nextActionDue}}" data-key="nextActionDue" bindchange="inputField"><view class="picker">{{form.nextActionDue}}</view></picker></view><view class="ops-actions"><button class="ops-secondary" bindtap="chooseAlbum">从相册选截图</button><button class="ops-secondary" bindtap="chooseWechat">从微信选截图</button></view><view class="evidence-preview" wx:if="{{evidencePath}}">已选：{{evidenceName}}，创建后自动留存</view><button class="ops-primary" loading="{{saving}}" bindtap="createLead">创建新咨询资源</button></view>
  <view class="ops-section"><view class="search-row"><input value="{{query}}" bindinput="inputQuery" bindconfirm="load" placeholder="搜索学生 / 家长 / 电话" /><button bindtap="load">查找</button></view><view class="ops-section-title">最近咨询</view><view class="ops-card {{item.cardClass}}" wx:for="{{leads}}" wx:key="id"><view class="ops-card-head"><view><view class="ops-card-title">{{item.studentName}} · {{item.leadNo}}</view><view class="lead-contact">{{item.contactText}} · {{item.contactValue}}</view><view class="ops-card-meta">{{item.status}} · {{item.intentLevel}} · 负责人 {{item.ownerName}}</view></view><view class="ops-badge {{item.cardClass}}">{{item.badgeText}}</view></view><view class="feedback-content">{{item.latestSummary}}</view><view class="ops-card-meta">下一步：{{item.nextActionDisplay}} · {{item.nextActionTextDisplay}}</view><view class="evidence-preview" wx:if="{{item.evidenceSaved}}">已留存咨询截图</view><view class="ops-actions"><button class="ops-secondary" wx:if="{{item.canCreateTicket}}" data-id="{{item.id}}" bindtap="createTicket">转成排课工单</button><button class="ops-secondary" wx:else data-id="{{item.schedulingTicketId}}">已创建排课工单</button></view></view><view class="empty-state" wx:if="{{showEmpty}}">当前没有匹配的新咨询</view></view>
</view>
