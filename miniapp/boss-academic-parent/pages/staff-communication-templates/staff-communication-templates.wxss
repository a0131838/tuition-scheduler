.page{min-height:100vh;background:#f6f4f1;padding:24rpx;box-sizing:border-box;color:#172033}.top{padding:20rpx 4rpx 28rpx;border-bottom:2rpx solid #d8dee8}.kicker{font-size:22rpx;color:#b64b0b;font-weight:800}.title{font-size:42rpx;font-weight:850;margin-top:8rpx}.help{font-size:25rpx;color:#657083;line-height:1.6;margin-top:8rpx}.card,.preview{margin-top:22rpx;background:#fff;border:1rpx solid #d8dee8;padding:24rpx}.label{font-size:25rpx;font-weight:750;margin:18rpx 0 8rpx}.picker,.input{border:1rpx solid #bdc8d8;padding:20rpx;background:#fff;box-sizing:border-box;width:100%}.picker{display:flex;justify-content:space-between}.version{font-size:22rpx;color:#607086;margin-top:12rpx}.primary{margin-top:26rpx;background:#e75b0b;color:#fff;border-radius:6rpx;font-weight:800}.preview{text-space-collapse:preserve;white-space:pre-wrap;line-height:1.65;font-size:26rpx}.loading{padding:60rpx;text-align:center;color:#657083}
