<view class="guide-page" wx:if="{{pathway}}">
  <view class="guide-hero">
    <view class="guide-kicker">ADMISSION PATHWAY</view>
    <view class="guide-title" style="font-size: 50rpx;">{{pathway.title}}</view>
    <view class="guide-subtitle">{{pathway.audience}}</view>
  </view>
  <view class="guide-section">
    <view class="guide-section-note">{{pathway.summary}}</view>
  </view>
  <view class="guide-section">
    <view class="guide-section-title">申请要点</view>
    <view class="guide-list">
      <view class="guide-fact" wx:for="{{pathway.facts}}" wx:key="*this">{{item}}</view>
    </view>
  </view>
  <view class="guide-section">
    <view class="guide-section-title">注意事项</view>
    <view class="guide-list">
      <view class="guide-fact" wx:for="{{pathway.cautions}}" wx:key="*this">{{item}}</view>
    </view>
  </view>
  <view class="guide-section">
    <view class="guide-section-title">官方来源</view>
    <view class="guide-list">
      <view class="guide-source" wx:for="{{sources}}" wx:key="id">
        <view class="guide-source-title">{{item.title}}</view>
        <view class="guide-source-meta">{{item.authority}}</view>
        <button class="guide-action secondary" style="margin-top: 16rpx;" data-url="{{item.url}}" bindtap="copyLink">复制官方链接</button>
      </view>
    </view>
  </view>
</view>
<guide-nav active="assessment" />
