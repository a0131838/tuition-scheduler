.home-page { padding-top: 8rpx; }
.student-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0 24rpx; border-bottom: 1rpx solid #dedbd6; }
.student-copy { min-width: 0; }
.student-name { overflow: hidden; color: #202421; font-size: 38rpx; font-weight: 820; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.student-meta { margin-top: 7rpx; overflow: hidden; color: #747a76; font-size: 22rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.student-switch { flex: 0 0 auto; padding: 14rpx 0 14rpx 22rpx; color: #9b3e08; font-size: 22rpx; font-weight: 720; }
.parent-task { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 26rpx 24rpx; border: 1rpx solid #efc8ae; border-radius: 16rpx; background: #fff7f0; }
.task-copy { min-width: 0; flex: 1; }
.task-label { color: #9b3e08; font-size: 20rpx; font-weight: 760; }
.task-title { display: -webkit-box; overflow: hidden; margin-top: 7rpx; color: #202421; font-size: 29rpx; font-weight: 820; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.task-meta { margin-top: 7rpx; overflow: hidden; color: #737873; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-action { flex: 0 0 auto; padding: 16rpx 18rpx; border-radius: 12rpx; background: #ec5e0a; color: #fff; font-size: 22rpx; font-weight: 780; }
.all-clear { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; padding: 18rpx 0; color: #58635e; font-size: 23rpx; }
.all-clear-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #287a62; }
.next-block { margin-top: 28rpx; padding: 24rpx 0; border-top: 1rpx solid #dedbd6; border-bottom: 1rpx solid #dedbd6; }
.block-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.block-label { color: #6f7773; font-size: 21rpx; font-weight: 720; }
.block-link { color: #9b3e08; font-size: 21rpx; font-weight: 700; }
.session-time { margin-top: 13rpx; color: #202421; font-size: 32rpx; font-weight: 830; }
.session-course { margin-top: 7rpx; font-size: 25rpx; font-weight: 720; }
.session-meta, .session-notice { margin-top: 7rpx; color: #6f7773; font-size: 21rpx; line-height: 1.45; }
.session-notice { color: #9b3e08; }
.latest-block { margin-top: 24rpx; padding: 22rpx 24rpx; border-left: 6rpx solid #287a62; border-radius: 0 14rpx 14rpx 0; background: #eff7f3; }
.update-kind { margin-top: 16rpx; color: #287a62; font-size: 19rpx; font-weight: 760; }
.update-title { display: -webkit-box; overflow: hidden; margin-top: 6rpx; color: #202421; font-size: 27rpx; font-weight: 810; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.update-summary { display: -webkit-box; overflow: hidden; margin-top: 7rpx; color: #59635e; font-size: 21rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.update-time { margin-top: 9rpx; color: #818782; font-size: 19rpx; }
.service-section { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #dedbd6; }
.service-heading { color: #202421; font-size: 27rpx; font-weight: 820; }
.service-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.service-entry { box-sizing: border-box; width: calc(50% - 7rpx); min-height: 126rpx; padding: 20rpx; border: 1rpx solid #dedbd6; border-radius: 14rpx; background: #fff; }
.service-entry:active { border-color: #ec5e0a; background: #fff7f0; }
.service-title { color: #242825; font-size: 24rpx; font-weight: 790; }
.service-copy { margin-top: 8rpx; color: #747a76; font-size: 19rpx; line-height: 1.4; }
.home-skeleton, .home-error { padding: 30rpx 0; }
.skeleton-line, .skeleton-block { background: #e9e6e1; animation: pulse 1.2s ease-in-out infinite; }
.skeleton-line { height: 28rpx; margin-top: 16rpx; }
.skeleton-line.wide { width: 72%; height: 42rpx; }
.skeleton-block { height: 220rpx; margin-top: 28rpx; }
.home-error-title { font-size: 30rpx; font-weight: 800; }
.home-error-copy { margin-top: 10rpx; color: #737873; font-size: 24rpx; }
.quiet-button { width: auto; min-height: 68rpx; margin: 24rpx 0 0; padding: 0 24rpx; border: 1rpx solid #d1cec8; border-radius: 12rpx; background: #fff; color: #343936; font-size: 24rpx; line-height: 68rpx; }
@keyframes pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
