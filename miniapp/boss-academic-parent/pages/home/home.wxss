.grid-2 {
  margin-top: 18rpx;
}

.progress-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid #ec5e0a;
  border-bottom: 1rpx solid #dfe2e5;
}

.progress-entry-copy {
  min-width: 0;
  flex: 1;
}

.progress-entry-title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.progress-entry-arrow {
  flex: 0 0 auto;
  color: #ec5e0a;
  font-size: 46rpx;
  line-height: 1;
}

.notification-band {
  border-top: 1rpx solid #e3e5e8;
  border-bottom: 1rpx solid #e3e5e8;
  margin: 22rpx 0;
  padding: 22rpx 0;
}

.notification-actions {
  display: grid;
  gap: 12rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 16rpx;
}

.reminder-status {
  margin-top: 12rpx;
}

.coverage-list {
  margin-top: 16rpx;
  border-top: 1rpx solid #e3e5e8;
}

.coverage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e3e5e8;
  font-size: 25rpx;
}

.coverage-main {
  min-width: 0;
}

.coverage-state {
  flex: 0 0 auto;
  color: #17603a;
  font-size: 23rpx;
  font-weight: 700;
}

.coverage-state.needs-consent {
  color: #a33a2b;
}

.reminder-button {
  background: #f0f1f3;
  border-radius: 8rpx;
  color: #ec5e0a;
  font-size: 25rpx;
  font-weight: 700;
  min-height: 72rpx;
  overflow-wrap: anywhere;
}
