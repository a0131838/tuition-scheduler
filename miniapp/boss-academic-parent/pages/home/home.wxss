.home-page{padding-top:12rpx}.student-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0 28rpx}.student-copy{min-width:0}.student-name{margin-top:7rpx;font-size:44rpx;font-weight:820;line-height:1.15}.student-meta{margin-top:9rpx;color:#6c716e;font-size:23rpx;line-height:1.45}.student-switch{flex:0 0 auto;min-height:64rpx;margin:0;padding:0 23rpx;border:1rpx solid #d7d5d0;border-radius:999rpx;background:#fff;color:#343936;font-size:23rpx;line-height:64rpx}.status-hero{padding:30rpx 28rpx 28rpx;border-left:8rpx solid #287a62;background:#edf7f2}.status-hero.tone-watch{border-left-color:#c56a25;background:#fff6ed}.status-hero.tone-attention{border-left-color:#9d3b30;background:#fff1ef}.status-topline{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.status-kicker{color:#66716c;font-size:21rpx;font-weight:700}.fresh-badge{padding:7rpx 12rpx;border-radius:999rpx;background:#fff;color:#17634d;font-size:20rpx;font-weight:750}.status-title{margin-top:13rpx;color:#17231e;font-size:38rpx;font-weight:850;line-height:1.2}.status-summary{margin-top:11rpx;color:#4e5853;font-size:25rpx;line-height:1.55}.status-updated{margin-top:18rpx;color:#78817d;font-size:21rpx}.parent-task{display:flex;align-items:stretch;gap:18rpx;margin-top:24rpx;padding:23rpx 0;border-bottom:1rpx solid #dedbd6}.task-marker{width:8rpx;flex:0 0 auto;border-radius:5rpx;background:#ec5e0a}.task-copy{min-width:0;flex:1}.task-label{color:#9b3e08;font-size:21rpx;font-weight:750}.task-title{margin-top:7rpx;color:#242725;font-size:28rpx;font-weight:780;line-height:1.45}.task-meta{margin-top:7rpx;color:#727772;font-size:22rpx}.row-arrow{align-self:center;color:#ec5e0a;font-size:42rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:38rpx}.section-title{font-size:30rpx;font-weight:820}.section-link{color:#9b3e08;font-size:22rpx;font-weight:700}.next-session,.latest-update{margin-top:15rpx;padding:24rpx 0;border-top:1rpx solid #dedbd6;border-bottom:1rpx solid #dedbd6}.session-time{font-size:31rpx;font-weight:820}.session-course{margin-top:8rpx;font-size:27rpx;font-weight:720}.session-meta,.update-summary{margin-top:8rpx;color:#68706c;font-size:23rpx;line-height:1.5}.quiet-empty{margin-top:15rpx;padding:28rpx 0;border-top:1rpx solid #dedbd6;border-bottom:1rpx solid #dedbd6;color:#777d79;font-size:24rpx}.update-heading{margin-top:40rpx}.update-kind{color:#9b3e08;font-size:21rpx;font-weight:750}.update-title{margin-top:8rpx;font-size:29rpx;font-weight:800;line-height:1.4}.update-summary{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3}.update-footer{display:flex;justify-content:space-between;gap:18rpx;margin-top:15rpx;color:#818681;font-size:20rpx}.week-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:34rpx;border-top:1rpx solid #dedbd6;border-bottom:1rpx solid #dedbd6}.week-item{min-width:0;padding:23rpx 9rpx;text-align:center;border-right:1rpx solid #e3e1dc}.week-item:last-child{border-right:0}.week-number{color:#202622;font-size:36rpx;font-weight:850}.week-number.balance{font-size:24rpx;line-height:1.45}.week-label{margin-top:6rpx;color:#747a76;font-size:20rpx;line-height:1.35}.quick-heading{margin-top:40rpx}.quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin-top:14rpx;border-top:1rpx solid #dedbd6}.quick-entry{padding:23rpx 18rpx 23rpx 0;border-right:1rpx solid #dedbd6;border-bottom:1rpx solid #dedbd6}.quick-entry:nth-child(even){padding-left:20rpx;border-right:0}.quick-title{font-size:26rpx;font-weight:800}.quick-note{margin-top:6rpx;color:#797e7a;font-size:21rpx;line-height:1.4}.home-skeleton,.home-error{padding:30rpx 0}.skeleton-line,.skeleton-block{background:#e9e6e1;animation:pulse 1.2s ease-in-out infinite}.skeleton-line{height:28rpx;margin-top:16rpx}.skeleton-line.wide{width:72%;height:42rpx}.skeleton-block{height:220rpx;margin-top:28rpx}.home-error-title{font-size:30rpx;font-weight:800}.home-error-copy{margin-top:10rpx;color:#737873;font-size:24rpx}.quiet-button{width:auto;min-height:68rpx;margin:24rpx 0 0;padding:0 24rpx;border:1rpx solid #d1cec8;border-radius:12rpx;background:#fff;color:#343936;font-size:24rpx;line-height:68rpx}@keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}
