.grid-2 {
  margin-top: 18rpx;
}

.notification-band {
  border-top: 1rpx solid #dce5d8;
  border-bottom: 1rpx solid #dce5d8;
  margin: 22rpx 0;
  padding: 22rpx 0;
}

.notification-actions {
  display: grid;
  gap: 12rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 16rpx;
}

.reminder-status {
  margin-top: 12rpx;
}

.coverage-list {
  margin-top: 16rpx;
  border-top: 1rpx solid #e1e7dc;
}

.coverage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e1e7dc;
  font-size: 25rpx;
}

.coverage-main {
  min-width: 0;
}

.coverage-state {
  flex: 0 0 auto;
  color: #17603a;
  font-size: 23rpx;
  font-weight: 700;
}

.coverage-state.needs-consent {
  color: #a33a2b;
}

.reminder-button {
  background: #edf2ea;
  border-radius: 8rpx;
  color: #123d2b;
  font-size: 25rpx;
  font-weight: 700;
  min-height: 72rpx;
  overflow-wrap: anywhere;
}
