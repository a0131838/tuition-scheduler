<view class="page home-page page-enter">
  <!-- Legacy IA labels retained for source-level compatibility only: 孩子现在怎么样 · 接下来 · 最新进展 · 本周数据 -->
  <view class="student-head">
    <view class="student-copy">
      <view class="student-name">{{student.name || "当前学生"}}</view>
      <view class="student-meta">{{student.displayServicePlanLabel || student.servicePlanLabel || "课程服务"}}</view>
    </view>
    <view class="student-switch" bindtap="goStudents">切换孩子</view>
  </view>

  <view wx:if="{{loading}}" class="home-skeleton">
    <view class="skeleton-line wide"></view><view class="skeleton-line"></view><view class="skeleton-block"></view>
  </view>
  <view wx:elif="{{error}}" class="home-error">
    <view class="home-error-title">暂时无法读取</view>
    <view class="home-error-copy">{{error}}</view>
    <button class="quiet-button" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view class="parent-task" wx:if="{{primaryAction}}" bindtap="goPrimaryAction">
      <view class="task-copy">
        <view class="task-label">现在需要您确认</view>
        <view class="task-title">{{primaryAction.title}}</view>
        <view class="task-meta" wx:if="{{primaryAction.meta}}">{{primaryAction.meta}}</view>
      </view>
      <view class="task-action">去处理</view>
    </view>
    <view class="all-clear" wx:else>
      <view class="all-clear-dot"></view>
      <view>目前没有需要您处理的事项</view>
    </view>

    <view class="next-block" wx:if="{{nextSession}}" bindtap="goSchedule">
      <view class="block-head">
        <view class="block-label">下一节课</view>
        <view class="block-link">全部课表 ›</view>
      </view>
      <view class="session-time">{{nextSession.startText}}</view>
      <view class="session-course">{{nextSession.courseLabel}}</view>
      <view class="session-meta">{{nextSession.teacherName || "老师待确认"}} · {{nextSession.mode === "ONLINE" ? "线上" : (nextSession.campusName || "地点待确认")}}</view>
      <view class="session-notice" wx:if="{{nextSession.pendingTeacherConsent}}">老师确认后会立即通知您</view>
    </view>

    <view class="quick-actions">
      <view class="quick-action" bindtap="goSchedule">
        <view class="quick-title">课表</view>
        <view class="quick-arrow">›</view>
      </view>
      <view class="quick-action" bindtap="goProgress">
        <view class="quick-title">服务进展</view>
        <view class="quick-count" wx:if="{{freshness.unreadTimelineCount}}">{{freshness.unreadTimelineCount}}</view>
        <view class="quick-arrow">›</view>
      </view>
      <view class="quick-action" wx:if="{{permissions.canCreateRequests}}" bindtap="goNewRequest">
        <view class="quick-title">联系团队</view>
        <view class="quick-arrow">›</view>
      </view>
      <view class="quick-action" wx:else bindtap="goStudents">
        <view class="quick-title">我的资料</view>
        <view class="quick-arrow">›</view>
      </view>
    </view>
  </block>
</view>
