<view class="page ops-page page-enter">
  <view class="ops-hero">
    <view class="ops-title">续费跟进</view>
  </view>

  <view class="metrics">
    <view><text>开放</text><strong>{{total}}</strong></view>
    <view class="danger"><text>紧急</text><strong>{{urgent}}</strong></view>
    <view class="warning"><text>到期跟进</text><strong>{{due}}</strong></view>
  </view>

  <view class="cohort-row">
    <button class="cohort {{item.className}}" wx:for="{{cohortOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="changeCohort">
      <text>{{item.label}}</text><strong>{{item.count}}</strong>
    </button>
  </view>

  <view class="filter-row"><button class="filter {{item.className}}" wx:for="{{filterOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="changeFilter">{{item.label}}</button></view>

  <view class="empty-state" wx:if="{{showEmpty}}">当前没有续费跟进任务。</view>
  <view class="renewal-card {{item.cardClass}}" wx:for="{{tasks}}" wx:key="id">
    <view class="renewal-head" data-id="{{item.id}}" bindtap="toggle">
      <view class="renewal-main">
        <view><text class="risk">{{item.riskLabel}}</text><text class="source-badge">{{item.sourceBadge}}</text></view>
        <view class="name">{{item.studentName}} · {{item.courseName}}</view>
        <view class="meta">{{item.statusLabel}} · {{item.ownerDisplay}}</view>
        <view class="meta">下次跟进：{{item.followUpText}}</view>
      </view>
      <view class="balance"><strong>{{item.balanceText}}</strong><text>约 {{item.lessonsDisplay}} 节</text></view>
    </view>

    <view class="renewal-detail" wx:if="{{item.showDetail}}">
      <view class="forecast-grid">
        <view><text>未来已排</text><strong>{{item.scheduledText}}</strong></view>
        <view><text>周均消耗</text><strong>{{item.weeklyText}}</strong></view>
        <view><text>预计用完</text><strong>{{item.depletionText}}</strong></view>
      </view>

      <view class="section-title">{{item.communicationTitle}}</view>
      <view class="parent-message">{{item.parentMessage}}</view>
      <button class="secondary" data-index="{{index}}" bindtap="copyMessage">复制家长文案</button>
      <button class="secondary" data-index="{{index}}" bindtap="uploadEvidence">{{item.uploadLabel}}</button>
      <view class="evidence {{item.evidenceClass}}">{{item.evidenceText}}</view>

      <view class="section-title">更新跟进进度</view>
      <view class="field-label">当前状态</view>
      <picker mode="selector" range="{{item.statusOptions}}" range-key="label" value="{{item.statusIndex}}" disabled="{{item.financialStage}}" data-index="{{index}}" bindchange="changeStatus">
        <view class="picker-field">{{item.statusOptions[item.statusIndex].label}} ›</view>
      </picker>
      <view class="field-label">负责人</view>
      <input class="field" value="{{item.ownerDraft}}" data-index="{{index}}" data-field="ownerDraft" bindinput="inputField" placeholder="Emily / Eva / Jasmine" />
      <view class="field-label">下次跟进时间（YYYY-MM-DDTHH:mm）</view>
      <input class="field" value="{{item.nextFollowUpDraft}}" data-index="{{index}}" data-field="nextFollowUpDraft" bindinput="inputField" placeholder="2026-07-24T18:00" />
      <view class="field-label">{{item.groupFieldLabel}}</view>
      <input class="field" value="{{item.groupDraft}}" data-index="{{index}}" data-field="groupDraft" bindinput="inputField" placeholder="{{item.groupPlaceholder}}" />
      <view class="field-label">{{item.responseFieldLabel}}</view>
      <textarea class="field textarea" value="{{item.responseDraft}}" data-index="{{index}}" data-field="responseDraft" bindinput="inputField" placeholder="{{item.responsePlaceholder}}" />
      <view class="field-label">内部备注</view>
      <textarea class="field textarea" value="{{item.noteDraft}}" data-index="{{index}}" data-field="noteDraft" bindinput="inputField" placeholder="折扣、停课、共享课包等特殊情况" />
      <button class="primary" loading="{{loading}}" disabled="{{item.financialStage}}" data-index="{{index}}" bindtap="save">{{item.financialStage ? '已交财务继续处理' : '保存进度并记录日志'}}</button>

      <view class="links">
        <navigator url="/pages/staff-student-workspace/staff-student-workspace?id={{item.studentId}}">打开学生360°</navigator>
        <text wx:if="{{!operationsOnly}}">合同、发票与收款请在网页版续费工作台继续处理。</text>
        <text wx:else>家长确认续费后，请交由财务继续处理合同、发票与收款。</text>
      </view>
      <view class="history" wx:if="{{item.history.length}}">
        <view class="section-title">最近操作</view>
        <view wx:for="{{item.history}}" wx:for-item="history" wx:key="createdAt">{{history.actorName}} · {{history.action}}</view>
      </view>
    </view>
  </view>
</view>
