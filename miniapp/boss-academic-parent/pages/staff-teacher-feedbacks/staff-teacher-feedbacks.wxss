@import "../../styles/teacher-tools.wxss";
.summary-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; color: #656b73; }.summary-strong { color: #202124; font-size: 36rpx; font-weight: 800; }.unread, .badge { color: #9b3d31; font-weight: 800; }
.student-row { display: flex; justify-content: space-between; gap: 18rpx; padding: 24rpx 0; border-bottom: 1rpx solid #dedbd6; }.student-main { min-width: 0; }.student-name { font-size: 31rpx; font-weight: 800; }.student-meta, .feedback-meta, .detail-count { margin-top: 6rpx; color: #73777e; font-size: 23rpx; }.student-preview { margin-top: 8rpx; color: #4f545b; font-size: 25rpx; line-height: 1.45; }.student-side { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }.badge { padding: 6rpx 10rpx; border-radius: 999rpx; background: #f8ebe8; font-size: 21rpx; }.arrow { color: #a3a09b; font-size: 38rpx; }
.student-detail-head { padding: 8rpx 0 20rpx; border-bottom: 1rpx solid #d8d5d0; }.back { width: auto; margin: 0 0 18rpx; padding: 0; background: transparent; color: #9b3e08; font-size: 25rpx; text-align: left; }.detail-name { font-size: 38rpx; font-weight: 800; }
.feedback-row { padding: 28rpx 0; border-bottom: 1rpx solid #d8d5d0; }.feedback-head { display: flex; justify-content: space-between; gap: 16rpx; }.feedback-course { font-size: 29rpx; font-weight: 800; }.mine { color: #17663a; font-size: 22rpx; font-weight: 750; }.feedback-section, .homework { margin-top: 18rpx; color: #35393e; font-size: 26rpx; line-height: 1.58; }.section-label { margin-bottom: 5rpx; color: #9b3e08; font-size: 22rpx; font-weight: 800; }.homework { padding: 16rpx; background: #eceae6; border-radius: 8rpx; }.previous { margin-top: 8rpx; color: #656b73; font-size: 23rpx; }
