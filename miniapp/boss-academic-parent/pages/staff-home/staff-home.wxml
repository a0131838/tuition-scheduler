<view class="page staff-page page-enter">
  <view class="workspace-head">
    <view class="workspace-meta">
      <view class="role-chip">{{roleText}}</view>
      <view class="today-text">{{todayText}}</view>
    </view>
    <view class="workspace-title">{{staffNameText}}</view>
    <view class="workspace-subtitle">{{workspaceSubtitle}}</view>
  </view>

  <view class="priority-panel {{priorityTone}}" bindtap="goPriority">
    <view class="priority-kicker">{{priorityLabel}}</view>
    <view class="priority-title">{{priorityTitle}}</view>
    <view class="priority-meta">{{priorityMeta}}</view>
    <view class="priority-action">{{priorityAction}} <text>›</text></view>
  </view>

  <view class="metric-strip" wx:if="{{isTeacher}}">
    <view class="metric-cell" bindtap="goSchedule"><view class="metric-value">{{todaySessionCount}}</view><view class="metric-name">今日课程</view></view>
    <view class="metric-cell {{teacherMetricClass}}" bindtap="goTeacherTodos"><view class="metric-value">{{teacherTodoCount}}</view><view class="metric-name">我的待办</view></view>
    <view class="metric-cell" bindtap="goTeacherPayroll"><view class="metric-value">{{teacherPayrollPending}}</view><view class="metric-name">工资确认</view></view>
  </view>
  <view class="metric-strip" wx:else>
    <view class="metric-cell" bindtap="goSchedule"><view class="metric-value">{{todaySessionCount}}</view><view class="metric-name">今日课程</view></view>
    <view class="metric-cell" bindtap="goRequests"><view class="metric-value">{{pendingCount}}</view><view class="metric-name">全部工单</view></view>
    <view class="metric-cell metric-alert" wx:if="{{canManageCoordination}}" bindtap="goCoordination"><view class="metric-value">{{coordinationOverdueCount}}</view><view class="metric-name">排课逾期</view></view>
    <view class="metric-cell" wx:else><view class="metric-value">—</view><view class="metric-name">按角色开放</view></view>
  </view>

  <view class="academic-capture" wx:if="{{isAcademic}}" bindtap="goNewRequest">
    <view class="capture-mark">录</view>
    <view class="capture-copy">
      <view class="capture-kicker">微信群有新的家长消息？</view>
      <view class="capture-title">立即录入工单</view>
      <view class="capture-detail">选学生、粘贴消息、加截图，三步完成</view>
    </view>
    <view class="capture-arrow">›</view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">{{workSectionTitle}}</view>
      <view class="section-hint">{{workSectionHint}}</view>
    </view>
  </view>

  <view class="work-list" wx:if="{{isTeacher}}">
    <view class="work-row" bindtap="goActionCenter">
      <view class="work-icon icon-orange">总</view>
      <view class="work-copy"><view class="work-title">统一待办</view><view class="work-detail">通知、管理反馈、报告和教学任务集中处理</view></view>
      <view class="work-badge alert" wx:if="{{actionCenterCount}}">{{actionCenterCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherTodos">
      <view class="work-icon icon-orange">办</view>
      <view class="work-copy"><view class="work-title">我的待办</view><view class="work-detail">工资、点名、反馈和报销集中处理</view></view>
      <view class="work-badge alert" wx:if="{{teacherTodoCount}}">{{teacherTodoCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canViewAssessments}}" bindtap="goAssessments">
      <view class="work-icon icon-orange">测</view>
      <view class="work-copy"><view class="work-title">入学准备度测评</view><view class="work-detail">{{assessmentDetail}}</view></view>
      <view class="work-badge alert" wx:if="{{assessmentAwaitingCount}}">{{assessmentAwaitingCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{hasNextTeacherSession}}" bindtap="goNextTeacherSession">
      <view class="work-icon icon-orange">课</view>
      <view class="work-copy"><view class="work-title">下一节课</view><view class="work-detail">{{nextTeacherSessionText}}</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goSchedule">
      <view class="work-icon">表</view>
      <view class="work-copy"><view class="work-title">我的课表</view><view class="work-detail">查看课程、点名与课后反馈</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{isManager}}" bindtap="goHealth">
      <view class="work-icon icon-orange">健</view>
      <view class="work-copy"><view class="work-title">运营健康看板</view><view class="work-detail">异常、逾期、漏反馈和通知失败集中检查</view></view>
      <view class="work-arrow">›</view>
    </view>
    <block wx:if="{{showAllTools}}">
    <view class="work-row" bindtap="goTeacherAvailability">
      <view class="work-icon">时</view>
      <view class="work-copy"><view class="work-title">我的可用时间</view><view class="work-detail">未来 30 天 {{teacherAvailabilityCount}} 个时段</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherLeave">
      <view class="work-icon">调</view>
      <view class="work-copy"><view class="work-title">请假与调课申请</view><view class="work-detail">未来 30 天 {{teacherUpcomingCount}} 节课程</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherExpenses">
      <view class="work-icon">费</view>
      <view class="work-copy"><view class="work-title">我的报销</view><view class="work-detail">{{teacherExpenseCount}} 笔处理中或需补充</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherPayroll">
      <view class="work-icon">薪</view>
      <view class="work-copy"><view class="work-title">我的工资单</view><view class="work-detail">查看工资明细与确认进度</view></view>
      <view class="work-badge alert" wx:if="{{teacherPayrollPending}}">待确认</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherFeedbacks">
      <view class="work-icon">评</view>
      <view class="work-copy"><view class="work-title">学生历史反馈</view><view class="work-detail">查看所带学生的历任老师反馈</view></view>
      <view class="work-badge" wx:if="{{teacherUnreadFeedbackCount}}">{{teacherUnreadFeedbackCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherReports">
      <view class="work-icon">报</view>
      <view class="work-copy"><view class="work-title">通知与教学报告</view><view class="work-detail">确认管理反馈，填写阶段和结课报告</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goTeacherHistory">
      <view class="work-icon">记</view>
      <view class="work-copy"><view class="work-title">教学记录</view><view class="work-detail">本月已完成 {{teacherCompletedCount}} 节</view></view>
      <view class="work-arrow">›</view>
    </view>
    </block>
    <button class="tool-toggle" bindtap="toggleAllTools">{{showAllTools ? '收起其他工具' : '展开教学、工资与行政工具'}}</button>
  </view>

  <view class="work-list" wx:else>
    <view class="work-row" bindtap="goAiWork">
      <view class="work-icon icon-orange">AI</view>
      <view class="work-copy"><view class="work-title">AI 今日工作</view><view class="work-detail">读取工单后只确认一次</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goActionCenter">
      <view class="work-icon icon-orange">总</view>
      <view class="work-copy"><view class="work-title">统一待办</view><view class="work-detail">工单、沟通、审批和新咨询集中处理</view></view>
      <view class="work-badge alert" wx:if="{{actionCenterCount}}">{{actionCenterCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canOpenStudentWorkspace}}" bindtap="goStudentWorkspace">
      <view class="work-icon icon-orange">360</view>
      <view class="work-copy"><view class="work-title">学生360°工作台</view><view class="work-detail">一页查看课程、课包、工单、联系人和反馈</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goCommunications">
      <view class="work-icon icon-orange">讯</view>
      <view class="work-copy"><view class="work-title">家长沟通与通知</view><view class="work-detail">审核反馈、转发微信群、提醒老师和家长</view></view>
      <view class="work-badge alert" wx:if="{{hasCommunicationTasks}}">{{communicationCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{isAcademic}}" bindtap="goCommunicationTemplates">
      <view class="work-icon">话</view>
      <view class="work-copy"><view class="work-title">家长话术模板</view><view class="work-detail">选择固定场景，填写变量并复制已审批内容</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goMonthlyScheduling">
      <view class="work-icon icon-orange">排</view>
      <view class="work-copy"><view class="work-title">下月排课跟进</view><view class="work-detail">收集家长时间、跟进未回复并标记匹配结果</view></view>
      <view class="work-badge alert" wx:if="{{hasMonthlySchedulingTasks}}">{{monthlySchedulingCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goRenewals">
      <view class="work-icon icon-orange">续</view>
      <view class="work-copy"><view class="work-title">续费跟进</view><view class="work-detail">{{renewalDetail}}</view></view>
      <view class="work-badge alert" wx:if="{{hasRenewalTasks}}">{{renewalCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canViewAssessments}}" bindtap="goAssessments">
      <view class="work-icon icon-orange">测</view>
      <view class="work-copy"><view class="work-title">入学准备度测评</view><view class="work-detail">{{assessmentDetail}}</view></view>
      <view class="work-badge alert" wx:if="{{assessmentActionCount}}">{{assessmentActionCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goSchedule">
      <view class="work-icon icon-orange">课</view>
      <view class="work-copy"><view class="work-title">课程工作台</view><view class="work-detail">月历、今日课程与待排课工单</view></view>
      <view class="work-badge">{{todaySessionCount}}</view><view class="work-arrow">›</view>
    </view>
    <block wx:if="{{showAllTools}}">
    <view class="work-row" wx:if="{{canManageCoordination}}" bindtap="goCoordination">
      <view class="work-icon">排</view>
      <view class="work-copy"><view class="work-title">排课与调课</view><view class="work-detail">{{coordinationCount}} 条开放 · {{coordinationOverdueCount}} 条逾期</view></view>
      <view class="work-badge alert" wx:if="{{hasCoordinationOverdue}}">{{coordinationOverdueCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goRequests">
      <view class="work-icon">家</view>
      <view class="work-copy"><view class="work-title">全部工单</view><view class="work-detail">包含家长请求和内部教务工单</view></view>
      <view class="work-badge" wx:if="{{hasPendingRequests}}">{{pendingCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canManageFirstScheduling}}" bindtap="goFirstScheduling">
      <view class="work-icon">生</view>
      <view class="work-copy"><view class="work-title">学生排课</view><view class="work-detail">全部学生可安排 · {{firstSchedulingAttentionCount}} 名需关注</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canViewReminderAttention}}" bindtap="goReminderAttention">
      <view class="work-icon">醒</view>
      <view class="work-copy"><view class="work-title">提醒异常</view><view class="work-detail">{{reminderAttentionCount}} 条消息需补授权</view></view>
      <view class="work-badge alert" wx:if="{{hasReminderAttention}}">{{reminderAttentionCount}}</view><view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canOpenApprovals}}" bindtap="goApprovals">
      <view class="work-icon">审</view>
      <view class="work-copy"><view class="work-title">管理审批中心</view><view class="work-detail">手机审批工资、报销和课包发票关口</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canOpenLeads}}" bindtap="goLeads">
      <view class="work-icon">客</view>
      <view class="work-copy"><view class="work-title">新咨询快速录入</view><view class="work-detail">从微信录入新家长，需要时转排课工单</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" wx:if="{{canOpenOperations}}" bindtap="goOperations">
      <view class="work-icon">录</view>
      <view class="work-copy"><view class="work-title">操作日志与纠正</view><view class="work-detail">追踪操作人、时间和结果，错误转纠正工单</view></view>
      <view class="work-arrow">›</view>
    </view>
    <view class="work-row" bindtap="goNewRequest">
      <view class="work-icon">录</view>
      <view class="work-copy"><view class="work-title">代录服务请求</view><view class="work-detail">把微信群消息整理成可追踪工单</view></view>
      <view class="work-arrow">›</view>
    </view>
    </block>
    <button class="tool-toggle" bindtap="toggleAllTools">{{showAllTools ? '收起其他工具' : '展开排课、审批与行政工具'}}</button>
  </view>

  <view class="account-actions">
    <button class="issue-action" bindtap="goIssueReport">遇到问题？一键上报</button>
    <button class="account-switch-action" bindtap="goAccountSwitch">
      <view><view class="account-switch-label">当前身份</view><view class="account-switch-name">{{roleText}}</view></view>
      <view class="account-switch-link">账号管理 ›</view>
    </button>
    <view class="work-row" wx:if="{{isTeacher && teacherConfirmationCount > 0}}" bindtap="goTeacherConfirmations">
      <view class="work-icon">课</view>
      <view class="work-copy"><view class="work-title">课程安排确认</view><view class="work-detail">确认已收到教务调整后的课程安排</view></view>
      <view class="work-badge alert">{{teacherConfirmationCount}}</view><view class="work-arrow">›</view>
    </view>
    <button class="btn secondary" bindtap="logout">退出员工登录</button>
    <button class="portal-foot-link" bindtap="goParentPortal">返回学校指南</button>
  </view>
</view>
