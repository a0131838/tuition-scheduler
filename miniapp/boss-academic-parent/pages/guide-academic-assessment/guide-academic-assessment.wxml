<view class="guide-page assessment-page">
  <block wx:if="{{phase === 'hub'}}">
    <view class="assessment-hero">
      <view class="guide-kicker">免费测评</view>
      <view class="assessment-title">了解孩子当前水平</view>
      <view class="assessment-lead">完成后查看能力结果和提升建议</view>
      <view class="guide-page-meta">请由孩子本人作答</view>
      <button class="assessment-primary" bindtap="openCodeSetup">开始测评</button>
    </view>
    <view class="assessment-choice-list">
      <view class="assessment-choice" wx:if="{{hasRequest}}" bindtap="openSavedRequest"><view><b>查看原有申请</b><text>{{request ? request.statusLabel : '继续查看之前提交的记录'}}</text></view><i>›</i></view>
      <view class="assessment-choice" wx:if="{{hasSession}}" bindtap="loadSession"><view><b>继续上次测评</b></view><i>›</i></view>
    </view>
    <view class="guide-section" wx:if="{{history.length}}">
      <view class="guide-section-title">历史测评</view>
      <view class="assessment-choice" wx:for="{{history}}" wx:key="token" data-token="{{item.token}}" bindtap="openHistory"><view><b>{{item.studentNickname}} · {{item.scoreLabel}}</b><text>{{item.completedAt}}</text></view><i>›</i></view>
    </view>
  </block>

  <block wx:if="{{phase === 'requestStatus' && request}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="request-status-head">
      <view class="assessment-section-title">{{request.statusLabel}}</view>
      <view class="request-progress"><view style="width: {{requestProgress}}%;"></view></view>
      <view class="assessment-form-note">{{request.nextAction}}</view>
    </view>
    <view class="request-facts" wx:if="{{!request.redacted}}">
      <view><text>学生</text><b>{{request.studentNickname}}</b></view>
      <view><text>年龄与年级</text><b>{{request.ageBand}} {{request.currentGrade}}</b></view>
      <view><text>目标方向</text><b>{{request.targetPath}}</b></view>
    </view>
    <view class="assessment-boundary"><b>后续联系</b><text>规划老师会通过微信联系您</text></view>
    <button class="assessment-primary" wx:if="{{request.canStart}}" loading="{{loading}}" bindtap="startFromRequest">评估已就绪，开始测评</button>
    <button class="assessment-secondary" wx:if="{{request.canRefresh}}" loading="{{loading}}" bindtap="openSavedRequest">刷新进度</button>
  </block>

  <block wx:if="{{phase === 'setup'}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="assessment-form-head"><view class="guide-kicker">开始前</view><view class="assessment-section-title">填写孩子信息</view><view class="assessment-form-note">用于保存本次进度</view></view>
    <view class="guide-field"><view class="guide-label">怎么称呼孩子 *</view><input class="guide-input" maxlength="60" placeholder="孩子昵称" value="{{studentNickname}}" bindinput="setNickname" /></view>
    <view class="assessment-form-grid">
      <view class="guide-field"><view class="guide-label">年龄段</view><picker range="{{ageOptions}}" value="{{ageIndex}}" bindchange="setAge"><view class="guide-picker">{{ageOptions[ageIndex]}}</view></picker></view>
      <view class="guide-field"><view class="guide-label">当前年级</view><input class="guide-input" maxlength="40" placeholder="如 P4 / Grade 4" value="{{currentGrade}}" bindinput="setGrade" /></view>
    </view>
    <view class="guide-field"><view class="guide-label">测评方向</view><picker range="{{pathLabels}}" value="{{pathIndex}}" bindchange="setPath"><view class="guide-picker">{{pathLabels[pathIndex]}}</view></picker></view>
    <view class="guide-field"><view class="guide-label">语言背景（可选）</view><input class="guide-input" maxlength="160" placeholder="如 中文为主，英文学习3年" value="{{languageBackground}}" bindinput="setLanguage" /></view>
    <checkbox-group class="guide-check" bindchange="toggleConsent"><checkbox value="yes" color="#ec5e0a"/><text>我同意保存本次测评记录</text></checkbox-group>
    <view class="guide-text-link" bindtap="openPrivacy">查看隐私说明</view>
    <button class="assessment-primary sticky-action" loading="{{loading}}" bindtap="start">下一步</button>
  </block>

  <block wx:if="{{phase === 'test'}}">
    <view class="assessment-test-head"><view><b>{{session.section.label || '能力测评'}}</b></view><view>{{session.progressPercent}}%</view></view>
    <view class="assessment-section-status" wx:if="{{session.section}}"><view><text>{{session.section.answered}} / {{session.section.total}}</text></view><view class="assessment-section-time">{{sectionTimerText}}</view></view>
    <view class="assessment-section-instructions" wx:if="{{session.section && session.section.instructions}}">{{session.section.instructions}}</view>
    <view class="assessment-progress"><view class="assessment-progress-track"><view class="assessment-progress-fill" style="width: {{session.progressPercent}}%;"></view></view><view class="assessment-progress-text">{{session.answeredCount}} / {{session.totalQuestions}}</view></view>
    <view class="assessment-card" wx:if="{{session.question}}"><view class="assessment-domain">第 {{session.currentIndex + 1}} 题</view><view class="assessment-stimulus" wx:if="{{session.question.stimulus}}">{{session.question.stimulus}}</view><view class="assessment-audio" wx:if="{{session.question.audioUrl}}"><view><b>听力</b><text>{{currentAudioPlayed ? '请根据听到的内容作答' : '准备好后开始播放'}}</text></view><button size="mini" disabled="{{audioPlaying || currentAudioPlayed}}" bindtap="playListeningAudio">{{audioPlaying ? '播放中…' : (currentAudioPlayed ? '已播放' : '播放')}}</button></view><view class="assessment-prompt">{{session.question.prompt}}</view><view wx:if="{{session.question.options.length}}"><view class="assessment-option {{answerInput === item.key ? 'active' : ''}}" wx:for="{{session.question.options}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseOption">{{item.key}}. {{item.text}}</view></view><textarea wx:else class="assessment-textarea" maxlength="8000" value="{{answerInput}}" bindinput="setAnswer" placeholder="请输入答案"/><view class="guide-section-note" wx:if="{{session.question.requiresReviewer}}">请用自己的话完整作答</view><button class="assessment-primary" loading="{{loading || sectionExpiring}}" bindtap="saveAnswer">下一题</button></view>
    <button wx:if="{{session.canSubmit}}" class="assessment-primary" loading="{{loading}}" bindtap="submitAssessment">全部完成，提交测评</button>
  </block>

  <block wx:if="{{phase === 'awaiting'}}"><view class="assessment-result"><view class="guide-kicker">已提交</view><view class="assessment-section-title">正在生成结果</view><view class="assessment-form-note">完成后会显示能力结果和提升建议</view><button class="assessment-primary" loading="{{loading}}" bindtap="refresh">刷新结果</button><button class="assessment-secondary" loading="{{loading}}" bindtap="startNewRound">开始新一轮</button><button class="assessment-text-button" bindtap="startForAnotherChild">为另一个孩子测评</button></view></block>

  <block wx:if="{{phase === 'report'}}">
    <view class="assessment-result action-report">
      <view class="guide-kicker">测评完成</view>
      <view class="assessment-section-title">{{session.report.productTitle || '入学准备度'}}</view>

      <view class="action-report-section">
        <view class="action-report-number">01</view><view class="action-report-heading">测评结果</view>
        <view wx:if="{{scorecards.length}}"><view class="assessment-scorecard" wx:for="{{scorecards}}" wx:key="key"><view class="guide-kicker">{{item.label}}</view><view class="assessment-report-score">{{item.scoreLabel}}</view><view class="assessment-form-note">{{item.band}}</view><view class="assessment-cefr" wx:if="{{item.cefrReference}}">能力阶段：{{item.cefrReference}}</view></view></view>
        <view class="assessment-scorecard" wx:else><view class="assessment-report-score">{{session.overallScore}} / 100</view><view class="assessment-form-note">{{session.overallBand}}</view></view>
      </view>

      <view class="action-report-section">
        <view class="action-report-number">02</view><view class="action-report-heading">接下来怎么提高</view>
        <view class="improvement-plan">
          <view class="improvement-step" wx:for="{{improvementPlan}}" wx:key="stage"><view class="improvement-stage">{{item.stage}}</view><view><b>{{item.title}}</b><text>{{item.detail}}</text></view></view>
        </view>
      </view>

      <view class="action-report-section contact-plan">
        <view class="action-report-number">03</view><view class="action-report-heading">制定个人学习方案</view>
        <view class="assessment-form-note">获得适合孩子的学习重点和安排</view>
        <button class="assessment-primary" bindtap="goConsult">联系规划老师</button>
      </view>

      <button class="assessment-secondary compact-action" bindtap="toggleReportDetails">{{detailsExpanded ? '收起详细分析' : '查看详细分析'}}</button>
      <view wx:if="{{detailsExpanded}}" class="report-details">
        <view class="assessment-boundary" wx:if="{{session.evidenceText}}"><b>本次作答</b><text>{{session.evidenceText}}</text></view>
        <view class="report-section" wx:if="{{moduleRows.length}}"><b>分项结果</b><view class="assessment-module-grid"><view class="assessment-module" wx:for="{{moduleRows}}" wx:key="name"><text>{{item.name}}</text><b>{{item.score}}</b></view></view></view>
        <view class="report-section" wx:if="{{skillRows.length}}"><b>能力表现</b><view class="assessment-report-row" wx:for="{{skillRows}}" wx:key="name">{{item.name}}：{{item.score}} / 100</view><view class="assessment-form-note" wx:if="{{unmeasuredText}}">本次未测：{{unmeasuredText}}</view></view>
        <view class="report-section" wx:if="{{comparisonRows.length}}"><b>与上一次相比</b><view class="assessment-report-row" wx:for="{{comparisonRows}}" wx:key="name">{{item.name}}：{{item.label}}</view></view>
        <view class="report-section"><b>结果说明</b><text>{{session.report.nextStep}}</text></view>
      </view>

      <view class="report-secondary-actions">
        <button class="assessment-text-button" loading="{{loading}}" bindtap="startNewRound">再测一次</button>
        <button class="assessment-text-button" bindtap="resetForNewProduct">改测其他方向</button>
        <button class="assessment-text-button" bindtap="startForAnotherChild">为另一个孩子测评</button>
      </view>
    </view>
  </block>
</view>
