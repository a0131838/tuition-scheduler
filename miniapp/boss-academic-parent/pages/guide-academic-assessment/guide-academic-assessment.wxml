<view class="guide-page assessment-page">
  <block wx:if="{{phase === 'hub'}}">
    <view class="assessment-hero">
      <view class="guide-kicker">入学准备度测评</view>
      <view class="assessment-title">三套测评独立进行<br/>结果更容易解释</view>
      <view class="assessment-lead">国际学校英语约75分钟（语法、听力、阅读、写作；暂不含口语）· AEIS分科测评 · A/B/C平行卷</view>
      <view class="guide-page-meta">无需登录或评估码，学生可直接开始；请独立完成。</view>
      <button class="assessment-primary" bindtap="openCodeSetup">立即免费测评</button>
    </view>
    <view class="assessment-choice-list">
      <view class="assessment-choice" wx:if="{{hasRequest}}" bindtap="openSavedRequest"><view><b>查看原有申请</b><text>{{request ? request.statusLabel : '继续查看之前提交的记录'}}</text></view><i>›</i></view>
      <view class="assessment-choice" wx:if="{{hasSession}}" bindtap="loadSession"><view><b>继续测评或查看报告</b><text>使用本机已保存的测评记录</text></view><i>›</i></view>
    </view>
    <view class="guide-section" wx:if="{{history.length}}">
      <view class="guide-section-title">历史测评</view>
      <view class="assessment-choice" wx:for="{{history}}" wx:key="token" data-token="{{item.token}}" bindtap="openHistory"><view><b>{{item.studentNickname}} · {{item.scoreLabel}}</b><text>{{item.completedAt}}提交 · 本轮记录独立保留</text></view><i>›</i></view>
    </view>
    <view class="guide-page-meta">请让学生独立完成。结果不是官方成绩或录取结果。</view>
  </block>

  <block wx:if="{{phase === 'requestStatus' && request}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="request-status-head">
      <view class="guide-kicker">{{request.requestNo}}</view>
      <view class="assessment-section-title">{{request.statusLabel}}</view>
      <view class="request-progress"><view style="width: {{requestProgress}}%;"></view></view>
      <view class="assessment-form-note">{{request.nextAction}}</view>
    </view>
    <view class="request-facts" wx:if="{{!request.redacted}}">
      <view><text>学生</text><b>{{request.studentNickname}}</b></view>
      <view><text>年龄与年级</text><b>{{request.ageBand}} {{request.currentGrade}}</b></view>
      <view><text>目标方向</text><b>{{request.targetPath}}</b></view>
      <view><text>希望测试日期</text><b>{{request.preferredTestDate || '未指定'}}</b></view>
    </view>
    <view class="assessment-boundary"><b>联系方式</b><text>入学顾问会通过申请时填写的微信号联系您</text></view>
    <button class="assessment-primary" wx:if="{{request.canStart}}" loading="{{loading}}" bindtap="startFromRequest">评估已就绪，开始测评</button>
    <button class="assessment-secondary" wx:if="{{request.canRefresh}}" loading="{{loading}}" bindtap="openSavedRequest">刷新进度</button>
    <button class="assessment-text-button" wx:if="{{request.requestNo}}" bindtap="copyRequestNo">复制申请编号</button>
  </block>

  <block wx:if="{{phase === 'setup'}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="assessment-form-head"><view class="guide-kicker">免费测评</view><view class="assessment-section-title">填写基本情况</view><view class="assessment-form-note">请让学生独立完成 · 系统自动保存</view></view>
    <view class="guide-field"><view class="guide-label">学生昵称 *</view><input class="guide-input" maxlength="60" placeholder="用于保存进度，不必填写证件姓名" value="{{studentNickname}}" bindinput="setNickname" /></view>
    <view class="assessment-form-grid">
      <view class="guide-field"><view class="guide-label">年龄段</view><picker range="{{ageOptions}}" value="{{ageIndex}}" bindchange="setAge"><view class="guide-picker">{{ageOptions[ageIndex]}}</view></picker></view>
      <view class="guide-field"><view class="guide-label">当前年级</view><input class="guide-input" maxlength="40" placeholder="如 P4 / Grade 4" value="{{currentGrade}}" bindinput="setGrade" /></view>
    </view>
    <view class="guide-field"><view class="guide-label">选择测评（三者独立）</view><picker range="{{pathLabels}}" value="{{pathIndex}}" bindchange="setPath"><view class="guide-picker">{{pathLabels[pathIndex]}}</view></picker><view class="assessment-form-note">国际学校英语为博思原创 iTEP 结构对齐版：25题语法、14题听力、10题阅读、2题写作，暂不含口语；并非官方 iTEP 考试。AEIS按英语与数学分科报告，不混入科学、不合并总分。</view></view>
    <view class="guide-field"><view class="guide-label">语言背景（可选）</view><input class="guide-input" maxlength="160" placeholder="如 中文为主，英文学习3年" value="{{languageBackground}}" bindinput="setLanguage" /></view>
    <checkbox-group class="guide-check" bindchange="toggleConsent"><checkbox value="yes" color="#ec5e0a"/><text>我是家长或监护人，并同意保存本次作答、用时、老师评分和必要操作日志，用于测评、人工复核和后续教育咨询。</text></checkbox-group>
    <view class="guide-text-link" bindtap="openPrivacy">查看隐私说明</view>
    <button class="assessment-primary sticky-action" loading="{{loading}}" bindtap="start">开始分项测评</button>
  </block>

  <block wx:if="{{phase === 'test'}}">
    <view class="assessment-test-head"><view><b>{{session.studentCode}}</b><text>{{session.ageBand}} · {{session.formVariant}}卷</text></view><view>{{session.progressPercent}}%</view></view>
    <view class="assessment-section-status" wx:if="{{session.section}}"><view><b>{{session.section.label}}</b><text>本部分 {{session.section.answered}} / {{session.section.total}} · 第{{session.section.part}}部分</text></view><view class="assessment-section-time">{{sectionTimerText}}</view></view>
    <view class="assessment-section-instructions" wx:if="{{session.section && session.section.instructions}}">{{session.section.instructions}}</view>
    <view class="assessment-progress"><view class="assessment-progress-track"><view class="assessment-progress-fill" style="width: {{session.progressPercent}}%;"></view></view><view class="assessment-progress-text">已完成 {{session.answeredCount}} / {{session.totalQuestions}} · 自动保存</view></view>
    <view class="assessment-card" wx:if="{{session.question}}"><view class="assessment-domain">第 {{session.currentIndex + 1}} 题 · {{session.question.sectionLabel || session.question.domain}}</view><view class="assessment-stimulus" wx:if="{{session.question.stimulus}}">{{session.question.stimulus}}</view><view class="assessment-audio" wx:if="{{session.question.audioUrl}}"><view><b>听力材料 · AI合成原创音频</b><text>{{currentAudioPlayed ? '本段已播放，请根据听到的内容作答' : '每段音频仅播放一次，请准备好后开始'}}</text></view><button size="mini" disabled="{{audioPlaying || currentAudioPlayed}}" bindtap="playListeningAudio">{{audioPlaying ? '播放中…' : (currentAudioPlayed ? '已播放' : '播放听力')}}</button></view><view class="assessment-prompt">{{session.question.prompt}}</view><view wx:if="{{session.question.options.length}}"><view class="assessment-option {{answerInput === item.key ? 'active' : ''}}" wx:for="{{session.question.options}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseOption">{{item.key}}. {{item.text}}</view></view><textarea wx:else class="assessment-textarea" maxlength="8000" value="{{answerInput}}" bindinput="setAnswer" placeholder="{{session.question.requiresReviewer ? '保留学生原话、作答过程或完整答案，不要代答' : '请输入答案'}}"/><view class="guide-section-note" wx:if="{{session.question.requiresReviewer}}">本题由AI双重评分；出现分歧或服务暂不可用时自动转老师复核。请保留学生原始表达。</view><button class="assessment-primary" loading="{{loading || sectionExpiring}}" bindtap="saveAnswer">保存并进入下一题</button></view>
    <button wx:if="{{session.canSubmit}}" class="assessment-primary" loading="{{loading}}" bindtap="submitAssessment">全部完成，提交测评</button>
  </block>

  <block wx:if="{{phase === 'awaiting'}}"><view class="assessment-result"><view class="guide-kicker">已提交 · {{session.formVariant}}卷</view><view class="assessment-section-title">结果正在复核</view><view class="assessment-form-note">作答已保存。需要老师确认的内容完成后，这里会直接显示结果和提升计划。</view><button class="assessment-primary" loading="{{loading}}" bindtap="refresh">刷新评分状态</button><button class="assessment-secondary" loading="{{loading}}" bindtap="startNewRound">再测一套平行卷</button><button class="assessment-text-button" bindtap="startForAnotherChild">为另一个孩子测评</button></view></block>

  <block wx:if="{{phase === 'report'}}">
    <view class="assessment-result action-report">
      <view class="guide-kicker">测评已完成 · {{session.formVariant}}卷</view>
      <view class="assessment-section-title">{{session.report.productTitle || '入学准备度'}}</view>

      <view class="action-report-section">
        <view class="action-report-number">01</view><view class="action-report-heading">测评结果</view>
        <view wx:if="{{scorecards.length}}"><view class="assessment-scorecard" wx:for="{{scorecards}}" wx:key="key"><view class="guide-kicker">{{item.label}}</view><view class="assessment-report-score">{{item.scoreLabel}}</view><view class="assessment-form-note">{{item.band}}</view><view class="assessment-cefr" wx:if="{{item.cefrReference}}">CEFR初步参考：{{item.cefrReference}}</view></view></view>
        <view class="assessment-scorecard" wx:else><view class="assessment-report-score">{{session.overallScore}} / 100</view><view class="assessment-form-note">{{session.overallBand}}</view></view>
      </view>

      <view class="action-report-section">
        <view class="action-report-number">02</view><view class="action-report-heading">接下来怎么提高</view>
        <view class="improvement-plan">
          <view class="improvement-step" wx:for="{{improvementPlan}}" wx:key="stage"><view class="improvement-stage">{{item.stage}}</view><view><b>{{item.title}}</b><text>{{item.detail}}</text></view></view>
        </view>
      </view>

      <view class="action-report-section contact-plan">
        <view class="action-report-number">03</view><view class="action-report-heading">制定个人学习方案</view>
        <view class="assessment-form-note">规划老师会结合孩子当前学校、目标学校、时间线和本次结果，给出具体课程与复测安排。</view>
        <button class="assessment-primary" bindtap="goConsult">联系规划老师制定学习方案</button>
      </view>

      <button class="assessment-secondary compact-action" bindtap="toggleReportDetails">{{detailsExpanded ? '收起详细分析' : '查看详细分析'}}</button>
      <view wx:if="{{detailsExpanded}}" class="report-details">
        <view class="assessment-form-note">{{session.report.standard}}</view>
        <view class="assessment-boundary" wx:if="{{session.evidenceText}}"><b>本轮证据</b><text>{{session.evidenceText}}</text></view>
        <view class="report-section" wx:if="{{moduleRows.length}}"><b>分项结果</b><view class="assessment-module-grid"><view class="assessment-module" wx:for="{{moduleRows}}" wx:key="name"><text>{{item.name}}</text><b>{{item.score}}</b></view></view></view>
        <view class="report-section" wx:if="{{skillRows.length}}"><b>能力证据</b><view class="assessment-report-row" wx:for="{{skillRows}}" wx:key="name">{{item.name}}：{{item.score}} / 100</view><view class="assessment-form-note" wx:if="{{unmeasuredText}}">本轮未测：{{unmeasuredText}}</view></view>
        <view class="report-section" wx:if="{{comparisonRows.length}}"><b>与上一次相比</b><view class="assessment-report-row" wx:for="{{comparisonRows}}" wx:key="name">{{item.name}}：{{item.label}}</view></view>
        <view class="report-section"><b>结果说明</b><text>{{session.report.nextStep}}</text></view>
      </view>

      <view class="report-secondary-actions">
        <button class="assessment-text-button" loading="{{loading}}" bindtap="startNewRound">再测一套平行卷</button>
        <button class="assessment-text-button" bindtap="resetForNewProduct">改测其他方向</button>
        <button class="assessment-text-button" bindtap="startForAnotherChild">为另一个孩子测评</button>
      </view>
    </view>
  </block>
</view>
