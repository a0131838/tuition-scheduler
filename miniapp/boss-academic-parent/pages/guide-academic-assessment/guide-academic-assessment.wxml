<view class="guide-page assessment-page">
  <block wx:if="{{phase === 'hub'}}">
    <view class="assessment-hero">
      <view class="guide-kicker">英文水平测评</view>
      <view class="assessment-title">测出孩子目前的<br/>英文水平</view>
      <view class="assessment-lead">30–45分钟 · 无需登录或评估码</view>
      <button class="assessment-primary" bindtap="openCodeSetup">立即免费测评</button>
    </view>
    <view class="assessment-choice-list">
      <view class="assessment-choice" wx:if="{{hasRequest}}" bindtap="openSavedRequest"><view><b>查看原有申请</b><text>{{request ? request.statusLabel : '继续查看之前提交的记录'}}</text></view><i>›</i></view>
      <view class="assessment-choice" wx:if="{{hasSession}}" bindtap="loadSession"><view><b>继续测评或查看报告</b><text>使用本机已保存的测评记录</text></view><i>›</i></view>
    </view>
    <view class="guide-section" wx:if="{{history.length}}">
      <view class="guide-section-title">历史测评</view>
      <view class="assessment-choice" wx:for="{{history}}" wx:key="token" data-token="{{item.token}}" bindtap="openHistory"><view><b>{{item.studentNickname}} · {{item.score}}分</b><text>{{item.completedAt}}完成 · 建议{{item.retestDateText}}后复测</text></view><i>›</i></view>
    </view>
    <view class="guide-page-meta">请让学生独立完成。结果不是官方成绩或录取结果。</view>
  </block>

  <block wx:if="{{phase === 'requestStatus' && request}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="request-status-head">
      <view class="guide-kicker">{{request.requestNo}}</view>
      <view class="assessment-section-title">{{request.statusLabel}}</view>
      <view class="request-progress"><view style="width: {{requestProgress}}%;"></view></view>
      <view class="assessment-form-note">{{request.nextAction}}</view>
    </view>
    <view class="request-facts" wx:if="{{!request.redacted}}">
      <view><text>学生</text><b>{{request.studentNickname}}</b></view>
      <view><text>年龄与年级</text><b>{{request.ageBand}} {{request.currentGrade}}</b></view>
      <view><text>目标方向</text><b>{{request.targetPath}}</b></view>
      <view><text>希望测试日期</text><b>{{request.preferredTestDate || '未指定'}}</b></view>
    </view>
    <view class="assessment-boundary"><b>联系方式</b><text>入学顾问会通过申请时填写的微信号联系您</text></view>
    <button class="assessment-primary" wx:if="{{request.canStart}}" loading="{{loading}}" bindtap="startFromRequest">评估已就绪，开始测评</button>
    <button class="assessment-secondary" wx:if="{{request.canRefresh}}" loading="{{loading}}" bindtap="openSavedRequest">刷新进度</button>
    <button class="assessment-text-button" wx:if="{{request.requestNo}}" bindtap="copyRequestNo">复制申请编号</button>
  </block>

  <block wx:if="{{phase === 'setup'}}">
    <view class="assessment-nav" bindtap="backToHub">‹ 返回测评首页</view>
    <view class="assessment-form-head"><view class="guide-kicker">免费测评</view><view class="assessment-section-title">填写基本情况</view><view class="assessment-form-note">请让学生独立完成 · 系统自动保存</view></view>
    <view class="guide-field"><view class="guide-label">学生昵称 *</view><input class="guide-input" maxlength="60" placeholder="用于保存进度，不必填写证件姓名" value="{{studentNickname}}" bindinput="setNickname" /></view>
    <view class="assessment-form-grid">
      <view class="guide-field"><view class="guide-label">年龄段</view><picker range="{{ageOptions}}" value="{{ageIndex}}" bindchange="setAge"><view class="guide-picker">{{ageOptions[ageIndex]}}</view></picker></view>
      <view class="guide-field"><view class="guide-label">当前年级</view><input class="guide-input" maxlength="40" placeholder="如 P4 / Grade 4" value="{{currentGrade}}" bindinput="setGrade" /></view>
    </view>
    <view class="guide-field"><view class="guide-label">目标路径</view><picker range="{{pathLabels}}" value="{{pathIndex}}" bindchange="setPath"><view class="guide-picker">{{pathLabels[pathIndex]}}</view></picker></view>
    <view class="guide-field"><view class="guide-label">语言背景（可选）</view><input class="guide-input" maxlength="160" placeholder="如 中文为主，英文学习3年" value="{{languageBackground}}" bindinput="setLanguage" /></view>
    <checkbox-group class="guide-check" bindchange="toggleConsent"><checkbox value="yes" color="#ec5e0a"/><text>我是家长或监护人，并同意保存本次作答、用时、老师评分和必要操作日志，用于测评、人工复核和后续教育咨询。</text></checkbox-group>
    <view class="guide-text-link" bindtap="openPrivacy">查看隐私说明</view>
    <button class="assessment-primary sticky-action" loading="{{loading}}" bindtap="start">开始30–45分钟测评</button>
  </block>

  <block wx:if="{{phase === 'test'}}">
    <view class="assessment-test-head"><view><b>{{session.studentCode}}</b><text>{{session.ageBand}} · {{session.formVariant}}卷</text></view><view>{{session.progressPercent}}%</view></view>
    <view class="assessment-progress"><view class="assessment-progress-track"><view class="assessment-progress-fill" style="width: {{session.progressPercent}}%;"></view></view><view class="assessment-progress-text">已完成 {{session.answeredCount}} / {{session.totalQuestions}} · 自动保存</view></view>
    <view class="assessment-card" wx:if="{{session.question}}"><view class="assessment-domain">第 {{session.currentIndex + 1}} 题 · {{session.question.domain}}</view><view class="assessment-prompt">{{session.question.prompt}}</view><view wx:if="{{session.question.options.length}}"><view class="assessment-option {{answerInput === item.key ? 'active' : ''}}" wx:for="{{session.question.options}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseOption">{{item.key}}. {{item.text}}</view></view><textarea wx:else class="assessment-textarea" maxlength="8000" value="{{answerInput}}" bindinput="setAnswer" placeholder="{{session.question.requiresReviewer ? '保留学生原话、作答过程或完整答案，不要代答' : '请输入答案'}}"/><view class="guide-section-note" wx:if="{{session.question.requiresReviewer}}">本题由老师按量表复核，请保留学生原始表达。</view><button class="assessment-primary" loading="{{loading}}" bindtap="saveAnswer">保存并进入下一题</button></view>
    <button wx:if="{{session.canSubmit}}" class="assessment-primary" loading="{{loading}}" bindtap="submitAssessment">全部完成，提交测评</button>
  </block>

  <block wx:if="{{phase === 'awaiting'}}"><view class="assessment-result"><view class="guide-kicker">已提交</view><view class="assessment-section-title">等待老师复核</view><view class="assessment-form-note">选择题已经保存；写作、口语或观察任务评分完成后，本页会显示完整测评报告。</view><button class="assessment-primary" loading="{{loading}}" bindtap="refresh">刷新评分状态</button></view></block>

  <block wx:if="{{phase === 'report'}}"><view class="assessment-result"><view class="guide-kicker">免费系统报告</view><view class="assessment-report-score">{{session.overallScore}}</view><view class="assessment-section-title">{{session.overallBand}} · 可信度{{session.confidence}}</view><view class="assessment-form-note">{{session.report.standard}}</view><view class="report-section"><b>能力域</b><view class="assessment-report-row" wx:for="{{domainRows}}" wx:key="name">{{item.name}}：{{item.score}}</view></view><view class="report-section"><b>本次相对优势</b><text wx:for="{{session.report.strengths}}" wx:key="*this">• {{item}}</text></view><view class="report-section"><b>优先补强</b><text wx:for="{{session.report.priorities}}" wx:key="*this">• {{item}}</text><view class="assessment-boundary">{{session.report.nextStep}}</view></view><view class="assessment-boundary"><b>可以再次测评</b><text>本次报告会保留。建议在{{session.retestDateText}}后复测，提前复测也不会被锁定，系统会优先更换平行卷。</text></view><button class="assessment-secondary" bindtap="startNewRound">开始新一轮测评</button><button class="assessment-text-button" bindtap="startForAnotherChild">为另一个孩子测评</button><view class="assessment-boundary"><b>需要更具体的下一步？</b><text>顾问可结合当前学校、目标学校和时间线，提供专业解读、精准选校及备考方案。是否联系完全由您决定。</text></view><button class="assessment-primary" bindtap="goConsult">联系顾问获取专业分析</button></view></block>
</view>
