<view class="page">
  <view class="top">
    <view class="eyebrow">{{studentName}}</view>
    <view class="title">课包与财务</view>
    <view class="subtitle">{{note}}</view>
  </view>

  <view class="grid-2">
    <view class="metric">
      <view class="label">剩余课时</view>
      <view class="value">{{summary.totalRemainingHours || 0}} h</view>
    </view>
    <view class="metric">
      <view class="label">待付金额</view>
      <view class="value">SGD {{summary.unpaidAmount || 0}}</view>
    </view>
  </view>

  <block wx:if="{{packages.length}}">
    <view wx:for="{{packages}}" wx:key="package.id" class="card">
      <view class="row">
        <view>
          <view class="value">{{item.package.courseName}}</view>
          <view class="label">{{item.package.status}} · {{item.package.validFrom}} - {{item.package.validTo || "长期"}}</view>
        </view>
        <view class="pill">{{item.package.remainingHours || 0}} h</view>
      </view>

      <view class="grid-2">
        <view class="metric">
          <view class="label">已付</view>
          <view class="value">SGD {{item.summary.paidAmount || 0}}</view>
        </view>
        <view class="metric">
          <view class="label">待付</view>
          <view class="value">SGD {{item.summary.unpaidAmount || 0}}</view>
        </view>
      </view>

      <view class="field" wx:if="{{item.invoices.length}}">
        <view class="label">发票</view>
        <view wx:for="{{item.invoices}}" wx:key="id" wx:for-item="invoice" class="row doc-row">
          <view>
            <view class="value">{{invoice.invoiceNo}}</view>
            <view class="label">{{invoice.issueDate}} · SGD {{invoice.totalAmount}}</view>
          </view>
          <button class="btn secondary small" bindtap="openInvoice" data-url="{{invoice.downloadUrl}}">打开</button>
        </view>
      </view>

      <view class="field" wx:if="{{item.receipts.length}}">
        <view class="label">收据</view>
        <view wx:for="{{item.receipts}}" wx:key="id" wx:for-item="receipt" class="row doc-row">
          <view>
            <view class="value">{{receipt.receiptNo}}</view>
            <view class="label">{{receipt.receiptDate}} · SGD {{receipt.amountReceived}}</view>
          </view>
          <button class="btn secondary small" bindtap="openReceipt" data-url="{{receipt.downloadUrl}}">打开</button>
        </view>
      </view>

      <view class="field" wx:if="{{item.paymentRecords.length}}">
        <view class="label">付款记录</view>
        <view wx:for="{{item.paymentRecords}}" wx:key="id" wx:for-item="payment" class="label payment-row">
          {{payment.paymentDate || payment.uploadedAt}} · SGD {{payment.paymentAmount || 0}} · {{payment.paymentMethod || "方式未填"}}
        </view>
      </view>
    </view>
  </block>
  <view wx:else class="empty">暂无财务记录</view>

  <button class="btn secondary" bindtap="contactFinance">联系财务</button>
</view>
