<view class="guide-page assessment-hub">
  <view class="guide-hero hub-hero">
    <view class="guide-kicker">测评</view>
    <view class="guide-title">选校或测学习水平</view>
  </view>

  <view class="hub-options">
    <view class="hub-option" hover-class="guide-press" bindtap="goSelection">
      <view class="hub-main"><view class="hub-title">智能选校</view><view class="hub-meta">约2分钟</view><view class="hub-note">根据年龄、预算和课程生成候选学校</view></view><view class="guide-arrow">›</view>
    </view>
    <view class="hub-option" hover-class="guide-press" bindtap="goReadiness">
      <view class="hub-main"><view class="hub-title">英文水平测评</view><view class="hub-meta">约30–45分钟</view><view class="hub-note">完成测评后查看系统报告</view><view class="hub-state" wx:if="{{hasRequest || hasSession}}">{{hasSession ? '继续测评或查看报告' : '查看原有申请'}}</view></view><view class="guide-arrow">›</view>
    </view>
  </view>

  <view class="guide-page-meta">测评结果用于学习准备参考，不是官方成绩或录取结果。</view>
</view>
<guide-nav active="assessment" />
