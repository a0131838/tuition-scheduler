@import "../../styles/school-guide.wxss";
.hub-hero{animation:hubEnter 340ms ease-out both}.hub-options{border-top:4rpx solid #18202a;animation:hubEnter 420ms 70ms ease-out both}.hub-option{display:grid;grid-template-columns:1fr 28rpx;gap:18rpx;align-items:center;padding:38rpx 0;border-bottom:1rpx solid #d7d9da;transition:background 120ms ease,transform 120ms ease}.hub-main{min-width:0}.hub-title{color:#18202a;font-size:36rpx;font-weight:880;line-height:1.25}.hub-meta{margin-top:10rpx;color:#a83c05;font-size:25rpx;font-weight:800}.hub-note{margin-top:12rpx;color:#66717b;font-size:26rpx;line-height:1.55}.hub-state{margin-top:18rpx;color:#287a62;font-size:24rpx;font-weight:850}.guide-press{background:#fff7f0;transform:translateY(2rpx)}@keyframes hubEnter{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
