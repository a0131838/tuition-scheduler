.page {
  padding: 28rpx;
  min-height: 100vh;
  background: #f5f6f7;
}

.top {
  margin-bottom: 22rpx;
}

.eyebrow,
.hint,
.subtitle {
  color: #6b7280;
  font-size: 24rpx;
}

.title {
  color: #202124;
  font-size: 36rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.status-band {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-top: 1rpx solid #e3e5e8;
  border-bottom: 1rpx solid #e3e5e8;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.overdue {
  color: #b42318;
  font-weight: 800;
}

.upcoming {
  margin-bottom: 22rpx;
}

.section-title {
  color: #ec5e0a;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.session-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e3e5e8;
  padding: 18rpx 0;
}

.session-course {
  color: #374151;
  margin: 6rpx 0;
  overflow-wrap: anywhere;
}

.session-status {
  color: #ec5e0a;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
  max-width: 180rpx;
}

.session-status.excused {
  color: #b42318;
}

.schedule-tool {
  border-top: 1rpx solid #e3e5e8;
  border-bottom: 1rpx solid #e3e5e8;
  padding: 22rpx 0;
  margin-bottom: 22rpx;
}

.tool-hint {
  line-height: 1.55;
  margin-bottom: 18rpx;
}

.schedule-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  column-gap: 16rpx;
}

.schedule-grid .wide {
  grid-column: 1 / -1;
}

.muted,
.empty-options {
  color: #7b7f86;
}

.empty-options {
  padding: 20rpx 0;
  line-height: 1.55;
}

.schedule-preview {
  border-left: 6rpx solid #2f6b4f;
  background: #fff0e7;
  color: #202124;
  line-height: 1.65;
  margin-top: 18rpx;
  padding: 18rpx;
}

.preview-title {
  color: #ec5e0a;
  font-weight: 800;
}

.danger-action {
  background: #a53025;
  border-radius: 8rpx;
  color: #fff;
  font-weight: 800;
  margin-top: 16rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e3e5e8;
  border-radius: 8rpx;
  padding: 24rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  color: #202124;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.picker,
textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #d9dce0;
  border-radius: 8rpx;
  background: #fafafa;
  padding: 18rpx;
}

textarea {
  min-height: 150rpx;
}

.primary,
.secondary {
  border-radius: 8rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.primary {
  background: #ec5e0a;
  color: #fff;
}

.secondary {
  background: #f0f1f3;
  color: #ec5e0a;
}

.history {
  border-top: 1rpx solid #e3e5e8;
  margin-top: 24rpx;
  padding-top: 22rpx;
}

.history-text {
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.action-worklist { margin: 20rpx 0; padding: 24rpx 0; border-top: 4rpx solid #202328; border-bottom: 1rpx solid #d8d5d0; }.action-row { padding: 20rpx 0; border-top: 1rpx solid #dedbd6; }.action-row-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }.action-seq { color: #9b3e08; font-size: 19rpx; font-weight: 800; }.action-state { padding: 6rpx 12rpx; border-radius: 999rpx; background: #fff0e7; color: #9b3e08; font-size: 20rpx; font-weight: 800; }.state-APPLIED { background: #e6f5ea; color: #28663d; }.state-CONFLICT { background: #fae8e6; color: #9b342d; }.linked-session,.action-source-picker { margin-top: 14rpx; padding: 16rpx; border-left: 5rpx solid #ec5e0a; background: #fff8f3; font-size: 24rpx; font-weight: 750; }.action-source-picker { color: #9b3e08; }.result-session { margin-top: 12rpx; color: #28663d; font-size: 22rpx; font-weight: 750; }
.result-evidence { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #d1d5db; }
.result-choice { display: flex; align-items: flex-start; gap: 12rpx; padding: 14rpx 0; font-size: 25rpx; }
.result-choice text { min-width: 0; flex: 1; word-break: break-all; }
.result-pages { display: flex; gap: 16rpx; margin: 12rpx 0; }
.result-evidence textarea { width: 100%; box-sizing: border-box; }
