<view class="guide-page">
  <view class="guide-hero">
    <view class="guide-kicker">智能选校</view>
    <view class="guide-title">生成你的候选学校</view>
    <view class="guide-subtitle">填写基本条件，查看匹配学校。</view>
  </view>

  <view class="guide-notice">
    本页用于快速生成候选学校，不测试学术能力。已有顾问或教务发放的评估码，可进入30–45分钟入学准备度测评。
    <button class="guide-action secondary" style="margin-top: 18rpx;" bindtap="goAcademicAssessment">进入入学准备度测评</button>
  </view>

  <view class="guide-field">
    <view class="guide-label">孩子出生日期</view>
    <picker mode="date" value="{{birthDate}}" bindchange="setBirthDate">
      <view class="guide-picker">{{birthDate || "请选择出生日期"}}</view>
    </picker>
  </view>
  <view class="guide-field"><view class="guide-label">每年预算上限</view><picker range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="setBudget"><view class="guide-picker">{{budgetOptions[budgetIndex]}}</view></picker></view>
  <view class="guide-field"><view class="guide-label">课程偏好</view><picker range="{{curriculumOptions}}" value="{{curriculumIndex}}" bindchange="setCurriculum"><view class="guide-picker">{{curriculumOptions[curriculumIndex]}}</view></picker></view>
  <view class="guide-switch-row"><text>孩子需要英语支持</text><switch color="#ec5e0a" checked="{{englishSupportNeeded}}" bindchange="setEnglishSupport" /></view>
  <view class="guide-switch-row"><text>家庭必须考虑寄宿</text><switch color="#ec5e0a" checked="{{boardingNeeded}}" bindchange="setBoarding" /></view>
  <view class="guide-field">
    <view class="guide-label">目标入学年份</view>
    <input class="guide-input" type="number" value="{{targetEntryYear}}" bindinput="setYear" />
  </view>
  <view class="guide-field">
    <view class="guide-label">孩子身份</view>
    <picker range="{{residencyOptions}}" value="{{residencyIndex}}" bindchange="setResidency">
      <view class="guide-picker">{{residencyOptions[residencyIndex]}}</view>
    </picker>
  </view>
  <view class="guide-field">
    <view class="guide-label">偏好的学校体系</view>
    <picker range="{{systemOptions}}" value="{{systemIndex}}" bindchange="setSystem">
      <view class="guide-picker">{{systemOptions[systemIndex]}}</view>
    </picker>
  </view>
  <button class="guide-action" style="margin-top: 30rpx;" loading="{{loading}}" bindtap="submit">查看结果</button>

  <view class="guide-result" wx:if="{{result}}">
    <view class="guide-result-block">
      <view class="guide-kicker">年龄参考</view>
      <view class="guide-result-title">入学年份1月1日：{{result.ageOnEntryYearStart}}岁</view>
      <view class="guide-result-note">年龄仅供初步筛选。</view>
    </view>
    <view class="guide-result-block"><view class="guide-kicker">候选学校</view><view class="guide-result-title">建议先比较这6所</view></view>
    <view class="guide-match-card" wx:for="{{result.schoolMatches}}" wx:key="slug">
      <view class="guide-match-band">{{item.band}}</view>
      <view class="guide-result-title">{{item.name}}</view>
      <view class="guide-match-reason" wx:for="{{item.reasons}}" wx:for-item="reason" wx:key="*this">✓ {{reason}}</view>
      <view class="guide-match-caution" wx:for="{{item.cautions}}" wx:for-item="caution" wx:key="*this">! {{caution}}</view>
      <view class="guide-action-row"><button class="guide-action secondary" data-slug="{{item.slug}}" bindtap="openSchool">查看学校</button><button class="guide-action" data-slug="{{item.slug}}" bindtap="addToPlan">加入方案</button></view>
    </view>
    <view class="guide-result-block" wx:for="{{result.matchedPathways}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openPathway">
      <view class="guide-result-title">{{item.title}}</view>
      <view class="guide-result-note">{{item.summary}}</view>
      <view class="guide-source-tag">查看路径</view>
    </view>
    <view class="guide-result-block">
      <view class="guide-result-title">提醒</view>
      <view class="guide-result-note" wx:for="{{result.notices}}" wx:key="*this">{{item}}</view>
    </view>
    <button class="guide-action" bindtap="goConsult">提交人工评估</button>
  </view>
</view>
<guide-nav active="assessment" />
