<view class="page">
  <view class="top">
    <view class="eyebrow">家长提醒补授权</view>
    <view class="title">{{total}} 条待跟进</view>
    <view class="subtitle">这些课程已到 24 小时提醒时间，但家长没有剩余微信授权额度。</view>
  </view>

  <view class="reminder-card" wx:for="{{reminders}}" wx:key="id">
    <view class="row">
      <view>
        <view class="student">{{item.studentName}}</view>
        <view class="parent">{{item.parentName}} {{item.parentPhone}}</view>
      </view>
      <button class="phone-button" data-phone="{{item.parentPhone}}" bindtap="callParent">联系</button>
    </view>
    <view class="course">{{item.sessionStartText}} · {{item.courseLabel}}</view>
    <view class="teacher">{{item.teacherName}}</view>
    <view class="instruction">{{item.instruction}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !reminders.length}}">当前没有需补授权的课程提醒</view>
</view>
