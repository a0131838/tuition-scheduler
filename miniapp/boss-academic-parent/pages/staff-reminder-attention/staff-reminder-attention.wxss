.summary{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border:1rpx solid #e2e5e4}.summary view{padding:20rpx 10rpx;border-right:1rpx solid #e2e5e4;text-align:center}.summary text{display:block;font-size:21rpx;color:#717771}.summary .metric-value{margin-top:6rpx;font-size:34rpx;font-weight:800;color:#202124}.summary .overdue .metric-value{color:#b44132}.filters{width:100%;margin:22rpx 0 14rpx;white-space:nowrap}.filter-row{display:flex;gap:12rpx}.filter{flex:none;width:auto;min-height:58rpx;margin:0;padding:0 22rpx;border-radius:999rpx;background:#fff;border:1rpx solid #d8dfdc;color:#56605d;font-size:23rpx;line-height:58rpx}.filter.active{background:#173d34;color:#fff;border-color:#173d34}.reminder{margin-top:14rpx;background:#fff;border:1rpx solid #e0e5e3;border-radius:8rpx;overflow:hidden}.reminder.expanded{border-color:#14b888;box-shadow:inset 4rpx 0 #14b888}.reminder-head{display:flex;align-items:flex-start;gap:16rpx;padding:22rpx}.urgency-dot{width:14rpx;height:14rpx;margin-top:12rpx;border-radius:50%;background:#8aa49c}.urgency-dot.OVERDUE{background:#c64b3a}.urgency-dot.TODAY{background:#dd941f}.head-copy{flex:1;min-width:0}.student{font-size:29rpx;font-weight:800}.meta{margin-top:5rpx;color:#69736f;font-size:23rpx;line-height:1.4}.chevron{font-size:42rpx;color:#65716c}.reminder-detail{padding:0 22rpx 24rpx;border-top:1rpx solid #e5e9e7}.subject{padding:18rpx 0;font-weight:700;line-height:1.55}.copy-label{color:#078562;font-size:22rpx;font-weight:800}.copy-text{margin-top:12rpx;padding:20rpx;background:#f3f8f6;white-space:pre-wrap;font-size:25rpx;line-height:1.7}.primary,.copy-row button,.action-grid button,.consent-item button{min-height:72rpx;margin:16rpx 0 0;border-radius:6rpx;background:#fff;border:1rpx solid #cfd9d5;color:#263a35;font-size:24rpx;font-weight:700}.primary{width:100%;background:#ec5e0a;color:#fff;border-color:#ec5e0a}.copy-row{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.copy-row button{width:100%;margin-top:12rpx}.status-label{margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #e2e7e5;color:#737b78;font-size:22rpx}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.action-grid button{width:100%;margin-top:12rpx}.action-grid .done{background:#173d34;color:#fff}.action-grid .escalate{grid-column:1/3;color:#a13f2f;border-color:#e8bcb4}.consent-section{margin-top:34rpx;padding-top:26rpx;border-top:1rpx solid #dce3e0}.section-title{font-size:28rpx;font-weight:800}.consent-item{display:flex;justify-content:space-between;gap:16rpx;margin-top:14rpx;padding:20rpx;background:#fff}.consent-item text{display:block;margin-top:6rpx;color:#69726f;font-size:22rpx;line-height:1.45}.consent-item .consent-student{margin-top:0;color:#202124;font-size:27rpx;font-weight:800}.consent-item button{flex:0 0 auto;width:auto;padding:0 18rpx}
