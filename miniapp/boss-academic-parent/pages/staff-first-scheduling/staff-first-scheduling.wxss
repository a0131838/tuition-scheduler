.page {
  padding: 28rpx;
  min-height: 100vh;
  background: #f5f6f7;
}

.top {
  margin-bottom: 22rpx;
}

.eyebrow,
.hint,
.subtitle {
  color: #6b6f76;
  font-size: 24rpx;
}

.title {
  color: #202124;
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.summary-band {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  border-top: 1rpx solid #e3e5e8;
  border-bottom: 1rpx solid #e3e5e8;
  padding: 22rpx 0;
  margin-bottom: 20rpx;
}

.metric {
  color: #ec5e0a;
  font-size: 40rpx;
  font-weight: 800;
}

.ready-number {
  color: #17663a;
}

.blocked-number {
  color: #9b3d31;
}

.controls {
  display: grid;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.picker,
input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid #d9dce0;
  border-radius: 8rpx;
  background: #fff;
  padding: 18rpx;
}

.student-card {
  background: #fff;
  border: 1rpx solid #e3e5e8;
  border-radius: 8rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.student-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.student-name {
  color: #202124;
  font-size: 31rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.state {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.state.ready {
  background: #e8f4ea;
  color: #17663a;
}

.state.blocked {
  background: #f8ebe8;
  color: #9b3d31;
}

.course-row {
  border-top: 1rpx solid #eceef0;
  padding: 14rpx 0;
}

.course-name {
  color: #202124;
  font-weight: 700;
}

.warning,
.ticket-note {
  border-radius: 6rpx;
  padding: 14rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.warning {
  background: #fff4e5;
  color: #854d0e;
}

.ticket-note {
  background: #eef2f6;
  color: #344054;
}

.start-button {
  min-height: 82rpx;
  margin: 18rpx 0 0;
  border-radius: 8rpx;
  background: #ec5e0a;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.empty {
  color: #6b7280;
  text-align: center;
  padding: 80rpx 20rpx;
}
