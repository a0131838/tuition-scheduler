<view class="page">
  <view class="top">
    <view class="eyebrow">教务工作台</view>
    <view class="title">待排课学生</view>
    <view class="subtitle">已有有效课包、但还没有未来课程的学生。</view>
  </view>

  <view class="summary-band">
    <view>
      <view class="metric">{{totalText}}</view>
      <view class="hint">全部待排</view>
    </view>
    <view>
      <view class="metric ready-number">{{readyText}}</view>
      <view class="hint">可直接排课</view>
    </view>
    <view>
      <view class="metric blocked-number">{{blockedText}}</view>
      <view class="hint">待处理</view>
    </view>
  </view>

  <view class="controls">
    <picker mode="selector" range="{{scopes}}" range-key="label" value="{{scopeIndex}}" bindchange="changeScope">
      <view class="picker">{{scopes[scopeIndex].label}}</view>
    </picker>
    <view class="search-row">
      <input value="{{query}}" bindinput="inputQuery" bindconfirm="search" confirm-type="search" placeholder="搜索学生或学校" />
      <button class="icon-command" bindtap="search">搜索</button>
      <button class="clear-command" wx:if="{{query}}" bindtap="clearSearch">清除</button>
    </view>
  </view>

  <block wx:if="{{visibleCandidates.length}}">
    <view class="student-card" wx:for="{{visibleCandidates}}" wx:key="id">
      <view class="student-head">
        <view>
          <view class="student-name">{{item.name}}</view>
          <view class="hint">{{item.scheduleStageText}} · {{item.grade || '未填年级'}} · {{item.school || '未填学校'}} · {{item.servicePlanType || '未设置服务类型'}}</view>
        </view>
        <view class="state ready" wx:if="{{item.ready}}">可排课</view>
        <view class="state blocked" wx:else>待处理</view>
      </view>

      <view class="course-row" wx:for="{{item.courses}}" wx:key="id" wx:for-item="course">
        <view class="course-name">{{course.name}}</view>
        <view class="hint">{{course.packageText}}</view>
      </view>
      <view class="warning" wx:if="{{item.blockerText}}">{{item.blockerText}}</view>
      <view class="ticket-note" wx:if="{{item.openTicket}}">已有 {{item.openTicket.type}} 工单 · {{item.openTicket.ticketNo}}</view>

      <button
        class="start-button"
        data-id="{{item.id}}"
        data-ticket-id="{{item.openTicket ? item.openTicket.id : ''}}"
        loading="{{openingStudentId === item.id}}"
        disabled="{{openingStudentId !== ''}}"
        bindtap="openCandidate"
      >{{item.openTicket ? '继续处理' : (canSchedule ? '开始首次排课' : '建立排课工单')}}</button>
    </view>
  </block>
  <view wx:else class="empty">当前没有匹配的待首次排课学生</view>
</view>
