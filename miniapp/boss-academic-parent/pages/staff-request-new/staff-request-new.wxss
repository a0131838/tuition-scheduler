.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.input {
  min-height: 76rpx;
  border: 1rpx solid #d9dce0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  background: #fff;
  box-sizing: border-box;
}

.textarea {
  min-height: 180rpx;
}

.textarea.small {
  min-height: 130rpx;
}

.hint {
  color: #6b6f76;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.selected {
  margin-top: 12rpx;
  color: #ec5e0a;
  font-size: 24rpx;
  font-weight: 700;
}

.result {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #e3e5e8;
}

.result-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 800;
}

.file-list { margin-top: 16rpx; border-top: 1rpx solid #dedbd6; }
.file-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid #dedbd6; }
.file-preview { width: 82rpx; height: 82rpx; flex-shrink: 0; border-radius: 8rpx; overflow: hidden; background: #eceae6; }
.file-preview image { width: 100%; height: 100%; }
.file-icon { height: 100%; display: flex; align-items: center; justify-content: center; color: #9b3e08; font-weight: 800; }
.file-copy { min-width: 0; flex: 1; }.file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 750; }.file-meta { margin-top: 4rpx; color: #777b82; font-size: 21rpx; }
.file-remove { width: auto; min-height: 58rpx; margin: 0; padding: 0 12rpx; background: transparent; color: #9b3d31; font-size: 23rpx; }
