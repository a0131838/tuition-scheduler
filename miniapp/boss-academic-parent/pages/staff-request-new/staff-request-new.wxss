.request-page { padding-bottom: 80rpx; }
.request-head { padding-bottom: 20rpx; }
.progress-line { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin: 4rpx 0 18rpx; }
.progress-item { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 52rpx; color: #777c83; font-size: 21rpx; font-weight: 700; border-bottom: 3rpx solid #d9d6d1; }
.progress-item text { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; background: #dedbd6; color: #60656c; font-size: 18rpx; }
.progress-item.done { color: #9b3e08; border-color: #ec5e0a; }.progress-item.done text { background: #ec5e0a; color: #fff; }
.step-section { padding: 30rpx 0 34rpx; border-bottom: 1rpx solid #dcd9d4; }
.step-head { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 24rpx; }
.step-number { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; flex: 0 0 auto; border-radius: 50%; background: #202328; color: #fff; font-size: 23rpx; font-weight: 800; }
.step-title { color: #17191d; font-size: 31rpx; font-weight: 800; line-height: 1.3; }.step-hint { margin-top: 5rpx; color: #767b82; font-size: 22rpx; line-height: 1.4; }
.field { margin-top: 24rpx; }.question-label { margin-bottom: 12rpx; color: #292d32; font-size: 25rpx; font-weight: 750; }.required { margin-left: 8rpx; color: #a04410; font-size: 20rpx; }
.input { min-height: 76rpx; padding: 0 20rpx; border: 1rpx solid #d9dce0; border-radius: 10rpx; background: #fff; box-sizing: border-box; }
.textarea { min-height: 180rpx; }.textarea.small { min-height: 130rpx; }.primary-input { min-height: 230rpx; }.summary-input { min-height: 170rpx; }
.hint { margin-top: 8rpx; color: #6b6f76; font-size: 23rpx; line-height: 1.45; }
.selected-student { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; padding: 18rpx; border-radius: 12rpx; background: #fff0e7; }
.selected-check { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; flex: 0 0 auto; border-radius: 50%; background: #ec5e0a; color: #fff; font-weight: 800; }.selected-label { color: #8e4a22; font-size: 20rpx; }.selected-name { margin-top: 2rpx; color: #45200b; font-size: 26rpx; font-weight: 800; }
.result { padding: 18rpx 4rpx; border-bottom: 1rpx solid #e0ddd8; }.result-title { color: #202124; font-size: 27rpx; font-weight: 800; }
.type-field { margin-top: 26rpx; }.large-picker { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 0 20rpx; border: 1rpx solid #d6d2cc; border-radius: 12rpx; background: #fff; color: #202328; font-size: 28rpx; font-weight: 750; }.large-picker text { color: #a44914; font-size: 22rpx; }
.privacy-note { margin-top: 10rpx; padding-left: 18rpx; border-left: 4rpx solid #202328; color: #555b62; font-size: 22rpx; }
.attachment-actions { display: grid; gap: 14rpx; }.attachment-button { display: flex; align-items: center; justify-content: flex-start; gap: 16rpx; min-height: 104rpx; margin: 0; padding: 16rpx 18rpx; border: 1rpx solid #d7d3ce; border-radius: 14rpx; background: #fff; color: #202328; text-align: left; }.attachment-button.photo { border-color: #ec5e0a; background: #fff8f3; }.attachment-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; flex: 0 0 auto; border-radius: 14rpx; background: #fff0e7; color: #a4440d; font-size: 22rpx; font-weight: 800; }.attachment-title { font-size: 26rpx; font-weight: 800; }.attachment-help { margin-top: 4rpx; color: #757a81; font-size: 21rpx; }
.file-count { margin-top: 18rpx; color: #9b3e08; font-size: 22rpx; font-weight: 750; }.file-list { margin-top: 8rpx; border-top: 1rpx solid #dedbd6; }.file-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid #dedbd6; }.file-preview { width: 82rpx; height: 82rpx; flex-shrink: 0; border-radius: 8rpx; overflow: hidden; background: #eceae6; }.file-preview image { width: 100%; height: 100%; }.file-icon { height: 100%; display: flex; align-items: center; justify-content: center; color: #9b3e08; font-weight: 800; }.file-copy { min-width: 0; flex: 1; }.file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 750; }.file-meta { margin-top: 4rpx; color: #777b82; font-size: 21rpx; }.file-remove { width: auto; min-height: 58rpx; margin: 0; padding: 0 12rpx; background: transparent; color: #9b3d31; font-size: 23rpx; }
.advanced-toggle { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid #dcd9d4; }.advanced-title { color: #30343a; font-size: 25rpx; font-weight: 750; }.advanced-hint { margin-top: 4rpx; color: #7a7f86; font-size: 20rpx; line-height: 1.4; }.advanced-arrow { color: #9b3e08; font-size: 28rpx; }.advanced-fields { padding: 4rpx 0 26rpx; border-bottom: 1rpx solid #dcd9d4; }.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18rpx; }
.submit-area { padding-top: 30rpx; }.submit-hint { margin-bottom: 12rpx; color: #9a3e32; font-size: 23rpx; font-weight: 700; }.submit-ready { margin-bottom: 12rpx; color: #34704a; font-size: 23rpx; font-weight: 750; }.create-button { min-height: 98rpx; font-size: 30rpx; box-shadow: 0 10rpx 24rpx rgba(203, 76, 5, 0.18); }
