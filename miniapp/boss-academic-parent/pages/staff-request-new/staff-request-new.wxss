.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.input {
  min-height: 76rpx;
  border: 1rpx solid #d9dce0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  background: #fff;
  box-sizing: border-box;
}

.textarea {
  min-height: 180rpx;
}

.textarea.small {
  min-height: 130rpx;
}

.hint {
  color: #6b6f76;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.selected {
  margin-top: 12rpx;
  color: #ec5e0a;
  font-size: 24rpx;
  font-weight: 700;
}

.result {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #e3e5e8;
}

.result-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 800;
}
