<view class="page page-enter request-page">
  <view class="draft-restored" wx:if="{{draftRestored}}">已恢复上次未提交的工单草稿；截图或文件需要重新选择。</view>
  <view class="top request-head">
    <view class="eyebrow">教务代录</view>
    <view class="title">把家长消息变成工单</view>
    <view class="subtitle">先选学生和具体课程，再把家长消息拆成教务可以直接执行的动作。</view>
  </view>

  <view class="progress-line">
    <view class="progress-item {{selectedStudentId ? 'done' : ''}}"><text>1</text>选学生</view>
    <view class="progress-item {{originalContent && publicSummary ? 'done' : ''}}"><text>2</text>写内容</view>
    <view class="progress-item"><text>3</text>加截图</view>
  </view>

  <view class="step-section">
    <view class="step-head"><view class="step-number">1</view><view><view class="step-title">这是哪位学生的事？</view><view class="step-hint">输入姓名或学校，点选正确学生</view></view></view>
    <view class="search-row">
      <view class="search-input-wrap">
        <input class="search-input" value="{{studentQuery}}" placeholder="例如：Daisy 或学校名称" confirm-type="search" bindinput="onStudentInput" bindconfirm="searchStudents" />
        <view class="search-clear" wx:if="{{studentQuery}}" catchtap="clearStudentSearch">×</view>
      </view>
      <view class="search-submit" bindtap="searchStudents">查询</view>
    </view>
    <view class="hint" wx:if="{{searching}}">正在查询…</view>
    <view class="selected-student" wx:if="{{selectedStudentLabel}}"><view class="selected-check">✓</view><view><view class="selected-label">已选学生</view><view class="selected-name">{{selectedStudentLabel}}</view></view></view>
    <view class="result" wx:for="{{studentResults}}" wx:key="id" bindtap="selectStudent" data-id="{{item.id}}" data-label="{{item.label}}">
      <view class="result-title">{{item.label}}</view><view class="hint">{{item.school}}</view>
    </view>
    <view class="field type-field">
      <view class="question-label">家长希望教务做什么？</view>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="large-picker">{{typeOptions[typeIndex].label}}<text>更换 ›</text></view></picker>
    </view>

    <view class="action-builder" wx:if="{{schedulingActions.length}}">
      <view class="action-builder-head"><view><view class="question-label">排课执行动作</view><view class="hint">一条消息有多个要求时，继续添加动作，不要重复建工单。</view></view><button class="add-action" bindtap="addSchedulingAction">＋ 添加</button></view>
      <view class="field" wx:if="{{selectedStudentId}}">
        <view class="label">查找哪一天的原课程</view>
        <picker mode="date" value="{{sourceDate}}" start="{{sourceWindow.minDate}}" end="{{sourceWindow.maxDate}}" bindchange="changeSourceDate"><view class="compact-picker">{{sourceDate}}<text>更换 ›</text></view></picker>
        <view class="hint">可查询最近 7 天至未来 90 天；当天已开始或结束的课程也会显示。</view>
      </view>
      <view class="schedule-loading" wx:if="{{scheduleOptionsLoading}}">正在读取当天课程…</view>
      <view class="schedule-action" wx:for="{{schedulingActions}}" wx:key="index">
        <view class="schedule-action-head"><view><view class="action-order">动作 {{index + 1}}</view><view class="action-name">{{item.actionLabel}}</view></view><button class="remove-action" wx:if="{{schedulingActions.length > 1}}" data-index="{{index}}" bindtap="removeSchedulingAction">删除</button></view>
        <view class="field" wx:if="{{item.needsSource && !item.manualSource}}">
          <view class="label">选择要处理的原课程 <text class="required">必选</text></view>
          <picker mode="selector" range="{{upcomingSessions}}" range-key="startText" value="{{item.sourceIndex}}" data-index="{{index}}" bindchange="changeActionSource">
            <view class="action-picker {{item.sourceSessionId ? 'selected' : ''}}">{{item.sourceSessionLabel}}<text>选择 ›</text></view>
          </picker>
          <view class="hint" wx:if="{{!scheduleOptionsLoading && !upcomingSessions.length}}">当天没有找到系统课程。取消/请假可使用下面的手动记录，由教务后续匹配。</view>
        </view>
        <view class="requested-time" wx:if="{{item.actionType === 'RESCHEDULE_SESSION' || item.actionType === 'CREATE_SESSION' || item.actionType === 'COORDINATE_ONLY'}}">
          <view class="field"><view class="label">希望日期（可先不填具体时间）</view><picker mode="date" value="{{item.requestedDate}}" data-index="{{index}}" bindchange="changeActionDate"><view class="compact-picker">{{item.requestedDate}}</view></picker></view>
          <view class="field"><view class="label">希望时间</view><picker mode="time" value="{{item.requestedTime}}" data-index="{{index}}" bindchange="changeActionTime"><view class="compact-picker">{{item.requestedTime || '待家长确认'}}</view></picker></view>
        </view>
        <view wx:if="{{item.actionType === 'CANCEL_SESSION'}}">
          <view class="replacement-line"><view><view class="label">找不到系统课程，手动记录</view><view class="hint">只建待匹配工单，不会自动取消课程或修改扣课。</view></view><switch checked="{{item.manualSource}}" data-index="{{index}}" bindchange="toggleManualSource" color="#ec5e0a" /></view>
          <view class="manual-source" wx:if="{{item.manualSource}}">
            <view class="manual-warning">待教务匹配原课程，禁止自动执行</view>
            <view class="requested-time">
              <view class="field"><view class="label">课程日期</view><picker mode="date" value="{{item.manualDate}}" start="{{sourceWindow.minDate}}" end="{{sourceWindow.maxDate}}" data-index="{{index}}" bindchange="changeManualDate"><view class="compact-picker">{{item.manualDate}}</view></picker></view>
              <view class="field"><view class="label">开始时间</view><picker mode="time" value="{{item.manualTime}}" data-index="{{index}}" bindchange="changeManualTime"><view class="compact-picker">{{item.manualTime || '请选择'}}</view></picker></view>
            </view>
            <view class="field"><view class="label">课程名称 <text class="required">必填</text></view><input class="input" value="{{item.manualCourse}}" data-index="{{index}}" placeholder="例如：A-Level 生物" bindinput="inputManualCourse" /></view>
            <view class="field"><view class="label">老师（可选）</view><input class="input" value="{{item.manualTeacher}}" data-index="{{index}}" placeholder="例如：王老师" bindinput="inputManualTeacher" /></view>
          </view>
          <view class="grid cancellation-meta">
            <view class="field"><view class="label">请假方</view><picker mode="selector" range="{{leaveParties}}" value="{{item.leavePartyIndex}}" data-index="{{index}}" bindchange="changeLeaveParty"><view class="compact-picker">{{leaveParties[item.leavePartyIndex]}}</view></picker></view>
            <view class="field"><view class="label">收到通知日期</view><picker mode="date" value="{{item.noticeDate}}" data-index="{{index}}" bindchange="changeNoticeDate"><view class="compact-picker">{{item.noticeDate}}</view></picker></view>
            <view class="field"><view class="label">收到通知时间</view><picker mode="time" value="{{item.noticeTime}}" data-index="{{index}}" bindchange="changeNoticeTime"><view class="compact-picker">{{item.noticeTime}}</view></picker></view>
          </view>
          <view class="replacement-line"><view><view class="label">取消后还需要补课吗？</view><view class="hint">打开后，这张工单不会在取消完成时提前关闭。</view></view><switch checked="{{item.replacementRequired}}" data-index="{{index}}" bindchange="changeReplacementRequired" color="#ec5e0a" /></view>
        </view>
        <view class="field"><view class="label">这个动作的补充说明</view><textarea class="textarea action-notes" value="{{item.notes}}" data-index="{{index}}" placeholder="例如：老师已确认；家长只能周六；取消不扣课时待管理员确认" bindinput="inputActionNotes" /></view>
      </view>
    </view>
  </view>

  <view class="step-section">
    <view class="step-head"><view class="step-number">2</view><view><view class="step-title">家长说了什么？</view><view class="step-hint">先记录原话，再写一句给家长看的摘要</view></view></view>
    <view class="field">
      <view class="question-label">粘贴聊天原话 <text class="required">必填 · 仅员工可见</text></view>
      <textarea class="textarea primary-input" value="{{originalContent}}" placeholder="长按这里，粘贴微信群里的家长消息；也可以手动概括" bindinput="onOriginalInput" />
    </view>
    <view class="privacy-note">家长不会看到上面的聊天原话</view>
    <view class="field">
      <view class="question-label">给家长看的事项摘要 <text class="required">必填</text></view>
      <textarea class="textarea summary-input" value="{{publicSummary}}" placeholder="例如：已收到本周请假申请，教务正在协调补课时间" bindinput="onPublicInput" />
      <view class="hint">请只写家长可以直接看到的内容，不写内部判断。</view>
    </view>
  </view>

  <view class="step-section">
    <view class="step-head"><view class="step-number">3</view><view><view class="step-title">有截图或文件吗？</view><view class="step-hint">没有附件也可以直接提交</view></view></view>
    <view class="attachment-actions">
      <button class="attachment-button photo" bindtap="choosePhotos"><view class="attachment-icon">图</view><view><view class="attachment-title">从相册选择截图</view><view class="attachment-help">手机里已经保存的图片</view></view></button>
      <button class="attachment-button" bindtap="chooseFiles"><view class="attachment-icon">微</view><view><view class="attachment-title">从微信聊天选择文件</view><view class="attachment-help">图片、PDF 或 Word</view></view></button>
    </view>
    <view class="file-count" wx:if="{{files.length}}">已选择 {{files.length}} 个附件（最多 9 个）</view>
    <view class="file-list" wx:if="{{files.length}}">
      <view class="file-row" wx:for="{{files}}" wx:key="path">
        <view class="file-preview" data-index="{{index}}" bindtap="previewFile"><image wx:if="{{item.isImage}}" src="{{item.path}}" mode="aspectFill"/><view wx:else class="file-icon">文</view></view>
        <view class="file-copy" data-index="{{index}}" bindtap="previewFile"><view class="file-name">{{item.name}}</view><view class="file-meta">{{item.isImage ? '点击预览' : '已选择文件'}}</view></view>
        <button class="file-remove" data-index="{{index}}" bindtap="removeFile">删除</button>
      </view>
    </view>
  </view>

  <view class="advanced-toggle" bindtap="toggleAdvanced"><view><view class="advanced-title">更多设置（通常不用改）</view><view class="advanced-hint">来源、下一步、紧急程度、负责人和截止时间</view></view><view class="advanced-arrow">{{advancedOpen ? '⌃' : '⌄'}}</view></view>
  <view class="advanced-fields" wx:if="{{advancedOpen}}">
    <view class="grid">
      <view class="field"><view class="label">沟通入口</view><picker mode="selector" range="{{communicationSources}}" value="{{communicationSourceIndex}}" bindchange="onSourceChange"><view class="picker">{{communicationSources[communicationSourceIndex]}}</view></picker></view>
      <view class="field"><view class="label">紧急程度</view><picker mode="selector" range="{{priorities}}" value="{{priorityIndex}}" bindchange="onPriorityChange"><view class="picker">{{priorities[priorityIndex]}}</view></picker></view>
      <view class="field"><view class="label">负责人</view><picker mode="selector" range="{{owners}}" value="{{ownerIndex}}" bindchange="onOwnerChange"><view class="picker">{{owners[ownerIndex]}}</view></picker></view>
      <view class="field"><view class="label">群名/补充来源</view><input class="input" value="{{sourceDetail}}" placeholder="例如：G9数学家长群" bindinput="onSourceDetailInput" /></view>
    </view>
    <view class="field"><view class="label">下一步动作</view><textarea class="textarea small" value="{{requiredAction}}" placeholder="例如：Eva 今天确认老师并回复家长" bindinput="onActionInput" /></view>
    <view class="field"><view class="label">截止说明</view><input class="input" value="{{latestDeadlineText}}" placeholder="例如：今天18:00前" bindinput="onDeadlineInput" /></view>
  </view>

  <view class="submit-area">
    <view class="submit-hint" wx:if="{{!selectedStudentId}}">还差：选择学生</view>
    <view class="submit-hint" wx:elif="{{!originalContent}}">还差：填写家长原话</view>
    <view class="submit-hint" wx:elif="{{!publicSummary}}">还差：填写家长可见摘要</view>
    <view class="submit-ready" wx:else>信息已齐，可以创建</view>
    <button class="btn create-button" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">确认创建工单</button>
  </view>
</view>
