<view class="page">
  <view class="top">
    <view class="eyebrow">家长服务</view>
    <view class="title">代录工单</view>
    <view class="subtitle">记录家长诉求和后续处理事项。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">学生</view>
      <view class="search-row">
        <view class="search-input-wrap">
          <input class="search-input" value="{{studentQuery}}" placeholder="输入学生姓名或学校" confirm-type="search" bindinput="onStudentInput" bindconfirm="searchStudents" />
          <view class="search-clear" wx:if="{{studentQuery}}" catchtap="clearStudentSearch">×</view>
        </view>
        <view class="search-submit" bindtap="searchStudents">查询</view>
      </view>
      <view class="hint" wx:if="{{searching}}">正在查询…</view>
      <view class="selected" wx:if="{{selectedStudentLabel}}">已选择：{{selectedStudentLabel}}</view>
      <view wx:for="{{studentResults}}" wx:key="id" class="result" bindtap="selectStudent" data-id="{{item.id}}" data-label="{{item.label}}">
        <view class="result-title">{{item.label}}</view>
        <view class="hint">{{item.school}}</view>
      </view>
    </view>

    <view class="grid">
      <view class="field">
        <view class="label">请求类型</view>
        <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="picker">{{types[typeIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">沟通入口</view>
        <picker mode="selector" range="{{communicationSources}}" value="{{communicationSourceIndex}}" bindchange="onSourceChange">
          <view class="picker">{{communicationSources[communicationSourceIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="label">群名/补充来源</view>
      <input class="input" value="{{sourceDetail}}" placeholder="例如：G9数学家长群，可选" bindinput="onSourceDetailInput" />
    </view>

    <view class="field">
      <view class="label">沟通记录（仅内部可见）</view>
      <textarea class="textarea" value="{{originalContent}}" placeholder="记录原始诉求和必要背景" bindinput="onOriginalInput" />
    </view>

    <view class="field">
      <view class="label">对家长可见摘要</view>
      <textarea class="textarea" value="{{publicSummary}}" placeholder="填写家长可查看的事项摘要" bindinput="onPublicInput" />
    </view>

    <view class="field">
      <view class="label">下一步动作</view>
      <textarea class="textarea small" value="{{requiredAction}}" placeholder="例如：Eva 确认排课并在今天内回复家长" bindinput="onActionInput" />
    </view>

    <view class="grid">
      <view class="field">
        <view class="label">紧急程度</view>
        <picker mode="selector" range="{{priorities}}" value="{{priorityIndex}}" bindchange="onPriorityChange">
          <view class="picker">{{priorities[priorityIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">负责人</view>
        <picker mode="selector" range="{{owners}}" value="{{ownerIndex}}" bindchange="onOwnerChange">
          <view class="picker">{{owners[ownerIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="label">截止说明</view>
      <input class="input" value="{{latestDeadlineText}}" placeholder="例如：今天18:00前，可选" bindinput="onDeadlineInput" />
    </view>

    <view class="field">
      <view class="label">聊天截图/附件</view>
      <button class="btn" bindtap="choosePhotos">从相册选择截图</button>
      <button class="btn secondary" bindtap="chooseFiles">从微信聊天选择文件</button>
      <view class="hint">支持相册截图、微信文件、PDF 和 Word；最多 9 个。</view>
      <view class="file-list" wx:if="{{files.length}}">
        <view class="file-row" wx:for="{{files}}" wx:key="path">
          <view class="file-preview" data-index="{{index}}" bindtap="previewFile"><image wx:if="{{item.isImage}}" src="{{item.path}}" mode="aspectFill"/><view wx:else class="file-icon">文</view></view>
          <view class="file-copy" data-index="{{index}}" bindtap="previewFile"><view class="file-name">{{item.name}}</view><view class="file-meta">{{item.isImage ? '点击预览' : '已选择文件'}}</view></view>
          <button class="file-remove" data-index="{{index}}" bindtap="removeFile">删除</button>
        </view>
      </view>
    </view>

    <button class="btn" loading="{{loading}}" bindtap="submit">创建工单</button>
  </view>
</view>
