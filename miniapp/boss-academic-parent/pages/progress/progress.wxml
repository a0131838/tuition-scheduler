<view class="page progress-page page-enter">
  <view class="progress-head">
    <view class="eyebrow">{{student.name || "当前学生"}}</view>
    <view class="title">学习与服务进展</view>
    <view class="progress-subline">{{service.label || "普通课程"}} · 负责人 {{responsiblePerson || "博思服务团队"}}</view>
  </view>

  <view wx:if="{{loading}}" class="progress-loading"><view class="loading-line wide"></view><view class="loading-line"></view><view class="loading-block"></view></view>
  <view wx:elif="{{error}}" class="progress-error"><view class="error-title">暂时无法读取</view><view class="error-copy">{{error}}</view><button class="quiet-button" bindtap="load">重新加载</button></view>

  <block wx:else>
    <view class="progress-tabs" style="{{hasFormalReports ? '' : 'grid-template-columns:repeat(2,1fr)'}}">
      <view class="progress-tab {{viewMode === 'updates' ? 'active' : ''}}" data-mode="updates" bindtap="changeView">最新动态</view>
      <view class="progress-tab {{viewMode === 'reports' ? 'active' : ''}}" wx:if="{{hasFormalReports}}" data-mode="reports" bindtap="changeView">正式报告</view>
      <view class="progress-tab {{viewMode === 'entitlements' ? 'active' : ''}}" data-mode="entitlements" bindtap="changeView">服务权益</view>
    </view>

    <view wx:if="{{viewMode === 'updates'}}" class="view-section">
      <view class="status-line tone-{{parentStatus.tone}}">
        <view><view class="status-label">当前状态</view><view class="status-title">{{parentStatus.label}}</view></view>
        <view class="status-copy">{{parentStatus.summary}}</view>
      </view>

      <view class="parent-action" wx:if="{{parentAction}}">
        <view class="parent-action-label">现在需要您做</view>
        <view class="parent-action-title">{{parentAction.summary}}</view>
        <view class="parent-action-meta" wx:if="{{parentAction.dueAtText}}">请于 {{parentAction.dueAtText}} 前完成</view>
      </view>

      <view class="answer-list" wx:if="{{care.active}}">
        <view class="answer-row"><view class="answer-label">最近完成</view><view class="answer-value">{{reassurance.latest ? reassurance.latest.title : "等待首条正式服务动态"}}</view><view class="answer-note" wx:if="{{reassurance.latest}}">{{reassurance.latest.summary}}</view></view>
        <view class="answer-row"><view class="answer-label">接下来</view><view class="answer-value">{{nextStep.text || "当前服务按计划推进"}}</view><view class="answer-note" wx:if="{{nextStep.dueText}}">计划日期 {{nextStep.dueText}}</view></view>
        <view class="answer-row"><view class="answer-label">下次更新</view><view class="answer-value">{{care.nextUpdate.dateText}}</view><view class="answer-note">{{care.nextUpdate.promise}}</view></view>
      </view>

      <view class="risk-section" wx:if="{{care.visibleRisks.length}}">
        <view class="section-row"><view class="section-title">正在重点处理</view><view class="count-badge">{{care.visibleRisks.length}}</view></view>
        <view class="risk-row" wx:for="{{care.visibleRisks}}" wx:key="id"><view class="risk-status">{{item.statusText}}</view><view class="risk-summary">{{item.summary}}</view><view class="risk-time">最近更新 {{item.updatedAtText}}</view></view>
        <view class="section-note">重大事项会主动联系，不会等待月报。</view>
      </view>

      <view class="detail-toggle" bindtap="toggleDetails">
        <view><view class="detail-toggle-title">更多服务记录</view><view class="detail-toggle-note">本周数据与完整时间线</view></view>
        <view class="detail-toggle-action">{{detailsExpanded ? "收起 ⌃" : "展开 ⌄"}}</view>
      </view>

      <block wx:if="{{detailsExpanded}}">
        <view class="week-summary">
          <view class="section-row"><view class="section-title">本周概览</view><view class="section-note">{{period.label}}</view></view>
          <view class="summary-grid">
            <view class="summary-item" wx:if="{{permissions.canViewSchedule}}" bindtap="goSchedule"><view class="summary-number">{{summary.completedLessons || 0}}</view><view class="summary-label">完成课程</view></view>
            <view class="summary-item" wx:if="{{permissions.canViewFeedback}}" bindtap="goFeedbacks"><view class="summary-number">{{summary.feedbackCount || 0}}</view><view class="summary-label">课后反馈</view></view>
            <view class="summary-item" wx:if="{{permissions.canCreateRequests}}" bindtap="goRequests"><view class="summary-number">{{summary.openRequestCount || 0}}</view><view class="summary-label">处理中请求</view></view>
          </view>
        </view>

        <view class="timeline-head"><view class="section-title">最近进展</view><view class="section-note">按时间合并课程、反馈与服务记录</view></view>
        <view class="timeline" wx:if="{{timeline.length}}">
          <view class="timeline-row" wx:for="{{timeline}}" wx:key="id">
            <view class="timeline-marker"><view class="timeline-dot kind-{{item.kind}}"></view><view class="timeline-line"></view></view>
            <view class="timeline-body"><view class="timeline-meta"><text>{{item.kindLabel}}</text><text>{{item.occurredAtText}}</text></view><view class="timeline-title">{{item.title}}</view><view class="timeline-summary">{{item.summary}}</view></view>
          </view>
        </view>
        <view class="empty-line" wx:else>课程完成或团队发布进展后会显示在这里。</view>
      </block>
    </view>

    <view wx:if="{{viewMode === 'reports'}}" class="view-section">
      <view class="report-feature" wx:if="{{care.latestReport}}" bindtap="openLatestReport">
        <view class="report-label">最新正式报告</view><view class="report-title">{{care.latestReport.title}}</view><view class="report-meta">{{care.latestReport.periodLabel}} · {{care.latestReport.acknowledged ? "已确认收到" : "待确认收到"}}</view><view class="report-link">查看报告 ›</view>
      </view>
      <view class="empty-state" wx:else><view class="empty-title">暂无已发布报告</view><view class="empty-copy">服务团队完成整理和审核后会在这里发布。</view></view>
      <button class="outline-button" wx:if="{{care.active}}" bindtap="goCareReports">查看全部正式报告</button>
      <view class="report-explain"><view class="section-title">报告如何产生</view><view class="section-note">只有完成资料整理和团队审核的内容才会向家长发布。重大事项不会等待正式报告。</view></view>
    </view>

    <view wx:if="{{viewMode === 'entitlements'}}" class="view-section">
      <view class="entitlement-lead"><view class="entitlement-label">当前方案</view><view class="entitlement-title">{{care.active ? care.programLabel : service.label}}</view><view class="entitlement-copy">{{service.description}}</view></view>
      <view class="entitlement-list">
        <view class="entitlement-row"><view class="row-label">主要负责人</view><view class="row-value">{{responsiblePerson}}</view></view>
        <view class="entitlement-row" wx:if="{{care.active}}"><view class="row-label">服务周期</view><view class="row-value">{{care.startDate}} 至 {{care.endDate}}</view></view>
        <view class="entitlement-row"><view class="row-label">剩余课时</view><view class="row-value">{{lessonBalanceText}}</view></view>
        <view class="entitlement-row"><view class="row-label">更新节奏</view><view class="row-value">{{care.active ? care.nextUpdate.dateText : service.cadence}}</view></view>
      </view>
      <view class="scope-section" wx:if="{{care.active && care.serviceCommitments.length}}"><view class="section-title">本方案包含</view><view class="scope-list"><view class="scope-item" wx:for="{{care.serviceCommitments}}" wx:key="*this">{{item}}</view></view><view class="section-note">以上内容来自当前已确认的服务范围。</view></view>
      <button class="outline-button" wx:if="{{permissions.canViewFinance}}" bindtap="goFinance">查看课包、财务与合同</button>
    </view>

    <view class="service-footer" wx:if="{{permissions.canCreateRequests}}"><button class="contact-button" bindtap="goNewRequest">联系服务团队</button><button class="text-button" bindtap="goRequests">查看历史请求</button></view>
  </block>
</view>
