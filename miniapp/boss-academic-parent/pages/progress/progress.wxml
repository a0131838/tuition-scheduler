<view class="page progress-page">
  <view class="top progress-top">
    <view class="eyebrow">{{student.name || "当前学生"}}</view>
    <view class="title">服务进展</view>
    <view class="subtitle">{{service.description}}</view>
  </view>

  <view wx:if="{{loading}}" class="progress-loading">正在汇总服务记录...</view>
  <view wx:elif="{{error}}" class="progress-error">
    <view class="value">暂时无法读取</view>
    <view class="subtitle">{{error}}</view>
    <button class="btn progress-retry" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view class="reassurance-panel" wx:if="{{care.active}}">
      <view class="reassurance-head">
        <view>
          <view class="eyebrow">家长安心看板</view>
          <view class="reassurance-title">孩子的情况，我们持续跟进</view>
        </view>
        <view class="reassurance-owner">负责人 {{responsiblePerson}}</view>
      </view>
      <view class="reassurance-grid">
        <view class="reassurance-card tone-{{parentStatus.tone}}">
          <view class="question-label">孩子现在怎么样？</view>
          <view class="answer-title">{{parentStatus.label}}</view>
          <view class="answer-copy">{{parentStatus.summary}}</view>
        </view>
        <view class="reassurance-card">
          <view class="question-label">我们最近做了什么？</view>
          <block wx:if="{{reassurance.latest}}">
            <view class="answer-title">{{reassurance.latest.title}}</view>
            <view class="answer-copy">{{reassurance.latest.summary}}</view>
            <view class="answer-meta">{{reassurance.latest.occurredAtText}}</view>
          </block>
          <view class="answer-copy" wx:else>首条正式服务动态经审核后会显示在这里。</view>
        </view>
        <view class="reassurance-card">
          <view class="question-label">接下来做什么？</view>
          <view class="answer-title">{{nextStep.label}}</view>
          <view class="answer-copy">{{nextStep.text}}</view>
          <view class="answer-meta" wx:if="{{nextStep.dueText}}">计划日期 {{nextStep.dueText}}</view>
        </view>
        <view class="reassurance-card update-card">
          <view class="question-label">下次什么时候更新？</view>
          <view class="answer-title">{{care.nextUpdate.dateText}}</view>
          <view class="answer-copy">{{care.nextUpdate.promise}}</view>
        </view>
      </view>
    </view>

    <view class="status-band tone-{{parentStatus.tone}}" wx:else>
      <view class="status-copy">
        <view class="label">当前状态</view>
        <view class="status-title">{{parentStatus.label}}</view>
        <view class="status-summary">{{parentStatus.summary}}</view>
      </view>
    </view>

    <view class="commitment-band" wx:if="{{care.active && care.serviceCommitments.length}}">
      <view class="label">我们正在负责的事项</view>
      <view class="commitment-list">
        <view class="commitment-chip" wx:for="{{care.serviceCommitments}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="commitment-note">这里只显示合同范围内、适合向家长公开的服务承诺。</view>
    </view>

    <view class="visible-risk-band" wx:if="{{care.active && care.visibleRisks.length}}">
      <view class="visible-risk-head">
        <view class="section-title">正在重点处理</view>
        <view class="risk-badge">{{care.visibleRisks.length}} 项</view>
      </view>
      <view class="visible-risk-row" wx:for="{{care.visibleRisks}}" wx:key="id">
        <view class="visible-risk-status">{{item.statusText}}</view>
        <view class="visible-risk-summary">{{item.summary}}</view>
        <view class="answer-meta">最近更新 {{item.updatedAtText}}</view>
      </view>
      <view class="visible-risk-note">团队只展示已经核实并适合向家长公开的风险信息；重大事项会主动联系，不会等待月报。</view>
    </view>

    <view class="service-band">
      <view class="service-band-head">
        <view>
          <view class="label">当前服务</view>
          <view class="service-name">{{service.label}}</view>
        </view>
      </view>
      <view class="service-cadence">{{service.cadence}}</view>
      <view class="owner-line">
        <text class="owner-label">主要负责人</text>
        <text class="owner-name">{{responsiblePerson}}</text>
      </view>
    </view>

    <view class="section-head">
      <view>
        <view class="section-title">本周服务</view>
        <view class="section-note">{{period.label}}</view>
      </view>
    </view>
    <view class="progress-metrics {{metricClass}}">
      <view class="progress-metric" wx:if="{{permissions.canViewSchedule}}" bindtap="goSchedule">
        <view class="metric-number">{{summary.completedLessons || 0}}</view>
        <view class="metric-label">完成课程</view>
        <view class="metric-note">本周共 {{summary.scheduledLessons || 0}} 节</view>
      </view>
      <view class="progress-metric" wx:if="{{permissions.canViewFeedback}}" bindtap="goFeedbacks">
        <view class="metric-number">{{summary.feedbackCount || 0}}</view>
        <view class="metric-label">课后反馈</view>
        <view class="metric-note">查看学习记录</view>
      </view>
      <view class="progress-metric" wx:if="{{permissions.canCreateRequests}}" bindtap="goRequests">
        <view class="metric-number">{{summary.openRequestCount || 0}}</view>
        <view class="metric-label">处理中请求</view>
        <view class="metric-note">查看处理进度</view>
      </view>
    </view>

    <view class="next-band">
      <view class="next-marker"></view>
      <view class="next-content">
        <view class="label">{{nextStep.label}}</view>
        <view class="next-text">{{nextStep.text}}</view>
        <view class="next-due" wx:if="{{nextStep.dueText}}">计划日期 {{nextStep.dueText}}</view>
      </view>
    </view>

    <view class="parent-actions" wx:if="{{parentActions.length}}">
      <view class="section-title">需要家长配合</view>
      <view class="action-row" wx:for="{{parentActions}}" wx:key="id">
        <view class="action-copy">{{item.summary}}</view>
        <view class="action-date">{{item.dueAtText}}</view>
      </view>
      <button class="btn secondary action-contact" wx:if="{{permissions.canCreateRequests}}" bindtap="goNewRequest">需要沟通</button>
    </view>
    <view class="parent-clear" wx:else>
      <view class="label">需要家长配合</view>
      <view class="parent-clear-text">目前无需家长处理</view>
    </view>

    <view class="report-band" wx:if="{{care.active}}" bindtap="goCareReports">
      <view>
        <view class="label">正式进展报告</view>
        <view class="report-title">{{care.latestReport ? care.latestReport.title : "等待服务团队发布"}}</view>
        <view class="section-note" wx:if="{{care.latestReport}}">
          {{care.latestReport.periodLabel}} · {{care.latestReport.acknowledged ? "已确认" : "待确认"}}
        </view>
      </view>
      <view class="report-arrow">›</view>
    </view>

    <view class="section-head timeline-head">
      <view>
        <view class="section-title">最近服务记录</view>
        <view class="section-note">课程、反馈、请求和已发布的服务进展</view>
      </view>
    </view>
    <view class="timeline" wx:if="{{timeline.length}}">
      <view class="timeline-row" wx:for="{{timeline}}" wx:key="id">
        <view class="timeline-rail">
          <view class="timeline-dot kind-{{item.kind}}"></view>
          <view class="timeline-line"></view>
        </view>
        <view class="timeline-body">
          <view class="timeline-meta">
            <text class="timeline-kind">{{item.kindLabel}}</text>
            <text class="timeline-date">{{item.occurredAtText}}</text>
          </view>
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-summary">{{item.summary}}</view>
        </view>
      </view>
    </view>
    <view class="timeline-empty" wx:else>服务记录会在课程完成或进度更新后显示。</view>

    <view class="service-actions" wx:if="{{permissions.canCreateRequests}}">
      <button class="btn" bindtap="goNewRequest">提交服务请求</button>
      <button class="btn secondary" bindtap="goRequests">查看请求记录</button>
    </view>

    <view class="care-note" wx:if="{{student.servicePlanType === 'FULL_CARE' && permissions.canViewReports && !care.active}}">
      全程托管动态将在服务团队正式发布后显示，课程与请求记录不受影响。
    </view>
  </block>
</view>
