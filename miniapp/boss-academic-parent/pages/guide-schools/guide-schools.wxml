<view class="guide-page">
  <view class="guide-hero">
    <view class="guide-kicker">找学校</view>
    <view class="guide-title">选择学校类型</view>
  </view>

  <view class="guide-search">
    <input class="guide-input" value="{{query}}" bindinput="inputQuery" placeholder="搜索学校中文名或英文名" />
  </view>

  <view class="consumer-start" hover-class="guide-press" bindtap="goAssessment">
    <view><view class="consumer-start-title">2分钟智能选校</view><view class="guide-section-note">按年龄、预算和课程筛选</view></view><view class="guide-arrow">›</view>
  </view>

  <view class="school-category-grid">
    <view class="school-category {{activeCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">
      <view class="school-category-title">{{item.title}}</view>
    </view>
  </view>

  <view wx:if="{{activeCategory === 'international'}}">
    <scroll-view class="school-focus-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="guide-tier-tabs school-focus-tabs">
      <view class="guide-tier-tab {{focus === 'ALL' ? 'active' : ''}}" data-focus="ALL" bindtap="setFocus">全部</view>
      <view class="guide-tier-tab {{focus === 'IB' ? 'active' : ''}}" data-focus="IB" bindtap="setFocus">IB</view>
      <view class="guide-tier-tab {{focus === 'BRITISH' ? 'active' : ''}}" data-focus="BRITISH" bindtap="setFocus">英式 / A Level</view>
      <view class="guide-tier-tab {{focus === 'AMERICAN' ? 'active' : ''}}" data-focus="AMERICAN" bindtap="setFocus">美式 / AP</view>
      <view class="guide-tier-tab {{focus === 'OTHER' ? 'active' : ''}}" data-focus="OTHER" bindtap="setFocus">其他课程</view>
    </view>
    </scroll-view>
    <view class="school-more-toggle" bindtap="toggleMoreFilters"><text>更多筛选</text><text>{{showMoreFilters ? '收起' : '展开'}}</text></view>
    <scroll-view class="school-focus-scroll school-focus-more" scroll-x="true" enhanced="true" show-scrollbar="false" wx:if="{{showMoreFilters}}">
    <view class="guide-tier-tabs school-focus-tabs">
      <view class="guide-tier-tab {{focus === 'HERITAGE' ? 'active' : ''}}" data-focus="HERITAGE" bindtap="setFocus">国家/侨民课程</view>
      <view class="guide-tier-tab {{focus === 'NEW' ? 'active' : ''}}" data-focus="NEW" bindtap="setFocus">近期开校</view>
      <view class="guide-tier-tab {{focus === 'VISA_LIMITED' ? 'active' : ''}}" data-focus="VISA_LIMITED" bindtap="setFocus">需长期准证</view>
      <view class="guide-tier-tab {{focus === 'SPECIAL_SUPPORT' ? 'active' : ''}}" data-focus="SPECIAL_SUPPORT" bindtap="setFocus">专项支持</view>
      <view class="guide-tier-tab {{focus === 'PRESCHOOL' ? 'active' : ''}}" data-focus="PRESCHOOL" bindtap="setFocus">学前</view>
    </view>
    </scroll-view>
    <view class="school-directory-head"><view class="school-directory-count">{{schools.length}}所学校</view><view class="school-directory-order">IB重点优先，其余按课程归类</view></view>
    <view class="guide-list school-brand-list">
    <block wx:for="{{schools}}" wx:key="slug" wx:for-index="schoolIndex">
    <view class="guide-row" wx:if="{{schoolIndex < 12 || showAllSchools || query}}">
      <view class="guide-row-main">
        <view data-slug="{{item.slug}}" bindtap="openSchool">
          <view class="guide-row-title">{{item.nameZh}}</view>
          <view class="guide-row-name-en">{{item.name}}</view>
          <view class="guide-tier-label first">{{item.browseLabel}}</view>
          <view class="guide-tier-label" wx:if="{{item.campusCountText}}">{{item.campusCountText}}</view>
          <view class="guide-row-note" wx:if="{{item.studentPass}}">{{item.studentPass.label}}</view>
        </view>
      </view>
      <button class="guide-favorite" data-slug="{{item.slug}}" bindtap="toggleFavorite">
        {{item.favorite ? "已加入" : "加入方案"}}
      </button>
      <view class="guide-arrow" data-slug="{{item.slug}}" bindtap="openSchool">›</view>
    </view>
    </block>
    </view>
    <button class="school-show-all" wx:if="{{schools.length > 12 && !showAllSchools && !query}}" bindtap="showAllSchools">查看全部{{schools.length}}所</button>
    <view class="guide-empty" wx:if="{{!loading && schools.length === 0}}">没有匹配学校</view>
  </view>

  <view wx:else>
    <scroll-view class="school-subcategory-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{institutionGroups.length}}">
      <view class="guide-tier-tabs school-subcategory-tabs">
        <view class="guide-tier-tab {{institutionGroup === item.id ? 'active' : ''}}" wx:for="{{institutionGroups}}" wx:key="id" data-group="{{item.id}}" bindtap="selectInstitutionGroup">{{item.title}}</view>
      </view>
    </scroll-view>
    <view class="school-directory-count">{{institutionTotal}}个学校与教育档案</view>
    <view class="institution-directory">
      <view class="institution-row" wx:for="{{institutions}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openInstitution">
        <view class="institution-row-main"><view class="institution-row-name">{{item.nameZh}}</view><view class="institution-row-en" wx:if="{{item.name !== item.nameZh}}">{{item.name}}</view><view class="institution-row-summary">{{item.summary}}</view><view class="institution-row-badges"><text wx:for="{{item.badges}}" wx:key="*this" wx:for-item="badge" wx:for-index="badgeIndex" wx:if="{{badgeIndex < 2}}">{{badge}}</text></view></view><view class="guide-arrow">›</view>
      </view>
    </view>
    <button class="school-show-all" loading="{{institutionLoading}}" wx:if="{{institutionHasMore}}" bindtap="loadMoreInstitutions">继续查看</button>
    <view class="guide-empty" wx:if="{{!institutionLoading && institutionTotal === 0}}">没有匹配的学校或教育机构</view>
  </view>

  <view class="school-source-note">资料按政府与学校公开信息整理并定期更新。</view>
</view>
<guide-nav active="schools" />
