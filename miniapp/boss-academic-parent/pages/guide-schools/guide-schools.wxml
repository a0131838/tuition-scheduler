<view class="guide-page">
  <view class="guide-hero">
    <view class="guide-kicker">找学校</view>
    <view class="guide-title">新加坡国际学校</view>
    <view class="guide-subtitle">搜索或按梯队筛选。</view>
  </view>
  <view class="guide-search">
    <input class="guide-input" value="{{query}}" bindinput="inputQuery" placeholder="搜索学校英文名" />
  </view>
  <view class="guide-tier-tabs">
    <view class="guide-tier-tab {{tier === 'ALL' ? 'active' : ''}}" data-tier="ALL" bindtap="setTier">全部</view>
    <view class="guide-tier-tab {{tier === 'FIRST' ? 'active' : ''}}" data-tier="FIRST" bindtap="setTier">第一梯队</view>
    <view class="guide-tier-tab {{tier === 'UNASSIGNED' ? 'active' : ''}}" data-tier="UNASSIGNED" bindtap="setTier">待分梯队</view>
  </view>
  <view class="guide-list">
    <view class="guide-row" wx:for="{{schools}}" wx:key="slug">
      <view class="guide-row-main">
        <view data-slug="{{item.slug}}" bindtap="openSchool">
          <view class="guide-row-title">{{item.name}}</view>
          <view class="guide-tier-label {{item.editorialTier === 1 ? 'first' : ''}}">{{item.editorialTier === 1 ? "第一梯队" : "待分梯队"}}</view>
          <view class="guide-row-note">{{item.verifiedFacts[0]}}</view>
        </view>
      </view>
      <button class="guide-favorite" data-slug="{{item.slug}}" bindtap="toggleFavorite">
        {{item.favorite ? "已加入" : "加入方案"}}
      </button>
      <view class="guide-arrow" data-slug="{{item.slug}}" bindtap="openSchool">›</view>
    </view>
  </view>
  <view class="guide-empty" wx:if="{{!loading && schools.length === 0}}">没有匹配学校</view>
</view>
<guide-nav active="schools" />
