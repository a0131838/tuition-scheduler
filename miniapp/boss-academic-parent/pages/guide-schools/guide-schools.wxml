<view class="guide-page">
  <view class="guide-hero">
    <view class="guide-kicker">找学校</view>
    <view class="guide-title">新加坡学校与教育机构</view>
    <view class="guide-subtitle">按教育阶段和学校类型选择。</view>
  </view>

  <view class="guide-section">
    <view class="guide-section-title">从学前到大学</view>
    <view class="guide-section-note">政府学校以MOE为准，学前教育以ECDA为准，私立教育机构以SSG为准。</view>
    <view class="guide-sector-group" wx:for="{{sectorGroups}}" wx:key="stage" wx:for-item="group">
      <view class="guide-sector-stage">{{group.stage}}</view>
      <view
        class="guide-sector-card"
        wx:for="{{group.sectors}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-url="{{item.officialUrl}}"
        bindtap="openSector"
      >
        <view class="guide-sector-authority">{{item.authority}}</view>
        <view class="guide-sector-title">{{item.title}}</view>
        <view class="guide-sector-summary">{{item.summary}}</view>
        <view class="guide-sector-includes">{{item.includesText}}</view>
        <view class="guide-sector-action">{{item.id === "international-schools" ? "查看详细目录" : "复制官方链接"}} ›</view>
      </view>
    </view>
  </view>

  <view class="guide-section" id="international-directory">
    <view class="guide-section-title">国际学校完整目录</view>
    <view class="guide-section-note">当前43条学校与校区记录均有独立中英文档案；未公开数据会明确留空，不使用估算值。</view>
  </view>
  <view class="guide-search">
    <input class="guide-input" value="{{query}}" bindinput="inputQuery" placeholder="搜索学校中文名或英文名" />
  </view>
  <view class="guide-tier-tabs">
    <view class="guide-tier-tab {{tier === 'ALL' ? 'active' : ''}}" data-tier="ALL" bindtap="setTier">全部</view>
    <view class="guide-tier-tab {{tier === 'FIRST' ? 'active' : ''}}" data-tier="FIRST" bindtap="setTier">第一梯队</view>
    <view class="guide-tier-tab {{tier === 'UNASSIGNED' ? 'active' : ''}}" data-tier="UNASSIGNED" bindtap="setTier">待分梯队</view>
  </view>
  <view class="guide-list">
    <view class="guide-row" wx:for="{{schools}}" wx:key="slug">
      <view class="guide-row-main">
        <view data-slug="{{item.slug}}" bindtap="openSchool">
          <view class="guide-row-title">{{item.nameZh}}</view>
          <view class="guide-row-name-en">{{item.name}}</view>
          <view class="guide-tier-label first" wx:if="{{item.editorialTier === 1}}">第一梯队</view>
          <view class="guide-row-note">{{item.verifiedFacts[0]}}</view>
        </view>
      </view>
      <button class="guide-favorite" data-slug="{{item.slug}}" bindtap="toggleFavorite">
        {{item.favorite ? "已加入" : "加入方案"}}
      </button>
      <view class="guide-arrow" data-slug="{{item.slug}}" bindtap="openSchool">›</view>
    </view>
  </view>
  <view class="guide-empty" wx:if="{{!loading && schools.length === 0}}">没有匹配学校</view>
</view>
<guide-nav active="schools" />
