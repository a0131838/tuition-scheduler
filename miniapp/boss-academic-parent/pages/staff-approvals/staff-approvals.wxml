<view class="page ops-page page-enter">
  <view class="ops-hero"><view class="ops-kicker">手机快速处理</view><view class="ops-title">管理审批中心</view><view class="ops-subtitle">只放适合手机核对的高频审批。复杂财务对账仍保留在网页端。</view></view>
  <view class="summary-card"><view class="summary-number">{{managerCount}}</view><view><view class="summary-title">项管理审批待处理</view><view class="summary-hint">{{overdueCount}} 项等待超过 24 小时</view></view></view>
  <view class="ops-section"><view class="ops-card {{item.cardClass}}" wx:for="{{items}}" wx:key="key"><view class="ops-card-head"><view><view class="ops-card-title">{{item.title}}</view><view class="ops-card-meta">{{item.subtitle}}</view><view class="ops-card-meta">已等待 {{item.waitingHours}} 小时 · {{item.statusText}}</view></view><view class="ops-badge {{item.cardClass}}">{{item.type}}</view></view><view class="amount">{{item.amountDisplay}}</view><view class="risk-note" wx:if="{{item.riskText}}">{{item.riskText}}</view><view class="ops-actions" wx:if="{{item.canAct}}"><button class="ops-secondary" wx:if="{{item.canReject}}" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="reject">退回</button><button class="ops-primary" loading="{{saving}}" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="approve">审批通过</button></view><view class="draft-note" wx:else>该项需要完整网页对账，小程序仅做提醒。</view></view><view class="empty-state" wx:if="{{showEmpty}}">当前没有需要您处理的审批</view></view>
</view>
