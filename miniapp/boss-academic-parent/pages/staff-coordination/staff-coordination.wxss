.page {
  padding: 28rpx;
  min-height: 100vh;
  background: #f7f9f4;
}

.top {
  margin-bottom: 22rpx;
}

.eyebrow,
.hint,
.subtitle {
  color: #6b7280;
  font-size: 24rpx;
}

.title {
  color: #123d2b;
  font-size: 36rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.summary-band {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1rpx solid #dce5d8;
  border-bottom: 1rpx solid #dce5d8;
  padding: 22rpx 0;
  margin-bottom: 22rpx;
}

.metric {
  color: #123d2b;
  font-size: 42rpx;
  font-weight: 800;
}

.overdue-number,
.overdue {
  color: #b42318;
}

.filters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.picker,
input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid #d6ded2;
  border-radius: 8rpx;
  background: #fff;
  padding: 18rpx;
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.search-button,
.clear-button {
  min-height: 76rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 25rpx;
  padding: 0 20rpx;
}

.search-button {
  background: #0b3d2a;
  color: #fff;
}

.clear-button {
  background: #edf2ea;
  color: #123d2b;
}

.card {
  background: #fff;
  border: 1rpx solid #dce5d8;
  border-radius: 8rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.ticket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.ticket-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pill {
  background: #edf2ea;
  color: #123d2b;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.status-pill {
  background: #f0f2f5;
  color: #374151;
}

.due {
  font-size: 23rpx;
  font-weight: 700;
}

.value {
  color: #20352b;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.next-action {
  color: #374151;
  line-height: 1.55;
  margin: 12rpx 0;
  overflow-wrap: anywhere;
}

.empty {
  color: #6b7280;
  text-align: center;
  padding: 80rpx 20rpx;
}
