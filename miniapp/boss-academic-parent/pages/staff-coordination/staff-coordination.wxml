<view class="page">
  <view class="top">
    <view class="eyebrow">教务排课</view>
    <view class="title">排课与调课</view>
  </view>

  <view class="summary-band">
    <view>
      <view class="metric">{{totalOpenText}}</view>
      <view class="hint">开放工单</view>
    </view>
    <view>
      <view class="metric overdue-number">{{overdueText}}</view>
      <view class="hint">已逾期</view>
    </view>
  </view>

  <view class="filters">
    <picker mode="selector" range="{{scopes}}" range-key="label" value="{{scopeIndex}}" bindchange="changeScope">
      <view class="picker">{{scopes[scopeIndex].label}}</view>
    </picker>
    <picker mode="selector" range="{{owners}}" value="{{ownerIndex}}" bindchange="changeOwner">
      <view class="picker">{{owners[ownerIndex]}}</view>
    </picker>
  </view>

  <view class="search-row">
    <view class="search-input-wrap">
      <input class="search-input" value="{{query}}" bindinput="inputQuery" bindconfirm="search" confirm-type="search" placeholder="学生、课程或工单号" />
      <view class="search-clear" wx:if="{{query}}" catchtap="clearSearch">×</view>
    </view>
    <view class="search-submit" bindtap="search">查询</view>
  </view>
  <view class="search-status" wx:if="{{loading}}">正在查询…</view>

  <block wx:if="{{tickets.length}}">
    <view wx:for="{{tickets}}" wx:key="id" class="card ticket-card" bindtap="openDetail" data-id="{{item.id}}">
      <view class="ticket-head">
        <view class="ticket-tags">
          <view class="pill">{{item.type}}</view>
          <view class="pill status-pill">{{item.statusLabel}}</view>
        </view>
        <view class="due overdue" wx:if="{{item.isOverdue}}">已逾期</view>
        <view class="due" wx:else>{{item.nextActionDueText}}</view>
      </view>
      <view class="value">{{item.studentName}} · {{item.course}}</view>
      <view class="next-action">{{item.nextAction}}</view>
      <view class="subtitle">{{item.ticketNo}} · {{item.owner}} · {{item.teacher}}</view>
    </view>
  </block>
  <view wx:else class="empty">暂无匹配的排课工单</view>
</view>
