<view class="page">
  <view class="top">
    <view class="eyebrow">{{studentName}}</view>
    <view class="title">提交请求</view>
    <view class="subtitle">我们已收到你的请求，工作人员会尽快跟进。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">请求类型</view>
      <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker">{{types[typeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">你想告诉我们什么</view>
      <textarea class="textarea" value="{{content}}" placeholder="请尽量写清楚背景、希望处理的事项和紧急程度" bindinput="onContentInput" />
    </view>
    <view class="field">
      <view class="label">希望工作人员怎么处理</view>
      <textarea class="textarea" value="{{requiredAction}}" placeholder="可选填写" bindinput="onActionInput" />
    </view>
    <view class="field">
      <view class="label">附件</view>
      <button class="btn secondary" bindtap="chooseFiles">选择图片/文件</button>
      <view class="label" wx:if="{{files.length}}">已选择 {{files.length}} 个附件</view>
    </view>
    <button class="btn" loading="{{loading}}" bindtap="submit">提交</button>
  </view>
</view>
