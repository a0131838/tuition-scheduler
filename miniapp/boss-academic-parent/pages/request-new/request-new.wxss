.form-section{padding-top:4rpx}.field-label{margin:27rpx 0 10rpx;color:#3e4541;font-size:23rpx;font-weight:780}.picker,.request-input{box-sizing:border-box;width:100%;border:1rpx solid #d4d1cb;border-radius:12rpx;background:#fff;font-size:25rpx}.picker{min-height:78rpx;padding:20rpx}.request-input{min-height:250rpx;padding:20rpx;line-height:1.6}.urgency-switch{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.urgency-option{padding:20rpx;border:1rpx solid #d6d3cd;border-radius:12rpx;background:#fff}.urgency-option.active{border-color:#287a62;background:#edf7f2}.urgency-option.urgent{border-color:#c56a25;background:#fff6ed}.urgency-title{font-size:25rpx;font-weight:800}.urgency-note{margin-top:5rpx;color:#777d79;font-size:20rpx}.file-button{min-height:72rpx;margin:0;border:1rpx solid #d1cec8;border-radius:12rpx;background:#fff;color:#343936;font-size:23rpx;font-weight:730;line-height:72rpx}.file-count{margin-top:9rpx;color:#287a62;font-size:21rpx}.response-note{margin-top:26rpx;color:#777d79;font-size:21rpx;line-height:1.6}.submit-button{min-height:82rpx;margin-top:22rpx;border-radius:12rpx;background:#ec5e0a;color:#fff;font-size:25rpx;font-weight:800;line-height:82rpx}
