.filter-scroll { width: 100%; white-space: nowrap; margin-bottom: 16rpx; }
.filter-row { display: inline-flex; gap: 12rpx; }
.filter { width: auto; min-height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 999rpx; background: #ebe8e3; color: #52565d; font-size: 24rpx; line-height: 64rpx; }
.filter.active { background: #202328; color: #fff; }
.task { margin-top: 18rpx; padding: 24rpx; background: #fff; border-top: 6rpx solid #d8d5d0; border-radius: 14rpx; box-shadow: 0 8rpx 22rpx rgba(32,35,40,.045); }
.task.attention { border-top-color: #c52222; }
.task-head { display: flex; justify-content: space-between; gap: 16rpx; }
.task-kind { color: #c2410c; font-size: 22rpx; font-weight: 800; }
.task-title { margin-top: 8rpx; font-size: 30rpx; font-weight: 800; line-height: 1.4; }
.task-owner { margin-top: 6rpx; color: #747982; font-size: 23rpx; }
.latest-history { margin-top: 12rpx; color: #6b7280; font-size: 22rpx; }
.automatic-status { margin-top: 8rpx; color: #334155; font-size: 22rpx; font-weight: 650; }
.mini-action { width: auto; min-width: 100rpx; height: 62rpx; margin: 0; padding: 0 18rpx; background: #202328; color: #fff; border-radius: 10rpx; font-size: 23rpx; line-height: 62rpx; }
.review,.send { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e4e1dc; }
.section-label { margin: 14rpx 0 8rpx; color: #646a73; font-size: 23rpx; font-weight: 750; }
.original,.message { padding: 18rpx; background: #f6f4f1; border-radius: 10rpx; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; }
.message { border-left: 6rpx solid #ec5e0a; }
.editor { width: 100%; min-height: 260rpx; box-sizing: border-box; padding: 18rpx; border: 1rpx solid #f5a56d; border-radius: 10rpx; font-size: 26rpx; line-height: 1.55; }
.review-note { margin-top: 12rpx; color: #b91c1c; font-size: 24rpx; }
.compact { min-height: 72rpx; margin-top: 12rpx; padding: 14rpx 18rpx; font-size: 25rpx; }
.action-row,.action-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.action-grid .action { width: calc(50% - 6rpx); }
.action { width: auto; min-height: 70rpx; margin: 0; padding: 0 20rpx; border-radius: 10rpx; background: #ebe8e3; color: #272a2f; font-size: 24rpx; line-height: 70rpx; }
.action.primary,.confirm { background: #ec5e0a; color: #fff; }
.confirm { width: 100%; min-height: 82rpx; margin-top: 18rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 750; }
.published { margin-top: 14rpx; color: #166534; font-size: 24rpx; font-weight: 750; }
.evidence { margin-top: 10rpx; color: #1d4ed8; font-size: 23rpx; }
