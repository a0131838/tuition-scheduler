.workflow-scroll,.filter-scroll { width: 100%; white-space: nowrap; margin-bottom: 18rpx; }
.workflow-row,.filter-row { display: inline-flex; gap: 12rpx; }
.workflow { width: 190rpx; min-height: 116rpx; margin: 0; padding: 16rpx 18rpx; border: 1rpx solid #dedbd6; border-radius: 14rpx; background: #fff; color: #202328; text-align: left; line-height: 1.2; }
.workflow.active { background: #202328; border-color: #202328; color: #fff; }
.workflow.urgent:not(.active) { border-color: #c52222; color: #a61b1b; }
.workflow-count { font-size: 34rpx; font-weight: 850; }.workflow-label { margin-top: 8rpx; font-size: 23rpx; font-weight: 750; }
.filter { width: auto; min-height: 60rpx; margin: 0; padding: 0 22rpx; border-radius: 999rpx; background: #ebe8e3; color: #52565d; font-size: 23rpx; line-height: 60rpx; }
.filter.active { background: #ec5e0a; color: #fff; }
.task { margin-top: 12rpx; background: #fff; border-top: 3rpx solid #d8d5d0; border-radius: 12rpx; }
.task.attention { border-top-color: #c52222; }
.task-summary { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; padding: 24rpx; }
.task-main { min-width: 0; }.task-meta { display: flex; gap: 10rpx; align-items: center; }.task-kind { color: #c2410c; font-size: 22rpx; font-weight: 800; }.task-status { color: #646a73; font-size: 21rpx; }
.task-title { margin-top: 8rpx; font-size: 31rpx; font-weight: 850; }.task-date { margin-top: 5rpx; color: #27364a; font-size: 25rpx; font-weight: 750; }.task-owner { margin-top: 6rpx; color: #747982; font-size: 22rpx; }
.task-open { flex-shrink: 0; color: #9b3e08; font-size: 24rpx; font-weight: 800; }
.task-detail { padding: 0 24rpx 26rpx; border-top: 1rpx solid #e4e1dc; }.detail-title { margin-top: 20rpx; font-size: 28rpx; font-weight: 800; }.latest-history,.automatic-status { margin-top: 9rpx; color: #64748b; font-size: 22rpx; }.automatic-status { color: #334155; font-weight: 650; }
.feedback-flow { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 10rpx; font-size: 25rpx; font-weight: 850; }.feedback-flow.review-step { background: #fff4eb; color: #b54708; }.feedback-flow.send-step { background: #1f242b; color: #fff; }
.claim { width: 100%; min-height: 68rpx; margin: 16rpx 0 0; background: #202328; color: #fff; border-radius: 10rpx; font-size: 24rpx; line-height: 68rpx; }
.change-card { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e4e1dc; }
.change-purpose { padding: 18rpx; border-radius: 12rpx; background: #fff3ed; border-left: 6rpx solid #ec5e0a; }
.change-purpose-label { color: #9b3e08; font-size: 22rpx; font-weight: 850; }.change-purpose-text { margin-top: 8rpx; color: #3f332d; font-size: 24rpx; line-height: 1.6; }
.change-type-row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin: 20rpx 0 12rpx; }.change-type { padding: 8rpx 14rpx; border-radius: 999rpx; background: #202328; color: #fff; font-size: 23rpx; font-weight: 850; }.change-state { color: #a61b1b; font-size: 22rpx; font-weight: 800; }
.schedule-compare { display: grid; gap: 10rpx; }.schedule-box { padding: 18rpx; border-radius: 12rpx; }.schedule-box.previous { background: #f5f2ef; border: 1rpx solid #ddd7d1; color: #6d625b; }.schedule-box.current { background: #edf8f0; border: 2rpx solid #65a877; color: #173f26; }.schedule-box.current.cancelled { background: #fff1f0; border-color: #d15b55; color: #841f1a; }
.schedule-kicker { font-size: 21rpx; font-weight: 850; }.schedule-line,.no-replacement { margin-top: 9rpx; font-size: 25rpx; font-weight: 750; line-height: 1.55; }.change-arrow { color: #ec5e0a; font-size: 36rpx; font-weight: 900; text-align: center; line-height: 1; }
.change-trace { margin-top: 14rpx; padding: 16rpx; border-radius: 10rpx; background: #f7f8fa; color: #59616c; font-size: 21rpx; line-height: 1.65; }.change-next { margin-top: 14rpx; padding: 16rpx; border-radius: 10rpx; background: #202328; color: #fff; font-size: 23rpx; font-weight: 750; line-height: 1.55; }
.review,.send { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e4e1dc; }
.completeness { display: grid; gap: 5rpx; padding: 16rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: 750; }.completeness.complete { background: #edf8f0; color: #166534; }.completeness.incomplete { background: #fff1f0; color: #a61b1b; }
.feedback-section { padding: 16rpx 0; border-bottom: 1rpx solid #ece9e4; }.section-label { margin: 10rpx 0 7rpx; color: #646a73; font-size: 22rpx; font-weight: 800; }.section-value { color: #202328; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; }
.original-toggle { margin-top: 16rpx; }.original,.message { max-height: 520rpx; overflow: auto; padding: 18rpx; background: #f6f4f1; border-radius: 10rpx; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; }.message { border-left: 6rpx solid #ec5e0a; }
.send-heading { margin-bottom: 8rpx; color: #171a1f; font-size: 28rpx; font-weight: 850; }.send-instruction { margin-bottom: 14rpx; padding: 16rpx; background: #fff4eb; border-left: 6rpx solid #ec5e0a; color: #7c2d12; font-size: 23rpx; line-height: 1.55; }
.send-instruction.urgent-copy { background: #fff1f0; border-left-color: #c52222; color: #841f1a; }
.editor { width: 100%; min-height: 320rpx; box-sizing: border-box; padding: 18rpx; border: 1rpx solid #f5a56d; border-radius: 10rpx; font-size: 25rpx; line-height: 1.6; }
.review-note { margin-top: 12rpx; color: #b91c1c; font-size: 24rpx; }.compact { min-height: 72rpx; margin-top: 12rpx; padding: 14rpx 18rpx; font-size: 25rpx; }
.action-row,.action-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }.action-grid .action { width: calc(50% - 6rpx); }.action { width: auto; min-height: 70rpx; margin: 0; padding: 0 20rpx; border-radius: 10rpx; background: #ebe8e3; color: #272a2f; font-size: 24rpx; line-height: 70rpx; }.action.primary,.confirm { background: #ec5e0a; color: #fff; }
.action.primary-soft { background: #fff0e6; color: #b84308; font-weight: 800; }
.confirm { width: 100%; min-height: 82rpx; margin-top: 18rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 750; }.published { margin-top: 14rpx; color: #166534; font-size: 24rpx; font-weight: 750; }.evidence { margin-top: 10rpx; color: #1d4ed8; font-size: 23rpx; }
.share-card-note { margin: 16rpx 0; padding: 16rpx 18rpx; border-left: 6rpx solid #2f6b4f; background: #ecfdf3; color: #176b3a; font-size: 24rpx; line-height: 1.55; }
.share-card { margin: 16rpx 0 8rpx; background: #ec5e0a; color: #fff; font-weight: 800; border-radius: 10rpx; }
