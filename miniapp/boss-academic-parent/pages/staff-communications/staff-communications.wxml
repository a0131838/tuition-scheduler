<view class="page page-enter">
  <view class="top">
    <view class="eyebrow">教务沟通与提醒 / COMMUNICATION</view>
    <view class="title">沟通与提醒工作台</view>
    <view class="subtitle">先选工作队列，再处理审核、发送或更正。</view>
  </view>

  <scroll-view class="workflow-scroll" scroll-x>
    <view class="workflow-row">
      <button wx:for="{{workstreams}}" wx:key="value" class="workflow {{kind === item.value ? 'active' : ''}} {{item.value === 'COURSE_CHANGE' && item.count ? 'urgent' : ''}}" data-value="{{item.value}}" bindtap="changeKind">
        <view class="workflow-count">{{item.count}}</view><view class="workflow-label">{{item.label}}</view>
      </button>
    </view>
  </scroll-view>

  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-row"><button wx:for="{{filters}}" wx:key="value" class="filter {{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeFilter">{{item.label}}</button></view>
  </scroll-view>

  <view class="task {{item.isAttention ? 'attention' : ''}}" wx:for="{{tasks}}" wx:key="id" wx:for-index="idx">
    <view class="task-summary" data-id="{{item.id}}" bindtap="toggleTask">
      <view class="task-main">
        <view class="task-meta"><text class="task-kind">{{item.kindLabel}}</text><text class="task-status">{{item.statusLabel}}</text></view>
        <view class="task-title">{{item.recipientLabel}}</view>
        <view class="task-date">{{item.dateLabel || '课程日期待确认'}}</view>
        <view class="task-owner">负责人：{{item.ownerName || '未领取'}}<text wx:if="{{item.completenessLabel}}"> · 完整度 {{item.completenessLabel}}</text></view>
      </view>
      <view class="task-open">{{expandedId === item.id ? '收起' : '处理'}} ›</view>
    </view>

    <view class="task-detail" wx:if="{{expandedId === item.id}}">
      <view class="detail-title">{{item.title}}</view>
      <view class="latest-history" wx:if="{{item.latestHistoryText}}">最近操作：{{item.latestHistoryText}}</view>
      <view class="automatic-status">{{item.automaticStatusText}} · 人工微信：{{item.isCompleted ? '已发送' : '待处理'}}</view>
      <button class="claim" wx:if="{{!item.isCompleted}}" data-id="{{item.id}}" bindtap="claim">领取这项任务</button>

      <view class="review" wx:if="{{item.isFeedback && item.feedback}}">
        <view class="completeness {{item.missingText ? 'incomplete' : 'complete'}}"><text>反馈完整度 {{item.completenessLabel}}</text><text>{{item.missingText || '内容完整，可以审核'}}</text></view>
        <view class="feedback-section" wx:for="{{item.feedbackSectionRows}}" wx:key="key"><view class="section-label">{{item.label}}</view><view class="section-value">{{item.value}}</view></view>
        <view class="original-toggle"><view class="section-label">老师完整原文（只读）</view><view class="original">{{item.feedback.content}}</view></view>
        <view class="section-label">家长最终展示版</view>
        <textarea class="editor" value="{{item.parentContentDraft}}" data-index="{{idx}}" bindinput="inputParentContent" auto-height maxlength="-1" />
        <view class="review-note" wx:if="{{item.feedback.reviewNote}}">退回原因：{{item.feedback.reviewNote}}</view>
        <view class="action-row" wx:if="{{item.feedbackNeedsPublish}}"><button class="action primary" data-index="{{idx}}" bindtap="publish">审核并发布</button><button class="action" data-id="{{item.id}}" bindtap="returnFeedback">退回老师</button></view>
        <view class="published" wx:else>已发布到家长小程序</view>
      </view>

      <view class="send" wx:if="{{item.canSend}}">
        <view class="section-label">{{item.isTeacherReminder ? '发给老师的微信文案' : '发到家长群的微信文案'}}</view><view class="message">{{item.messageText}}</view>
        <input class="input compact" value="{{item.groupDraft}}" data-index="{{idx}}" bindinput="inputGroup" placeholder="{{item.isTeacherReminder ? '老师微信' : '家长群名称'}}" />
        <input class="input compact" value="{{item.noteDraft}}" data-index="{{idx}}" bindinput="inputNote" placeholder="备注（可选）" />
        <view class="action-grid"><button class="action" data-index="{{idx}}" bindtap="copyMessage">复制文案</button><button class="action" data-id="{{item.id}}" bindtap="saveImage">保存转发图片</button><button class="action" data-id="{{item.id}}" bindtap="uploadEvidence">上传发送截图</button><button class="action" data-id="{{item.id}}" bindtap="retry">重试自动提醒</button></view>
        <button class="confirm" wx:if="{{!item.isCompleted}}" data-index="{{idx}}" bindtap="markSent">确认已人工发送</button>
        <view class="published" wx:else>已完成人工发送</view>
        <view class="evidence" wx:if="{{item.evidenceUrl}}">发送截图已留档</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !tasks.length}}">这个工作队列当前没有任务</view>
</view>
