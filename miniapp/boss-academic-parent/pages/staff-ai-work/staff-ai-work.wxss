.page{min-height:100vh;background:#f3f7f5;padding:28rpx;box-sizing:border-box;color:#18332c}.hero{background:#0c3b31;color:#fff;border-radius:28rpx;padding:34rpx}.eyebrow,.case-kicker,.next-label{font-size:22rpx;color:#35d39a;font-weight:700}.title{font-size:44rpx;font-weight:800;margin:8rpx 0}.subtitle{font-size:25rpx;line-height:1.65;color:#d7ebe4}.notice,.blocker{margin-top:22rpx;padding:22rpx;border-radius:18rpx;background:#fff1d6;color:#754b00}.queue{margin:24rpx 0;white-space:nowrap}.queue-row{display:flex;gap:16rpx}.queue-item{display:inline-block;width:300rpx;background:#fff;border:2rpx solid transparent;border-radius:22rpx;padding:22rpx;white-space:normal}.queue-item.active{border-color:#16b982}.queue-name{font-weight:800;font-size:28rpx}.queue-next{font-size:22rpx;color:#687b75;margin-top:8rpx}.case{background:#fff;border-radius:28rpx;padding:30rpx}.case-title{font-size:40rpx;font-weight:800;margin:8rpx 0 20rpx}.summary{font-size:27rpx;line-height:1.7;padding-bottom:24rpx;border-bottom:1rpx solid #dbe6e2}.next-label{margin-top:26rpx}.next{font-size:32rpx;font-weight:800;margin:10rpx 0 24rpx}.primary{background:#10b981!important;color:#fff!important;border-radius:18rpx;font-weight:800}.safe{font-size:21rpx;color:#75857f;line-height:1.5;margin-top:18rpx}.empty{text-align:center;color:#71817b;padding:100rpx 0}
.decision{margin:22rpx 0;padding:22rpx;background:#f2f8f5;border-radius:18rpx}.decision-label{font-size:24rpx;font-weight:800;margin-bottom:14rpx}.picker,.input{background:#fff;border:1rpx solid #cbdad4;border-radius:14rpx;padding:20rpx;font-size:25rpx}.input{box-sizing:border-box;width:100%;margin-top:16rpx;min-height:76rpx}.radios{display:flex;gap:34rpx;margin:10rpx 0 18rpx;font-size:25rpx}
