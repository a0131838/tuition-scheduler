.page{min-height:100vh;background:#f3f7f5;padding:28rpx;box-sizing:border-box;color:#18332c}.hero{background:#0c3b31;color:#fff;border-radius:28rpx;padding:34rpx}.eyebrow,.case-kicker,.next-label{font-size:22rpx;color:#35d39a;font-weight:700}.title{font-size:44rpx;font-weight:800;margin:8rpx 0}.subtitle{font-size:25rpx;line-height:1.65;color:#d7ebe4}.notice,.blocker{margin-top:22rpx;padding:22rpx;border-radius:18rpx;background:#fff1d6;color:#754b00}.queue{margin:24rpx 0;display:flex;flex-direction:column;gap:14rpx}.queue-item{width:100%;box-sizing:border-box;background:#fff;border:2rpx solid transparent;border-radius:20rpx;padding:22rpx}.queue-item.active{border-color:#16b982;background:#f0fbf7}.queue-top{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.queue-name{font-weight:800;font-size:28rpx}.queue-type{font-size:20rpx;color:#087957;background:#ddf7ed;border-radius:999rpx;padding:7rpx 13rpx;white-space:nowrap}.queue-next{font-size:23rpx;color:#516b63;margin-top:9rpx;line-height:1.45}.queue-due{font-size:20rpx;color:#956100;margin-top:7rpx}.case{background:#fff;border-radius:28rpx;padding:30rpx}.case-title{font-size:40rpx;font-weight:800;margin:8rpx 0 20rpx}.summary{font-size:27rpx;line-height:1.7;padding-bottom:24rpx;border-bottom:1rpx solid #dbe6e2}.next-label{margin-top:26rpx}.next{font-size:32rpx;font-weight:800;margin:10rpx 0 24rpx}.primary{background:#10b981!important;color:#fff!important;border-radius:18rpx;font-weight:800}.secondary{background:#eef5f2!important;color:#25483f!important;border-radius:18rpx;font-weight:700}.safe{font-size:21rpx;color:#75857f;line-height:1.5;margin-top:18rpx}.empty{text-align:center;color:#71817b;padding:100rpx 0}
.decision{margin:22rpx 0;padding:22rpx;background:#f2f8f5;border-radius:18rpx}.decision-label{font-size:24rpx;font-weight:800;margin-bottom:14rpx}.picker,.input{background:#fff;border:1rpx solid #cbdad4;border-radius:14rpx;padding:20rpx;font-size:25rpx}.input{box-sizing:border-box;width:100%;margin-top:16rpx;min-height:76rpx}.radios{display:flex;gap:34rpx;margin:10rpx 0 18rpx;font-size:25rpx}
.review{margin-top:24rpx;padding:24rpx;background:#f5faf8;border:2rpx solid #b8dfd2;border-radius:20rpx}.review-title{font-size:30rpx;font-weight:800}.review-count{font-size:22rpx;color:#557168;margin:8rpx 0 18rpx}.review-line{font-size:23rpx;line-height:1.5;padding:7rpx 0}.calendar{margin-top:24rpx;overflow-x:auto}.calendar-title{font-size:28rpx;font-weight:800;margin-bottom:12rpx}.week-head,.month-grid{display:grid;grid-template-columns:repeat(7,minmax(92rpx,1fr));min-width:644rpx}.week-head view{text-align:center;font-size:19rpx;color:#6a7d76;padding:8rpx 0}.day{min-height:105rpx;border:1rpx solid #d8e6e1;padding:7rpx;box-sizing:border-box;background:#fff}.day.blank{background:#f3f7f5}.day-number{font-size:19rpx;color:#587068}.event{margin-top:5rpx;padding:6rpx;background:#dff7ed;border-left:4rpx solid #10b981;border-radius:7rpx;font-size:16rpx;line-height:1.3}.review-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:14rpx;margin-top:24rpx}
