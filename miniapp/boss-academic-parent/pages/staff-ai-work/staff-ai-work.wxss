.page{min-height:100vh;background:#f6f4f1;padding:28rpx 30rpx 56rpx;box-sizing:border-box;color:#202328}.queue-header{display:grid;grid-template-columns:1fr auto;align-items:end;padding:18rpx 2rpx 24rpx;border-bottom:1rpx solid #dedbd6}.eyebrow,.case-kicker,.next-label{font-size:22rpx;color:#ec5e0a;font-weight:750}.title{font-size:42rpx;font-weight:800;margin-top:6rpx;color:#17191d}.subtitle{grid-column:1/-1;margin-top:12rpx;font-size:24rpx;line-height:1.55;color:#6b6f76}.queue-count{font-size:23rpx;font-weight:750;color:#9b3e08;background:#fff0e7;border-radius:999rpx;padding:8rpx 16rpx}.notice,.blocker{margin:18rpx 0;padding:20rpx 22rpx;border-radius:14rpx;background:#fff0df;color:#84420e}.queue{display:flex;flex-direction:column}.queue-item{width:100%;box-sizing:border-box;padding:25rpx 2rpx 24rpx;border-bottom:1rpx solid #dedbd6}.queue-item:active{background:#fff8f2}.queue-top{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.queue-name{font-weight:800;font-size:30rpx;color:#202328}.queue-type{font-size:20rpx;color:#a6450d;background:#fff0e7;border-radius:999rpx;padding:7rpx 13rpx;white-space:nowrap}.queue-bottom{display:flex;align-items:center;gap:14rpx;margin-top:10rpx}.queue-next{flex:1;min-width:0;font-size:23rpx;color:#656b73;line-height:1.45}.queue-arrow{font-size:42rpx;line-height:1;color:#ec5e0a}.queue-due{font-size:20rpx;color:#9b5a25;margin-top:8rpx}.case{background:#fff;border:1rpx solid #e4e1dc;border-radius:18rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(35,39,44,.045)}.case-nav{display:inline-flex;align-items:center;min-height:60rpx;margin:-8rpx 0 18rpx;color:#a6450d;font-size:24rpx;font-weight:750}.back-arrow{font-size:44rpx;line-height:1;margin-right:7rpx}.case-title{font-size:40rpx;font-weight:800;margin:8rpx 0 20rpx}.summary{font-size:27rpx;line-height:1.7;padding-bottom:24rpx;border-bottom:1rpx solid #e4e1dc}.next-label{margin-top:26rpx}.next{font-size:32rpx;font-weight:800;margin:10rpx 0 24rpx}.primary{background:#ec5e0a!important;color:#fff!important;border-radius:14rpx;font-weight:800}.secondary{background:#eae8e4!important;color:#202328!important;border-radius:14rpx;font-weight:700}.safe{font-size:21rpx;color:#7b7f86;line-height:1.5;margin-top:18rpx}.empty{text-align:center;color:#7b7f86;padding:100rpx 0}
.decision{margin:22rpx 0;padding:22rpx;background:#faf8f5;border:1rpx solid #e4e1dc;border-radius:14rpx}.decision-label{font-size:24rpx;font-weight:800;margin-bottom:14rpx}.picker,.input{background:#fff;border:1rpx solid #d8d3cd;border-radius:12rpx;padding:20rpx;font-size:25rpx}.input{box-sizing:border-box;width:100%;margin-top:16rpx;min-height:76rpx}.radios{display:flex;gap:34rpx;margin:10rpx 0 18rpx;font-size:25rpx}
.review{margin-top:24rpx;padding:24rpx;background:#fffaf6;border:2rpx solid #f1c7b0;border-radius:16rpx}.review-title{font-size:30rpx;font-weight:800}.review-count{font-size:22rpx;color:#6b6f76;margin:8rpx 0 18rpx}.review-line{font-size:23rpx;line-height:1.5;padding:7rpx 0}.calendar{margin-top:24rpx;overflow-x:auto}.calendar-title{font-size:28rpx;font-weight:800;margin-bottom:12rpx}.week-head,.month-grid{display:grid;grid-template-columns:repeat(7,minmax(92rpx,1fr));min-width:644rpx}.week-head view{text-align:center;font-size:19rpx;color:#6b6f76;padding:8rpx 0}.day{min-height:105rpx;border:1rpx solid #e4e1dc;padding:7rpx;box-sizing:border-box;background:#fff}.day.blank{background:#f6f4f1}.day-number{font-size:19rpx;color:#656b73}.event{margin-top:5rpx;padding:6rpx;background:#fff0e7;border-left:4rpx solid #ec5e0a;border-radius:7rpx;font-size:16rpx;line-height:1.3}.review-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:14rpx;margin-top:24rpx}
.case-type{display:inline-flex;font-size:20rpx;color:#a6450d;background:#fff0e7;border-radius:999rpx;padding:7rpx 13rpx;margin:-8rpx 0 18rpx}.facts{margin:20rpx 0;padding:20rpx;background:#f7f8f7;border-left:5rpx solid #0b7c67;border-radius:10rpx}.facts-title{font-size:23rpx;font-weight:800;color:#0b7c67;margin-bottom:10rpx}.fact-line{font-size:23rpx;line-height:1.55;margin-top:5rpx}.impact-line{font-weight:650}.blocker-title{font-size:25rpx;font-weight:800}.blocker-detail,.blocker-action{font-size:22rpx;line-height:1.5;margin-top:7rpx}.blocker-action{color:#6d3a12}
.section-label{font-size:22rpx;color:#ec5e0a;font-weight:750;margin-top:6rpx}.section-label+.summary{padding-top:10rpx}
.custom-nav{height:calc(88rpx + env(safe-area-inset-top));padding:env(safe-area-inset-top) 30rpx 0;box-sizing:border-box;display:grid;grid-template-columns:80rpx 1fr 80rpx;align-items:center;text-align:center;background:#ec5e0a;color:#fff;font-size:32rpx;font-weight:800;position:sticky;top:0;z-index:20}.custom-back{font-size:58rpx;text-align:left;line-height:1}.nav-space{height:1rpx}.page{min-height:calc(100vh - 88rpx - env(safe-area-inset-top))}.calendar-legend{display:flex;flex-wrap:wrap;gap:12rpx 20rpx;margin:12rpx 0 8rpx;font-size:20rpx;color:#5d6269}.calendar-legend text:before{content:"";display:inline-block;width:17rpx;height:17rpx;margin-right:7rpx;border-radius:4rpx;background:#9aa0a7}.calendar-legend .removed:before{background:#c9524a}.calendar-legend .proposed:before{background:#ec5e0a}.event.existing{background:#eef0f2;border-left-color:#9aa0a7;color:#535961}.event.removed{background:#fff0ef;border-left-color:#c9524a;color:#9a3933;text-decoration:line-through;opacity:.86}.event.proposed{background:#fff0e7;border-left-color:#ec5e0a;color:#8d3508;font-weight:750}
.subject-teacher{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #eadfd6}.subject-name{font-size:30rpx;font-weight:800;margin-bottom:12rpx}.teacher-row{display:grid;grid-template-columns:150rpx 1fr;align-items:center;gap:16rpx;margin-top:12rpx;color:#5b6570}.teacher-row picker{min-width:0}.picker.compact{padding:18rpx 20rpx}.decision-help{margin-top:18rpx;color:#7a818a;font-size:24rpx;line-height:1.6}
.teacher-consents{margin-top:34rpx;padding-top:24rpx;border-top:1rpx solid #dedbd6}.consent-card{margin-top:16rpx;padding:22rpx;background:#fff8f2;border:1rpx solid #f1c7b0;border-radius:16rpx}.consent-title{font-size:27rpx;font-weight:800}.consent-time{font-size:20rpx;color:#8a6c58;margin-top:5rpx}.consent-detail{font-size:23rpx;line-height:1.55;white-space:pre-wrap;margin:14rpx 0}
