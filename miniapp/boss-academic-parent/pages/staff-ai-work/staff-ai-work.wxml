<view class="custom-nav"><view class="custom-back" bindtap="handleBack">‹</view><view>AI 今日工作</view><view class="nav-space"></view></view>
<view class="page">
  <view class="queue-header" wx:if="{{!selected}}">
    <view><view class="eyebrow">待教务确认</view><view class="title">AI 今日工作</view></view>
    <view class="queue-count">{{items.length}} 项</view>
    <view class="subtitle">选择一项查看，确认前不会修改正式数据。</view>
  </view>
  <view class="notice" wx:if="{{message}}">{{message}}</view>
  <view class="empty" wx:if="{{!selected && !loading && !items.length}}">当前没有待处理工单</view>
  <view class="queue" wx:if="{{!selected && items.length}}">
    <view wx:for="{{items}}" wx:key="intakeId" class="queue-item" data-id="{{item.intakeId}}" bindtap="select">
      <view class="queue-top"><view class="queue-name">{{item.title}}</view><view class="queue-type">{{item.workflowLabel}}</view></view>
      <view class="queue-bottom"><view class="queue-next">{{item.next}}</view><view class="queue-arrow">›</view></view>
      <view class="queue-due" wx:if="{{item.dueLabel}}">最晚处理：{{item.dueLabel}}</view>
    </view>
  </view>
  <view class="teacher-consents" wx:if="{{!selected && pendingTeacherConsents.length}}">
    <view class="section-label">紧急安排 · 等老师同意</view>
    <view class="consent-card" wx:for="{{pendingTeacherConsents}}" wx:key="id">
      <view class="consent-title">{{item.studentName}} · {{item.teacherName}}</view><view class="consent-time">{{item.createdAt}}</view>
      <view class="consent-detail">{{item.detail}}</view>
      <button class="secondary" data-id="{{item.id}}" bindtap="recordTeacherConsent" disabled="{{working}}">记录电话/微信确认</button>
    </view>
  </view>
  <view class="case" wx:if="{{selected}}">
    <view class="case-nav" bindtap="backToQueue"><text class="back-arrow">‹</text><text>返回待办</text></view>
    <view class="case-kicker">正式工单</view><view class="case-title">{{selected.title}}</view>
    <view class="case-type">{{selected.workflowLabel}}</view>
    <view class="section-label">家长希望怎么处理</view>
    <view class="summary">{{selected.summary}}</view>
    <view class="facts" wx:if="{{selected.factLines.length || selected.impactLines.length}}">
      <view class="facts-title">AI已读取并与正式系统核对</view>
      <view class="fact-line" wx:for="{{selected.factLines}}" wx:key="*this">{{item}}</view>
      <view class="fact-line impact-line" wx:for="{{selected.impactLines}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="next-label">教务现在只做这一步</view><view class="next">{{selected.next}}</view>
    <view class="blocker" wx:for="{{selected.blockerItems}}" wx:key="title">
      <view class="blocker-title">{{item.title}}</view><view class="blocker-detail">{{item.detail}}</view><view class="blocker-action">下一步：{{item.action}}</view>
    </view>
    <view class="decision" wx:if="{{selected.needsTarget}}">
      <view class="decision-label">选择要处理的课次</view>
      <picker mode="selector" range="{{targetOptions}}" range-key="label" value="{{targetIndex}}" bindchange="chooseTarget">
        <view class="picker">{{decision.targetSessionLabel}}</view>
      </picker>
    </view>
    <view class="decision" wx:if="{{selected.workflowKey === 'CANCEL_LESSON'}}">
      <view class="decision-label">本次取消是否扣课时</view>
      <radio-group class="radios" bindchange="chooseCharge">
        <label><radio value="false" checked="{{decision.chargeValue === 'false'}}"/>不扣课时</label>
        <label><radio value="true" checked="{{decision.chargeValue === 'true'}}"/>扣课时</label>
      </radio-group>
      <textarea class="input" value="{{decision.note}}" bindinput="editNote" placeholder="取消原因（将写入正式记录）" maxlength="500" auto-height />
    </view>
    <view class="decision" wx:if="{{selected.workflowKey === 'CHANGE_TEACHER'}}">
      <view class="decision-label">选择资质和时间均通过的替换老师</view>
      <picker mode="selector" range="{{teacherOptions}}" range-key="name" value="{{teacherIndex}}" bindchange="chooseTeacher">
        <view class="picker">{{decision.newTeacherName}}</view>
      </picker>
      <textarea class="input" value="{{decision.reason}}" bindinput="editReason" placeholder="换老师原因" maxlength="500" auto-height />
    </view>
    <view class="decision subject-teachers" wx:if="{{selected.workflowKey === 'NEW_SCHEDULE' && subjectPlans.length}}">
      <view class="decision-label">按科目确认老师顺序</view>
      <view class="subject-teacher" wx:for="{{subjectPlans}}" wx:key="subject" wx:for-item="subjectPlan" wx:for-index="subjectIndex">
        <view class="subject-name">{{subjectPlan.subject}}</view>
        <view class="teacher-row"><text>主选老师</text><picker mode="selector" range="{{subjectPlan.teachers}}" range-key="teacherName" value="{{subjectPlan.primaryIndex}}" data-subject-index="{{subjectIndex}}" data-role="primary" bindchange="chooseSubjectTeacher"><view class="picker compact">{{subjectPlan.teachers[subjectPlan.primaryIndex].teacherName}}</view></picker></view>
        <view class="teacher-row"><text>第一备选</text><picker mode="selector" range="{{subjectPlan.backupTeachers}}" range-key="teacherName" value="{{subjectPlan.backup1Index}}" data-subject-index="{{subjectIndex}}" data-role="backup1" bindchange="chooseSubjectTeacher"><view class="picker compact">{{subjectPlan.backupTeachers[subjectPlan.backup1Index].teacherName}}</view></picker></view>
        <view class="teacher-row"><text>第二备选</text><picker mode="selector" range="{{subjectPlan.backupTeachers}}" range-key="teacherName" value="{{subjectPlan.backup2Index}}" data-subject-index="{{subjectIndex}}" data-role="backup2" bindchange="chooseSubjectTeacher"><view class="picker compact">{{subjectPlan.backupTeachers[subjectPlan.backup2Index].teacherName}}</view></picker></view>
      </view>
      <view class="decision-help">AI已按资质、可用时间和覆盖率预填；每个科目独立计算。</view>
    </view>
    <view class="notice" wx:if="{{selected.workflowKey === 'NEW_SCHEDULE' && subjectPlanLoading}}">正在读取各科合资格老师…</view>
    <view class="review" wx:if="{{pendingReview}}">
      <view class="review-title">确认前请核对完整方案</view>
      <view class="review-count">共 {{pendingReview.commandCount}} 项正式操作</view>
      <view class="calendar-legend"><text class="existing">学生其他课程</text><text class="removed">原课程（将移走）</text><text class="proposed">调整后的课程</text></view>
      <view class="review-line" wx:for="{{pendingReview.lines}}" wx:key="*this">{{item}}</view>
      <view class="calendar" wx:for="{{pendingReview.calendars}}" wx:key="key" wx:for-item="month">
        <view class="calendar-title">{{month.title}}</view>
        <view class="week-head"><view wx:for="{{weekdays}}" wx:key="*this">周{{item}}</view></view>
        <view class="month-grid">
          <view class="day {{cell.blank ? 'blank' : ''}}" wx:for="{{month.cells}}" wx:key="key" wx:for-item="cell">
            <view class="day-number" wx:if="{{!cell.blank}}">{{cell.day}}</view>
            <view class="event {{event.state}}" wx:for="{{cell.events}}" wx:key="key" wx:for-item="event"><view>{{event.time}} · {{event.course}}</view><view>{{event.teacher}} · {{event.action}}</view></view>
          </view>
        </view>
      </view>
      <view class="review-actions"><button class="secondary" disabled="{{working}}" bindtap="cancelReview">返回修改</button><button class="primary" loading="{{working}}" disabled="{{working}}" bindtap="confirmExecution">确认并执行</button></view>
    </view>
    <button wx:else class="primary" loading="{{working}}" disabled="{{working}}" bindtap="run">{{selected.actionLabel}}</button>
    <view class="safe">系统会先展示完整结果；最终执行时再次检查权限、冲突、课时和重复操作。</view>
  </view>
</view>
