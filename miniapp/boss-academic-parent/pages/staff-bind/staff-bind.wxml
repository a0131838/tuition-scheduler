<view class="page">
  <view class="top">
    <view class="eyebrow">员工绑定</view>
    <view class="title">输入后台生成的员工绑定码</view>
    <view class="subtitle">绑定后，这个微信就可以进入员工移动工作台。</view>
  </view>

  <view class="card">
    <view class="label">绑定码</view>
    <input class="input" value="{{token}}" placeholder="请输入员工绑定码" bindinput="onInput" />
    <button class="btn staff" loading="{{loading}}" bindtap="submit">确认绑定</button>
  </view>
</view>
