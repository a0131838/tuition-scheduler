<scroll-view class="page" scroll-y scroll-into-view="{{scrollTarget}}">
  <view class="top">
    <view class="eyebrow">{{studentName}}</view>
    <view class="title">课后反馈</view>
    <view class="subtitle">查看老师发布的课后记录。</view>
  </view>

  <block wx:if="{{feedbacks.length}}">
    <view wx:for="{{feedbacks}}" wx:key="id" wx:for-index="feedbackIndex" id="feedback-{{item.id}}" class="card {{focusFeedbackId === item.id ? 'focused' : ''}}">
      <view class="label">{{item.sessionStartText || item.sessionStartAt}}</view>
      <view class="value">{{item.teacherName || "老师"}}</view>
      <view class="subtitle">{{item.summary || item.content}}</view>
      <view class="homework" wx:if="{{item.homework}}">课后作业：{{item.homework}}</view>
      <view class="attachments" wx:if="{{item.attachments.length}}"><view class="attachment-title">作业与课堂附件</view><button class="attachment" wx:for="{{item.attachments}}" wx:key="id" data-feedback-index="{{feedbackIndex}}" data-attachment-index="{{index}}" bindtap="openAttachment">{{item.name}} · 查看</button></view>
    </view>
  </block>
  <view wx:else class="empty">暂无课后反馈</view>
</scroll-view>
