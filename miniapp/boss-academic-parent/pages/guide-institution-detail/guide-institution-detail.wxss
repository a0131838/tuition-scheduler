@import "../../styles/school-guide.wxss";

.institution-hero { padding-bottom: 38rpx; }
.institution-name { font-size: 52rpx; line-height: 1.2; }
.institution-name-en { margin-top: 12rpx; color: #667085; font-size: 26rpx; line-height: 1.5; }
.institution-facts { margin: 0 32rpx; border-top: 1rpx solid #dedbd6; }
.institution-fact { display: grid; grid-template-columns: 180rpx 1fr; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid #dedbd6; }
.institution-fact text { color: #6b7280; font-size: 24rpx; }
.institution-fact b { color: #16191f; font-size: 27rpx; line-height: 1.45; }
.institution-detail-sections { padding-top: 16rpx; }
.institution-section { border-top: 1rpx solid #dedbd6; }
.institution-section:last-child { border-bottom: 1rpx solid #dedbd6; }
.institution-section-head { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; }
.institution-section-head b { font-size: 30rpx; }
.institution-section-head text { font-size: 34rpx; color: #a24412; }
.institution-section-body { padding: 0 0 20rpx; }
.partner-programmes { padding-top: 34rpx; }
.partner-programmes-title { margin-top: 8rpx; }
.partner-card { margin-top: 18rpx; padding: 0 24rpx; border: 1rpx solid #dedbd6; border-radius: 20rpx; background: #fff; }
.partner-head { min-height: 122rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.partner-head>text { color: #a24412; font-size: 34rpx; }
.partner-body { padding: 0 0 26rpx; }
.partner-relationship { color: #a24412; font-size: 22rpx; font-weight: 700; line-height: 1.5; }
.partner-name { color: #16191f; font-size: 30rpx; font-weight: 800; line-height: 1.35; }
.partner-name-en { margin-top: 8rpx; color: #667085; font-size: 25rpx; line-height: 1.45; }
.partner-rank { margin-top: 8rpx; color: #803710; font-size: 24rpx; font-weight: 700; line-height: 1.45; }
.partner-status { margin-top: 16rpx; padding: 14rpx 18rpx; border-left: 5rpx solid #f45b00; background: #fff8f3; font-size: 23rpx; line-height: 1.55; }
.programme-group { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e7e3de; }
.programme-level { color: #a24412; font-size: 24rpx; font-weight: 800; }
.programme-name { position: relative; margin-top: 14rpx; padding-left: 24rpx; color: #252a32; font-size: 25rpx; line-height: 1.62; }
.programme-name b,.programme-name text { display: block; }
.programme-name b { color: #252a32; font-size: 25rpx; }
.programme-name text { margin-top: 4rpx; color: #707780; font-size: 22rpx; line-height: 1.5; }
.programme-name::before { content: ''; position: absolute; left: 2rpx; top: 17rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #f45b00; }
