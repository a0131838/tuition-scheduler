.guide-dock {
  position: fixed;
  z-index: 50;
  right: 18rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  overflow: hidden;
  border: 1rpx solid rgba(24, 32, 42, .16);
  border-radius: 24rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 18rpx 58rpx rgba(24,32,42,.16);
}
.dock-item {
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #707982;
  font-size: 19rpx;
  font-weight: 750;
}
.dock-icon { color: #18202a; font-size: 31rpx; line-height: 1.15; }
.dock-item.active { color: #a83c05; background: #fff7f0; }
.dock-item.active .dock-icon { color: #ec5e0a; }
.dock-item:active { transform: translateY(1rpx); background: #fff7f0; }
