.guide-dock {
  position: fixed;
  z-index: 50;
  right: 18rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  overflow: hidden;
  border: 1rpx solid rgba(24, 32, 42, .16);
  border-radius: 24rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 18rpx 58rpx rgba(24,32,42,.16);
}
.dock-item {
  min-height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #707982;
  font-size: 25rpx;
  font-weight: 800;
}
.dock-indicator { position: absolute; top: 0; left: 50%; width: 42rpx; height: 5rpx; border-radius: 0 0 5rpx 5rpx; background: transparent; transform: translateX(-50%); }
.dock-item.active { color: #a83c05; }
.dock-item.active .dock-indicator { background: #ec5e0a; }
.dock-item:active { transform: translateY(1rpx); background: #fff7f0; }
