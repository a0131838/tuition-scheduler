  intakeToken          String                  @unique
  signToken            String?                 @unique
  intakeExpiresAt      DateTime?
  signExpiresAt        DateTime?
  intakeSubmittedAt    DateTime?
  signViewedAt         DateTime?
  signedAt             DateTime?
  invoiceCreatedAt     DateTime?
  voidedAt             DateTime?
  parentInfoJson       Json?
  businessInfoJson     Json?
  contractSnapshotJson Json?
  signedPdfPath        String?
  signatureImagePath   String?
  signerName           String?
  signerEmail          String?
  signerPhone          String?
  signerIp             String?
  invoiceId            String?
  invoiceNo            String?
  createdByUserId      String?
